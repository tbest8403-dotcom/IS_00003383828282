	if not Murderer then
		Window:Notify({ Title = "Shoot Murderer", Content = "No living murderer was detected", Type = "Error" })
		SetStatus("No living murderer detected")
		return
	end

	ShootTargetWithMurdererLogic(Murderer, "Shoot Murderer")
end

local function MurderAllPlayers()
	if MurderAllBusy or MurdererShotBusy or AutoGrabGunBusy then
		Window:Notify({ Title = "Murder All", Content = "The action is already running", Type = "Warning" })
		return
	end

	if SpectatorEnabled and SpectatorActionBusy then
		RunService.Heartbeat:Wait()

		if SpectatorActionBusy then
			Window:Notify({ Title = "Murder All", Content = "Preview is busy; try again", Type = "Warning" })
			return
		end
	end

	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")
	local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
	local SlashTool
	local SlashStart
	local EquippedByScript = false

	if not Character or not Humanoid or Humanoid.Health <= 0 or not Root or not Root:IsA("BasePart") then
		Window:Notify({ Title = "Murder All", Content = "Your character is not ready", Type = "Error" })
		return
	end

	MurderAllBusy = true

	local function FindSlashTool(Container)
		if not Container then
			return nil
		end

		for _, Candidate in ipairs(Container:GetChildren()) do
			if Candidate:IsA("Tool") then
				local KnifeServer = Candidate:FindFirstChild("KnifeServer")
				local CandidateSlashStart = KnifeServer and KnifeServer:FindFirstChild("SlashStart")

				if CandidateSlashStart and CandidateSlashStart:IsA("RemoteEvent") then
					return Candidate, CandidateSlashStart
				end
			end
		end

		return nil
	end

	SlashTool, SlashStart = FindSlashTool(Character)

	if not SlashTool and Backpack then
		SlashTool, SlashStart = FindSlashTool(Backpack)

		if SlashTool then
			pcall(function()
				Humanoid:EquipTool(SlashTool)
				RunService.Heartbeat:Wait()
			end)
			EquippedByScript = SlashTool.Parent == Character

			local KnifeServer = SlashTool:FindFirstChild("KnifeServer")
			SlashStart = KnifeServer and KnifeServer:FindFirstChild("SlashStart")
		end
	end

	if not SlashTool or not SlashTool:IsA("Tool")
		or SlashTool.Parent ~= Character
		or not SlashStart or not SlashStart:IsA("RemoteEvent") then
		if EquippedByScript and Backpack and SlashTool and SlashTool.Parent == Character then
			SlashTool.Parent = Backpack
		end

		MurderAllBusy = false
		Window:Notify({
			Title = "Murder All",
			Content = "A Tool with KnifeServer.SlashStart is required",
			Type = "Error"
		})
		SetStatus("A SlashStart Tool is required")
		return
	end

	local TargetPlayers = {}
	local MurderOriginPosition = SpectatorEnabled
		and SpectatorCloneRoot and SpectatorCloneRoot.Parent and SpectatorCloneRoot.Position
		or Root.Position
	local LocalTeamId = LocalPlayer:GetAttribute("TeamId")

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local TargetCharacter = Player.Character
			local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass("Humanoid")
			local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild("HumanoidRootPart")
			local PlayerTeamId = Player:GetAttribute("TeamId")
			local SameTeam = LocalTeamId ~= nil
				and PlayerTeamId ~= nil
				and PlayerTeamId == LocalTeamId

			if not SameTeam
				and TargetHumanoid and TargetHumanoid.Health > 0
				and TargetRoot and TargetRoot:IsA("BasePart")
				and (TargetRoot.Position - MurderOriginPosition).Magnitude <= TargetingSettings.AutoMurderRange then
				TargetPlayers[#TargetPlayers + 1] = Player
			end
		end
	end

	if #TargetPlayers == 0 then
		if EquippedByScript and Backpack and SlashTool.Parent == Character then
			SlashTool.Parent = Backpack
		end

		MurderAllBusy = false
		Window:Notify({
			Title = "Murder All",
			Content = "No living enemies were found within range",
			Type = "Warning"
		})
		return
	end

	local OriginalPivot = Character:GetPivot()
	local OriginalLinearVelocity = Root.AssemblyLinearVelocity
	local OriginalAngularVelocity = Root.AssemblyAngularVelocity
	local RootRelativeToPivot = OriginalPivot:ToObjectSpace(Root.CFrame)
	local PreviewSyncCFrame = BeginPreviewSyncedAction(Character)
	local SentCount = 0
	local EliminatedCount = 0
	local UnresolvedCount = 0
	local Success, ErrorMessage = pcall(function()
		for _, Player in ipairs(TargetPlayers) do
			local OriginalTargetCharacter = Player.Character
			local Eliminated = false

			for _ = 1, TargetingSettings.AutoMurderMaxAttempts do
				if LocalPlayer.Character ~= Character or Humanoid.Health <= 0 then
					error("Your character changed before Auto Murder finished")
				end

				if SlashTool.Parent ~= Character or not SlashStart.Parent then
					error("The SlashStart Tool was unequipped")
				end

				local TargetCharacter = Player.Character
				local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass("Humanoid")
				local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild("HumanoidRootPart")
				local CurrentLocalTeamId = LocalPlayer:GetAttribute("TeamId")
				local CurrentTargetTeamId = Player:GetAttribute("TeamId")
				local SameTeam = CurrentLocalTeamId ~= nil
					and CurrentTargetTeamId ~= nil
					and CurrentTargetTeamId == CurrentLocalTeamId

				if TargetCharacter ~= OriginalTargetCharacter
					or not TargetHumanoid
					or TargetHumanoid.Health <= 0 then
					Eliminated = true
					break
				end

				if SameTeam
					or not TargetRoot
					or not TargetRoot:IsA("BasePart")
					or (TargetRoot.Position - MurderOriginPosition).Magnitude > TargetingSettings.AutoMurderRange then
					break
				end

				local BehindPosition = TargetRoot.Position - TargetRoot.CFrame.LookVector * 2.5
				local BehindCFrame = CFrame.lookAt(BehindPosition, TargetRoot.Position, Vector3.yAxis)
				Character:PivotTo(BehindCFrame * RootRelativeToPivot:Inverse())
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.AssemblyAngularVelocity = Vector3.zero
				RunService.PreSimulation:Wait()
				SlashStart:FireServer()
				SentCount = SentCount + 1
				task.wait(TargetingSettings.AutoMurderRetryDelay)

				local UpdatedCharacter = Player.Character
				local UpdatedHumanoid = UpdatedCharacter and UpdatedCharacter:FindFirstChildOfClass("Humanoid")

				if UpdatedCharacter ~= OriginalTargetCharacter
					or not UpdatedHumanoid
					or UpdatedHumanoid.Health <= 0 then
					Eliminated = true
					break
				end
			end

			if Eliminated then
				EliminatedCount = EliminatedCount + 1
			else
				local RemainingCharacter = Player.Character
				local RemainingHumanoid = RemainingCharacter
					and RemainingCharacter:FindFirstChildOfClass("Humanoid")
				local RemainingRoot = RemainingCharacter
					and RemainingCharacter:FindFirstChild("HumanoidRootPart")
				local CurrentLocalTeamId = LocalPlayer:GetAttribute("TeamId")
				local CurrentTargetTeamId = Player:GetAttribute("TeamId")
				local SameTeam = CurrentLocalTeamId ~= nil
					and CurrentTargetTeamId ~= nil
					and CurrentTargetTeamId == CurrentLocalTeamId

				if not SameTeam
					and RemainingCharacter == OriginalTargetCharacter
					and RemainingHumanoid and RemainingHumanoid.Health > 0
					and RemainingRoot and RemainingRoot:IsA("BasePart")
					and (RemainingRoot.Position - MurderOriginPosition).Magnitude
						<= TargetingSettings.AutoMurderRange then
					UnresolvedCount = UnresolvedCount + 1
				end
			end
		end

		RunService.PreSimulation:Wait()
	end)

	if Character.Parent and LocalPlayer.Character == Character then
		Character:PivotTo(OriginalPivot)
		Root.AssemblyLinearVelocity = OriginalLinearVelocity
		Root.AssemblyAngularVelocity = OriginalAngularVelocity
	end

	if EquippedByScript and Backpack and Backpack.Parent and SlashTool.Parent == Character then
		SlashTool.Parent = Backpack
	end

	if PreviewSyncCFrame then
		FinishPreviewSyncedAction(Character, PreviewSyncCFrame)
	end

	MurderAllBusy = false

	if Success then
		SetStatus(
			"Auto Murder: " .. tostring(EliminatedCount)
				.. " eliminated, " .. tostring(UnresolvedCount) .. " still active"
		)
		Window:Notify({
			Title = "Murder All",
			Content = tostring(EliminatedCount) .. " eliminated with "
				.. tostring(SentCount) .. " slash attempts; "
				.. tostring(UnresolvedCount) .. " still active",
			Type = UnresolvedCount > 0 and "Warning" or "Success"
		})
	else
		SetStatus("Murder All failed")
		Window:Notify({ Title = "Murder All", Content = tostring(ErrorMessage), Type = "Error" })
	end
end

