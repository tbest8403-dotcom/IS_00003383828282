local function IsInsideGui(GuiObject, PointerPosition)
	if not GuiObject or not GuiObject.Visible then
		return false
	end

	local Position = GuiObject.AbsolutePosition
	local Size = GuiObject.AbsoluteSize

	return PointerPosition.X >= Position.X
		and PointerPosition.X <= Position.X + Size.X
		and PointerPosition.Y >= Position.Y
		and PointerPosition.Y <= Position.Y + Size.Y
end

local function IsPointerOverMX(PointerPosition)
	if IsInsideGui(Window.Main, PointerPosition) or IsInsideGui(Window.Logo, PointerPosition) then
		return true
	end

	for _, Child in ipairs(Window.NotificationContainer:GetChildren()) do
		if Child:IsA("GuiObject") and IsInsideGui(Child, PointerPosition) then
			return true
		end
	end

	return false
end

local function GetEquippedGun(RequiredProtocol)
	local Character = LocalPlayer.Character
	if not Character then
		return nil
	end

	local Root = Character and Character:FindFirstChild("HumanoidRootPart")
	local OriginAttachment = Root and Root:FindFirstChild("GunRaycastAttachment")
	local Head = Character:FindFirstChild("Head") or Root

	local function ResolveTool(Tool)
		if not Tool or not Tool:IsA("Tool") then
			return nil
		end

		local GunServer = Tool:FindFirstChild("GunServer")
		local ShootStart = GunServer and GunServer:FindFirstChild("ShootStart")

		if ShootStart
			and ShootStart:IsA("RemoteEvent")
			and Head
			and Head:IsA("BasePart")
			and (not RequiredProtocol or RequiredProtocol == "Crossbow") then
			return Tool, ShootStart, Head, "Crossbow"
		end

		local Shoot = Tool:FindFirstChild("Shoot")

		if Shoot
			and Shoot:IsA("RemoteEvent")
			and OriginAttachment
			and OriginAttachment:IsA("Attachment")
			and (not RequiredProtocol or RequiredProtocol == "Standard") then
			return Tool, Shoot, OriginAttachment, "Standard"
		end

		return nil
	end

	local NamedGun = Character:FindFirstChild("Gun")
	local Gun, Shoot, ShotOrigin, ShootProtocol = ResolveTool(NamedGun)

	if Gun then
		return Gun, Shoot, ShotOrigin, ShootProtocol
	end

	for _, Child in ipairs(Character:GetChildren()) do
		Gun, Shoot, ShotOrigin, ShootProtocol = ResolveTool(Child)

		if Gun then
			return Gun, Shoot, ShotOrigin, ShootProtocol
		end
	end

	return nil
end

local function SetManualActivation(Gun, ManualOnly)
	if not Gun then
		return
	end

	local State = OriginalManualActivation[Gun]

	if State == nil then
		local GunClient = Gun:FindFirstChild("GunClient")
		State = {
			ManualActivationOnly = Gun.ManualActivationOnly,
			GunClient = GunClient,
			GunClientEnabled = GunClient and GunClient:IsA("LocalScript") and GunClient.Enabled or nil
		}
		OriginalManualActivation[Gun] = State
	end

	Gun.ManualActivationOnly = ManualOnly

	local GunServer = Gun:FindFirstChild("GunServer")
	local ShootStart = GunServer and GunServer:FindFirstChild("ShootStart")
	local GunClient = State.GunClient

	if ManualOnly
		and ShootStart
		and ShootStart:IsA("RemoteEvent")
		and GunClient
		and GunClient:IsA("LocalScript") then
		GunClient.Enabled = false
	end
end

local function RestoreManualActivation()
	for Gun, State in pairs(OriginalManualActivation) do
		if Gun.Parent then
			Gun.ManualActivationOnly = State.ManualActivationOnly

			if State.GunClient
				and State.GunClient.Parent
				and State.GunClientEnabled ~= nil then
				State.GunClient.Enabled = State.GunClientEnabled
			end
		end
	end

	table.clear(OriginalManualActivation)
end

local function HasNamedTool(Container, ToolName)
	if not Container then
		return false
	end

	local LowerName = string.lower(ToolName)

	for _, Child in ipairs(Container:GetChildren()) do
		if Child:IsA("Tool") and string.lower(Child.Name) == LowerName then
			return true
		end
	end

	return false
end

local function ClearCharacterPartCache(Character)
	PredictionVelocitySamples[Character] = nil
	JumpMotionSamples[Character] = nil

	local Entry = CharacterPartCache[Character]
	if not Entry then
		return
	end

	CharacterPartCache[Character] = nil

	for _, Connection in ipairs(Entry.Connections) do
		Connection:Disconnect()
	end

	table.clear(Entry.Connections)
	table.clear(Entry.Parts)
end

local function GetCharacterBodyParts(Character)
	local Entry = CharacterPartCache[Character]
	if Entry then
		return Entry.Parts
	end

	Entry = {
		Parts = {},
		Connections = {}
	}
	CharacterPartCache[Character] = Entry

	for _, Child in ipairs(Character:GetChildren()) do
		if Child:IsA("BasePart") then
			Entry.Parts[#Entry.Parts + 1] = Child
		end
	end

	Entry.Connections[1] = Character.ChildAdded:Connect(function(Child)
		if Child:IsA("BasePart") then
			Entry.Parts[#Entry.Parts + 1] = Child
		end
	end)

	Entry.Connections[2] = Character.ChildRemoved:Connect(function(Child)
		for Index = #Entry.Parts, 1, -1 do
			if Entry.Parts[Index] == Child then
				table.remove(Entry.Parts, Index)
				break
			end
		end
	end)

	Entry.Connections[3] = Character.AncestryChanged:Connect(function(_, Parent)
		if not Parent then
			ClearCharacterPartCache(Character)
		end
	end)

	return Entry.Parts
end

