		ClearCharacterPartCache(Player.Character)
	end

	if TargetSpectatePlayer == Player and DisableTargetSpectate then
		DisableTargetSpectate("Target left the game")
	end
end))

local function HasClearShot(OriginPosition, TargetCharacter, TargetPosition)
	local Character = LocalPlayer.Character

	if Character ~= ClearShotFilterCharacter then
		ClearShotFilterCharacter = Character
		ClearShotParameters.FilterDescendantsInstances = Character and { Character } or {}
	end

	local Result = workspace:Raycast(OriginPosition, TargetPosition - OriginPosition, ClearShotParameters)
	return Result == nil or Result.Instance:IsDescendantOf(TargetCharacter)
end

AutoShoot.FindValidPart = function(TargetCharacter, OriginPosition)
	local Humanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass("Humanoid")

	if not TargetCharacter or not Humanoid or Humanoid.Health <= 0 then
		return nil
	end

	local Checked = {}
	local BestHitPart
	local BestHitPosition
	local BestPriority = math.huge
	local BestHitDistance = math.huge
	local Character = LocalPlayer.Character

	if Character ~= ClearShotFilterCharacter then
		ClearShotFilterCharacter = Character
		ClearShotParameters.FilterDescendantsInstances = Character and { Character } or {}
	end

	local function ResolveHitPriority(HitPart, ProbePriority)
		if not AutoShoot.HeadPriority then
			return 1
		end

		for PriorityRank, PartName in ipairs(AutoShoot.Priority) do
			if HitPart.Name == PartName then
				return PriorityRank
			end
		end

		if HitPart.Name == "Handle" and HitPart:FindFirstAncestorOfClass("Accessory") then
			return ProbePriority
		end

		return #AutoShoot.Priority + 1
	end

	local function ProbePart(Part, ProbePriority)
		local HalfSize = Part.Size * 0.5

		for _, UnitOffset in ipairs(AutoShoot.ProbeOffsets) do
			local LocalOffset = Vector3.new(
				UnitOffset.X * HalfSize.X * AutoShoot.ProbeScale,
				UnitOffset.Y * HalfSize.Y * AutoShoot.ProbeScale,
				UnitOffset.Z * HalfSize.Z * AutoShoot.ProbeScale
			)
			local ProbePosition = Part.CFrame:PointToWorldSpace(LocalOffset)
			local Direction = ProbePosition - OriginPosition
			local Distance = Direction.Magnitude

			if Distance >= 0.01 and Distance <= AutoShoot.MaxRange then
				local Result = workspace:Raycast(OriginPosition, Direction, ClearShotParameters)
				local HitPart = Result and Result.Instance

				if HitPart
					and HitPart:IsA("BasePart")
					and HitPart:IsDescendantOf(TargetCharacter) then
					local HitPriority = ResolveHitPriority(HitPart, ProbePriority)
					local HitDistance = (Result.Position - OriginPosition).Magnitude

					if HitPriority < BestPriority
						or HitPriority == BestPriority and HitDistance < BestHitDistance then
						BestHitPart = HitPart
						BestHitPosition = Result.Position
						BestPriority = HitPriority
						BestHitDistance = HitDistance
					end

					if AutoShoot.HeadPriority and BestPriority == 1 then
						return true
					end
				end
			end
		end

		return false
	end

	for PriorityRank, PartName in ipairs(AutoShoot.Priority) do
		local Part = TargetCharacter:FindFirstChild(PartName)

		if Part and Part:IsA("BasePart") and Part.CanQuery then
			Checked[Part] = true

			if ProbePart(Part, PriorityRank) then
				return BestHitPart, BestPriority, BestHitPosition
			end
		end
	end

	for _, Child in ipairs(TargetCharacter:GetChildren()) do
		if Child:IsA("BasePart")
			and Child.Name ~= "HumanoidRootPart"
			and Child.CanQuery
			and not Checked[Child] then
			if ProbePart(Child, #AutoShoot.Priority + 1) then
				break
			end
		end
	end

	return BestHitPart, BestPriority, BestHitPosition
end

local function GetPreferredAimPart(Character)
	for _, PartName in ipairs(TargetingSettings.PreferredAimParts) do
		local Part = Character:FindFirstChild(PartName)

		if Part and Part:IsA("BasePart") then
			return Part
		end
	end

	return nil
end

local function GetWorldVerticalHalfExtent(Part)
	local HalfSize = Part.Size * 0.5
	local PartCFrame = Part.CFrame

	return math.abs(PartCFrame.RightVector.Y) * HalfSize.X
		+ math.abs(PartCFrame.UpVector.Y) * HalfSize.Y
		+ math.abs(PartCFrame.LookVector.Y) * HalfSize.Z
end

local function GetAvatarAimProfile(TargetCharacter, Root, AimPart)
	local WeightedPosition = Vector3.zero
	local TotalWeight = 0
	local CoreMinimumY = math.huge
	local CoreMaximumY = -math.huge
	local CoreHorizontalRadius = math.huge
	local BodyMinimumY = math.huge
	local BodyMaximumY = -math.huge

	for _, BodyPart in ipairs(GetCharacterBodyParts(TargetCharacter)) do
		if BodyPart.Parent == TargetCharacter and BodyPart ~= Root then
			local HalfY = GetWorldVerticalHalfExtent(BodyPart)
			BodyMinimumY = math.min(BodyMinimumY, BodyPart.Position.Y - HalfY)
			BodyMaximumY = math.max(BodyMaximumY, BodyPart.Position.Y + HalfY)
		end
	end

	for _, PartName in ipairs(TargetingSettings.TorsoAimParts) do
		local Part = TargetCharacter:FindFirstChild(PartName)

		if Part and Part:IsA("BasePart") then
			local HalfY = GetWorldVerticalHalfExtent(Part)
			local Weight = math.max(Part.Size.X * Part.Size.Y * Part.Size.Z, 0.01)
			WeightedPosition = WeightedPosition + Part.Position * Weight
			TotalWeight = TotalWeight + Weight
			CoreMinimumY = math.min(CoreMinimumY, Part.Position.Y - HalfY)
			CoreMaximumY = math.max(CoreMaximumY, Part.Position.Y + HalfY)
			CoreHorizontalRadius = math.min(
				CoreHorizontalRadius,
				math.max(math.min(Part.Size.X, Part.Size.Z) * 0.5, 0.15)
			)
		end
	end

	local FallbackPart = AimPart and AimPart:IsA("BasePart") and AimPart or Root
	local AimPosition

	if TotalWeight > 0 then
		AimPosition = WeightedPosition / TotalWeight
	else
		local HalfY = GetWorldVerticalHalfExtent(FallbackPart)
		AimPosition = FallbackPart.Position
		CoreMinimumY = FallbackPart.Position.Y - HalfY
		CoreMaximumY = FallbackPart.Position.Y + HalfY
		CoreHorizontalRadius = math.max(math.min(FallbackPart.Size.X, FallbackPart.Size.Z) * 0.5, 0.15)
	end

	if BodyMinimumY == math.huge or BodyMaximumY == -math.huge then
		BodyMinimumY = CoreMinimumY
		BodyMaximumY = CoreMaximumY
	end

	local CoreHeight = math.max(CoreMaximumY - CoreMinimumY, 0.5)
	local CoreHalfHeight = CoreHeight * 0.5
	local AimInset = math.clamp(
		CoreHeight * TargetingSettings.AimInsetRatio,
		TargetingSettings.MinimumAimInset,
		CoreHalfHeight * 0.45
	)
	local SafeMinimumY = CoreMinimumY + AimInset
	local SafeMaximumY = CoreMaximumY - AimInset

	AimPosition = Vector3.new(
		AimPosition.X,
		math.clamp(AimPosition.Y, SafeMinimumY, SafeMaximumY),
		AimPosition.Z
	)

	local BodyHeight = math.max(BodyMaximumY - BodyMinimumY, CoreHeight)
	local AvatarScale = math.clamp(BodyHeight / 5, 0.4, 2.5)

	return {
		AimPosition = AimPosition,
		AvatarScale = AvatarScale,
		BodyHeight = BodyHeight,
		CoreHalfHeight = CoreHalfHeight,
		CoreHorizontalRadius = CoreHorizontalRadius,
		GroundToAimHeight = math.clamp(
			AimPosition.Y - BodyMinimumY,
			CoreHalfHeight * 0.5,
			BodyHeight
		)
	}
end

local function GetPingPredictionOffset()
	local CurrentTime = os.clock()

	if CurrentTime - LastNetworkPingUpdate >= TargetingSettings.PingUpdateInterval then
		LastNetworkPingUpdate = CurrentTime

		local Success, NetworkPing = pcall(function()
			return LocalPlayer:GetNetworkPing()
		end)

		if Success and type(NetworkPing) == "number" and NetworkPing == NetworkPing and NetworkPing >= 0 then
			NetworkPing = math.clamp(NetworkPing, 0, TargetingSettings.MaximumPing / TargetingSettings.PingWeight)

			if SmoothedNetworkPing then
				SmoothedNetworkPing = SmoothedNetworkPing
					+ (NetworkPing - SmoothedNetworkPing) * TargetingSettings.PingSmoothingAlpha
			else
				SmoothedNetworkPing = NetworkPing
			end
		end
	end

	return math.clamp((SmoothedNetworkPing or 0) * TargetingSettings.PingWeight, 0, TargetingSettings.MaximumPing)
end

local function UpdateJumpMotionState(TargetCharacter, Airborne, VerticalVelocity)
	local CurrentTime = os.clock()
	local Sample = JumpMotionSamples[TargetCharacter]

	if not Sample or CurrentTime - Sample.Time > TargetingSettings.SpamJumpStateLifetime then
		local InitialTakeoffTime = Airborne
			and VerticalVelocity >= TargetingSettings.JumpRiseThreshold
			and CurrentTime
			or nil
		local InitialScore = InitialTakeoffTime and 1 or 0
		local InitialState = {
			Time = CurrentTime,
			Airborne = Airborne,
			VerticalVelocity = VerticalVelocity,
			WasFalling = VerticalVelocity <= TargetingSettings.JumpFallThreshold,
			LastTakeoffTime = InitialTakeoffTime,
			LastLandingTime = nil,
			ChainScore = InitialScore,
			EstimatedDwell = TargetingSettings.DefaultJumpDwell,
			LaunchVelocity = math.max(VerticalVelocity, TargetingSettings.MinimumJumpLaunchVelocity)
		}
		JumpMotionSamples[TargetCharacter] = InitialState
		return InitialState, 0
	end

	local DeltaTime = math.clamp(CurrentTime - Sample.Time, 0, 0.2)
	local ChainScore = (Sample.ChainScore or 0)
		* math.exp(-TargetingSettings.SpamJumpScoreDecay * DeltaTime)
	local WasFalling = Sample.WasFalling or false
	local LastTakeoffTime = Sample.LastTakeoffTime
	local LastLandingTime = Sample.LastLandingTime
	local EstimatedDwell = Sample.EstimatedDwell or TargetingSettings.DefaultJumpDwell
	local LaunchVelocity = Sample.LaunchVelocity or TargetingSettings.MinimumJumpLaunchVelocity
	local JustLanded = not Airborne and Sample.Airborne

	if JustLanded then
		LastLandingTime = CurrentTime
		WasFalling = true
	end

	local NewRise = Airborne
		and VerticalVelocity >= TargetingSettings.JumpRiseThreshold
		and (
			not Sample.Airborne
			or Sample.VerticalVelocity < TargetingSettings.JumpRiseThreshold
			or WasFalling
		)

	if NewRise
		and (
			LastTakeoffTime == nil
			or CurrentTime - LastTakeoffTime >= TargetingSettings.MinimumJumpCycleInterval
		) then
		local RepeatedJump = LastTakeoffTime ~= nil
			and CurrentTime - LastTakeoffTime <= TargetingSettings.SpamJumpMaximumInterval
			and WasFalling

		ChainScore = RepeatedJump and ChainScore + 1 or 1

		if LastLandingTime ~= nil then
			local ObservedDwell = CurrentTime - LastLandingTime

			if ObservedDwell <= TargetingSettings.MaximumJumpDwell then
				EstimatedDwell = EstimatedDwell
					+ (ObservedDwell - EstimatedDwell) * TargetingSettings.JumpDwellSmoothing
			end
		end

		local ObservedLaunchVelocity = math.max(
			VerticalVelocity,
			TargetingSettings.MinimumJumpLaunchVelocity
		)
		LaunchVelocity = LaunchVelocity
			+ (ObservedLaunchVelocity - LaunchVelocity) * TargetingSettings.JumpLaunchSmoothing
		LastTakeoffTime = CurrentTime
		WasFalling = false
	elseif Airborne and VerticalVelocity <= TargetingSettings.JumpFallThreshold then
		WasFalling = true
	end

	if Airborne and VerticalVelocity > LaunchVelocity then
		LaunchVelocity = LaunchVelocity
			+ (VerticalVelocity - LaunchVelocity) * TargetingSettings.JumpLaunchSmoothing
	end

	local State = {
		Time = CurrentTime,
		Airborne = Airborne,
		VerticalVelocity = VerticalVelocity,
		WasFalling = WasFalling,
		LastTakeoffTime = LastTakeoffTime,
		LastLandingTime = LastLandingTime,
		ChainScore = math.clamp(ChainScore, 0, 4),
		EstimatedDwell = math.clamp(EstimatedDwell, 0, TargetingSettings.MaximumJumpDwell),
		LaunchVelocity = math.clamp(
			LaunchVelocity,
			TargetingSettings.MinimumJumpLaunchVelocity,
			TargetingSettings.MaximumVerticalSpeed
		)
	}
	JumpMotionSamples[TargetCharacter] = State

	local SpamJumpBlend = math.clamp(
		(State.ChainScore - TargetingSettings.SpamJumpBlendStart)
			/ TargetingSettings.SpamJumpBlendRange,
		0,
		1
	)
	return State, SpamJumpBlend
end

local function GetSpamJumpPredictedY(
	CurrentAimY,
	MinimumAimY,
	VerticalVelocity,
	PredictionTime,
	Airborne,
	TimeSinceLanding,
	JumpState
)
	local Gravity = math.max(workspace.Gravity, 0.01)
	local RemainingTime = math.max(PredictionTime, 0)
	local PositionY = math.max(CurrentAimY, MinimumAimY)
	local ActiveVerticalVelocity = Airborne and VerticalVelocity or 0
	local IsAirborne = Airborne
	local RemainingDwell = IsAirborne
		and JumpState.EstimatedDwell
		or math.max(JumpState.EstimatedDwell - TimeSinceLanding, 0)

	for _ = 1, 3 do
		if IsAirborne then
			local HeightAboveGround = math.max(PositionY - MinimumAimY, 0)
			local TimeToLanding = (
				ActiveVerticalVelocity
					+ math.sqrt(
						ActiveVerticalVelocity * ActiveVerticalVelocity
							+ 2 * Gravity * HeightAboveGround
					)
			) / Gravity

			if RemainingTime <= TimeToLanding then
				return math.max(
					PositionY
						+ ActiveVerticalVelocity * RemainingTime
						- 0.5 * Gravity * RemainingTime * RemainingTime,
					MinimumAimY
				)
			end

			RemainingTime = RemainingTime - TimeToLanding
			PositionY = MinimumAimY
			ActiveVerticalVelocity = 0
			IsAirborne = false
			RemainingDwell = JumpState.EstimatedDwell
		end

		if RemainingTime <= RemainingDwell then
			return MinimumAimY
		end

		RemainingTime = RemainingTime - RemainingDwell
		PositionY = MinimumAimY
		ActiveVerticalVelocity = JumpState.LaunchVelocity
		IsAirborne = true
	end

	return math.max(
		PositionY
			+ ActiveVerticalVelocity * RemainingTime
			- 0.5 * Gravity * RemainingTime * RemainingTime,
		MinimumAimY
	)
end

local function GetFilteredPredictionMotion(TargetCharacter, Root, Humanoid, TargetTolerance, PredictionHorizon)
	local CurrentTime = os.clock()
	local RawVelocity = Root.AssemblyLinearVelocity
	local HorizontalLimit = math.min(
		TargetingSettings.MaximumHorizontalSpeed,
		math.max(20, Humanoid.WalkSpeed * TargetingSettings.WalkSpeedMultiplier)
	)
	local RawHorizontalVelocity = Vector3.new(RawVelocity.X, 0, RawVelocity.Z)

	if RawHorizontalVelocity.Magnitude > HorizontalLimit then
		RawHorizontalVelocity = RawHorizontalVelocity.Unit * HorizontalLimit
	elseif RawHorizontalVelocity.Magnitude < 0.75 then
		RawHorizontalVelocity = Vector3.zero
	end

	local Sample = PredictionVelocitySamples[TargetCharacter]
	local FilteredVelocity = RawHorizontalVelocity
	local FilteredAcceleration = Vector3.zero
	local PredictionVelocity = RawHorizontalVelocity
	local MotionUncertainty = 0
	local ReversalVelocity = RawHorizontalVelocity
	local ReversalScore = 0
	local LastDirectionChangeTime
	local PatternInterval
	local PatternReliability = 0
	local AccelerationConsistency = 0
	local LatestRawAcceleration = Vector3.zero
	local FilteredTurnRate = 0
	local TurnConsistency = 0
	local LatestRawTurnRate = 0
	local FilteredTurnAcceleration = 0
	local TurnReversalScore = 0

	if Sample and CurrentTime - Sample.Time <= TargetingSettings.MotionSampleLifetime then
		local DeltaTime = math.clamp(CurrentTime - Sample.Time, 0, 0.1)
		local Difference = RawHorizontalVelocity - Sample.Velocity
		local DirectionChanged = false
		local DirectionReference = Sample.Velocity

		if RawHorizontalVelocity.Magnitude > TargetingSettings.MinimumDirectionSpeed
			and DirectionReference.Magnitude > TargetingSettings.MinimumDirectionSpeed then
			DirectionChanged = RawHorizontalVelocity.Unit:Dot(DirectionReference.Unit)
				< TargetingSettings.DirectionChangeDot
		end

		ReversalVelocity = Sample.ReversalVelocity or Sample.Velocity
		ReversalScore = (Sample.ReversalScore or 0)
			* math.exp(-TargetingSettings.EvasiveScoreDecay * DeltaTime)
		LastDirectionChangeTime = Sample.LastDirectionChangeTime
		PatternInterval = Sample.PatternInterval
		PatternReliability = Sample.PatternReliability or 0
		AccelerationConsistency = Sample.AccelerationConsistency or 0
		LatestRawAcceleration = Sample.RawAcceleration or Vector3.zero
		FilteredTurnRate = Sample.TurnRate or 0
		TurnConsistency = Sample.TurnConsistency or 0
		LatestRawTurnRate = Sample.RawTurnRate or 0
		FilteredTurnAcceleration = Sample.TurnAcceleration or 0
		TurnReversalScore = (Sample.TurnReversalScore or 0)
			* math.exp(-TargetingSettings.TurnReversalDecay * DeltaTime)

		if DeltaTime >= TargetingSettings.MinimumSampleTime then
			local Alpha = 1 - math.exp(-TargetingSettings.VelocitySmoothing * DeltaTime)
			local SpeedChange = math.abs(RawHorizontalVelocity.Magnitude - Sample.Velocity.Magnitude)

			if DirectionChanged then
				Alpha = math.max(Alpha, TargetingSettings.DirectionChangeResponse)
			elseif Difference.Magnitude > math.max(6, HorizontalLimit * 0.25)
				or SpeedChange > math.max(4, HorizontalLimit * 0.2) then
				Alpha = math.max(Alpha, TargetingSettings.SpeedChangeResponse)
			end

			if Difference.Magnitude * PredictionHorizon > TargetTolerance then
				Alpha = math.max(Alpha, TargetingSettings.ToleranceResponse)
			end

			FilteredVelocity = Sample.Velocity:Lerp(RawHorizontalVelocity, Alpha)
			MotionUncertainty = (RawHorizontalVelocity - FilteredVelocity).Magnitude

			if not DirectionChanged
				and FilteredVelocity.Magnitude > TargetingSettings.MinimumDirectionSpeed
				and Sample.Velocity.Magnitude > TargetingSettings.MinimumDirectionSpeed then
				local Cross = Sample.Velocity.X * FilteredVelocity.Z
					- Sample.Velocity.Z * FilteredVelocity.X
				local AngleChange = math.atan2(Cross, Sample.Velocity:Dot(FilteredVelocity))
				LatestRawTurnRate = math.clamp(
					AngleChange / DeltaTime,
					-TargetingSettings.MaximumTurnRate,
					TargetingSettings.MaximumTurnRate
				)
				local TurnAlpha = 1 - math.exp(-TargetingSettings.TurnRateSmoothing * DeltaTime)
				FilteredTurnRate = FilteredTurnRate
					+ (LatestRawTurnRate - FilteredTurnRate) * TurnAlpha
				local PreviousRawTurnRate = Sample.RawTurnRate or 0

				if math.abs(LatestRawTurnRate) >= TargetingSettings.MinimumTurnRate
					and math.abs(PreviousRawTurnRate) >= TargetingSettings.MinimumTurnRate
					and math.sign(LatestRawTurnRate) ~= math.sign(PreviousRawTurnRate) then
					TurnReversalScore = math.clamp(TurnReversalScore + 1, 0, 3)
				end

				local RawTurnAcceleration = math.clamp(
					(LatestRawTurnRate - PreviousRawTurnRate) / DeltaTime,
					-TargetingSettings.MaximumTurnAcceleration,
					TargetingSettings.MaximumTurnAcceleration
				)
				local TurnAccelerationAlpha = 1
					- math.exp(-TargetingSettings.TurnAccelerationSmoothing * DeltaTime)
				FilteredTurnAcceleration = FilteredTurnAcceleration
					+ (RawTurnAcceleration - FilteredTurnAcceleration) * TurnAccelerationAlpha

				local TurnConsistencyTarget = 0
				if math.abs(LatestRawTurnRate) >= TargetingSettings.MinimumTurnRate
					and math.abs(PreviousRawTurnRate) >= TargetingSettings.MinimumTurnRate
					and math.sign(LatestRawTurnRate) == math.sign(PreviousRawTurnRate) then
					TurnConsistencyTarget = math.clamp(
						1 - math.abs(LatestRawTurnRate - PreviousRawTurnRate)
							/ math.max(math.abs(PreviousRawTurnRate), TargetingSettings.MinimumTurnRate),
						0,
						1
					)
				end

				if TurnConsistencyTarget > TurnConsistency then
					TurnConsistency = TurnConsistency
						+ (TurnConsistencyTarget - TurnConsistency)
							* TargetingSettings.TurnConsistencyResponse
				else
					TurnConsistency = TurnConsistency * TargetingSettings.TurnConsistencyDecay
				end
			end

			if not DirectionChanged then
				LatestRawAcceleration = (FilteredVelocity - Sample.Velocity) / DeltaTime

				if LatestRawAcceleration.Magnitude > TargetingSettings.MaximumAcceleration then
					LatestRawAcceleration = LatestRawAcceleration.Unit * TargetingSettings.MaximumAcceleration
				end

				local AccelerationAlpha = 1 - math.exp(-TargetingSettings.AccelerationSmoothing * DeltaTime)
				FilteredAcceleration = Sample.Acceleration:Lerp(LatestRawAcceleration, AccelerationAlpha)
				local PreviousRawAcceleration = Sample.RawAcceleration or Vector3.zero
				local AccelerationConsistencyTarget = 0

				if LatestRawAcceleration.Magnitude >= TargetingSettings.MinimumAccelerationForConsistency
					and PreviousRawAcceleration.Magnitude
						>= TargetingSettings.MinimumAccelerationForConsistency then
					AccelerationConsistencyTarget = math.clamp(
						(LatestRawAcceleration.Unit:Dot(PreviousRawAcceleration.Unit) - 0.05) / 0.95,
						0,
						1
					)
				end

				if AccelerationConsistencyTarget > AccelerationConsistency then
					AccelerationConsistency = AccelerationConsistency
						+ (AccelerationConsistencyTarget - AccelerationConsistency)
							* TargetingSettings.AccelerationConsistencyResponse
				else
					AccelerationConsistency = AccelerationConsistency
						* TargetingSettings.AccelerationConsistencyDecay
				end
			end
		else
			if DirectionChanged then
				FilteredVelocity = Sample.Velocity:Lerp(RawHorizontalVelocity, TargetingSettings.DirectionChangeResponse)
			else
				FilteredVelocity = Sample.Velocity
				FilteredAcceleration = Sample.Acceleration
			end

			MotionUncertainty = (RawHorizontalVelocity - FilteredVelocity).Magnitude
		end

		if DirectionChanged then
			TurnConsistency = 0
			local PreviousRawVelocity = Sample.RawVelocity or Sample.Velocity
			local ReversalMean = (PreviousRawVelocity + RawHorizontalVelocity) * 0.5
			local RepeatedReversal = LastDirectionChangeTime ~= nil
				and CurrentTime - LastDirectionChangeTime <= TargetingSettings.EvasiveWindow

			if RepeatedReversal then
				ReversalVelocity = ReversalVelocity:Lerp(ReversalMean, TargetingSettings.EvasiveMeanSmoothing)
				ReversalScore = ReversalScore + 1
			else
				ReversalVelocity = ReversalMean
				ReversalScore = ReversalScore + 0.25
			end

			if LastDirectionChangeTime ~= nil then
				local NewInterval = CurrentTime - LastDirectionChangeTime
				if NewInterval <= TargetingSettings.PatternMaximumInterval then
					if PatternInterval ~= nil then
						local RelativeError = math.abs(NewInterval - PatternInterval)
							/ math.max(PatternInterval, 0.02)
						local NewReliability = math.clamp(1 - RelativeError * 1.8, 0, 1)
						PatternReliability = PatternReliability
							+ (NewReliability - PatternReliability) * 0.45
						PatternInterval = PatternInterval
							+ (NewInterval - PatternInterval)
								* TargetingSettings.PatternIntervalSmoothing
					else
						PatternInterval = NewInterval
						PatternReliability = 0.35
					end
				end
			end

			LastDirectionChangeTime = CurrentTime
		end

		ReversalScore = math.clamp(ReversalScore, 0, 3)
		local EvasiveBlend = math.clamp(
			(ReversalScore - TargetingSettings.EvasiveBlendStart) / TargetingSettings.EvasiveBlendRange,
			0,
			1
		)
		PredictionVelocity = FilteredVelocity:Lerp(ReversalVelocity, EvasiveBlend)
		FilteredAcceleration = FilteredAcceleration * (1 - EvasiveBlend)
		MotionUncertainty = (RawHorizontalVelocity - PredictionVelocity).Magnitude
	end

	PredictionVelocitySamples[TargetCharacter] = {
		Velocity = FilteredVelocity,
		Acceleration = FilteredAcceleration,
		RawVelocity = RawHorizontalVelocity,
		RawAcceleration = LatestRawAcceleration,
		AccelerationConsistency = AccelerationConsistency,
		ReversalVelocity = ReversalVelocity,
		ReversalScore = ReversalScore,
		LastDirectionChangeTime = LastDirectionChangeTime,
		PatternInterval = PatternInterval,
		PatternReliability = PatternReliability,
		TurnRate = FilteredTurnRate,
		TurnConsistency = TurnConsistency,
		RawTurnRate = LatestRawTurnRate,
		TurnAcceleration = FilteredTurnAcceleration,
		TurnReversalScore = TurnReversalScore,
		Time = CurrentTime
	}

	local AccelerationTime = math.min(PredictionHorizon, 0.25)
	local ProjectedUncertainty = MotionUncertainty * PredictionHorizon
	local GeometryConfidence = math.clamp(
		TargetTolerance / math.max(TargetTolerance + ProjectedUncertainty, 0.01),
		0.2,
		1
	)
	local AccelerationConfidence = TargetingSettings.AccelerationConsistencyFloor
		+ (1 - TargetingSettings.AccelerationConsistencyFloor)
			* math.clamp(AccelerationConsistency, 0, 1)
	local AccelerationOffset = Vector3.zero

	if PredictionVelocity.Magnitude >= 1 then
		AccelerationOffset = FilteredAcceleration
			* (
				0.5
					* AccelerationTime
					* AccelerationTime
					* TargetingSettings.AccelerationWeight
					* GeometryConfidence
					* AccelerationConfidence
			)
	end

	local VelocityOffset = PredictionVelocity * PredictionHorizon
	local HorizontalOffset = VelocityOffset + AccelerationOffset

	if VelocityOffset.Magnitude > 0 and HorizontalOffset:Dot(VelocityOffset) < 0 then
		HorizontalOffset = Vector3.zero
	elseif VelocityOffset.Magnitude == 0 then
		HorizontalOffset = Vector3.zero
	end

	if math.abs(FilteredTurnRate) >= TargetingSettings.MinimumTurnRate
		and TurnConsistency > 0
		and PredictionVelocity.Magnitude >= 1 then
		local TurnAngle = FilteredTurnRate * PredictionHorizon
		local Sine = math.sin(TurnAngle)
		local Cosine = math.cos(TurnAngle)
		local ArcOffset = Vector3.new(
			(PredictionVelocity.X * Sine - PredictionVelocity.Z * (1 - Cosine)) / FilteredTurnRate,
			0,
			(PredictionVelocity.X * (1 - Cosine) + PredictionVelocity.Z * Sine) / FilteredTurnRate
		)
		local ForwardDirection = PredictionVelocity.Unit
		local TangentialAcceleration = ForwardDirection
			* FilteredAcceleration:Dot(ForwardDirection)
		local ArcAccelerationOffset = TangentialAcceleration
			* (0.5 * AccelerationTime * AccelerationTime * TargetingSettings.AccelerationWeight)
		local TurnRateConfidence = math.clamp(
			(math.abs(FilteredTurnRate) - TargetingSettings.MinimumTurnRate)
				/ math.max(TargetingSettings.MinimumTurnRate * 2, 0.01),
			0,
			1
		)
		local EvasiveSuppression = 1 - math.clamp(ReversalScore / 1.5, 0, 1)
		local TurnAccelerationSuppression = math.clamp(
			1 - math.abs(FilteredTurnAcceleration)
				* PredictionHorizon
				/ math.max(math.abs(FilteredTurnRate), TargetingSettings.MinimumTurnRate)
				* TargetingSettings.TurnAccelerationSuppression,
			0,
			1
		)
		local TurnReversalSuppression = 1 - math.clamp(
			(TurnReversalScore - TargetingSettings.TurnReversalBlendStart)
				/ TargetingSettings.TurnReversalBlendRange,
			0,
			1
		)
		local TurnBlend = math.clamp(
			TurnConsistency
				* TargetingSettings.TurnPredictionStrength
				* TurnRateConfidence
				* EvasiveSuppression
				* TurnAccelerationSuppression
				* TurnReversalSuppression,
			0,
			1
		)
		HorizontalOffset = HorizontalOffset:Lerp(ArcOffset + ArcAccelerationOffset, TurnBlend)
	end

	if PredictionVelocity.Magnitude >= 1 then
		local ForwardDirection = PredictionVelocity.Unit
		local TangentialDeceleration = FilteredAcceleration:Dot(ForwardDirection)

		if TangentialDeceleration <= -TargetingSettings.StoppingMinimumDeceleration then
			local TimeToStop = PredictionVelocity.Magnitude / -TangentialDeceleration

			if TimeToStop <= PredictionHorizon * TargetingSettings.StoppingHorizonScale then
				local StoppingTime = math.min(TimeToStop, PredictionHorizon)
				local StoppingDistance = math.max(
					0,
					PredictionVelocity.Magnitude * StoppingTime
						+ 0.5 * TangentialDeceleration * StoppingTime * StoppingTime
				)
				local CurrentForwardDistance = HorizontalOffset:Dot(ForwardDirection)
				local PerpendicularOffset = HorizontalOffset
					- ForwardDirection * CurrentForwardDistance
				local StoppingOffset = PerpendicularOffset
					+ ForwardDirection * StoppingDistance
				local StoppingBlend = math.clamp(
					(AccelerationConsistency - TargetingSettings.StoppingConsistencyStart)
						/ TargetingSettings.StoppingConsistencyRange,
					0,
					1
				) * TargetingSettings.StoppingPredictionStrength

				HorizontalOffset = HorizontalOffset:Lerp(StoppingOffset, StoppingBlend)
			end
		end
	end

	if PatternInterval ~= nil
		and LastDirectionChangeTime ~= nil
		and PatternInterval >= 0.035
		and CurrentTime - LastDirectionChangeTime <= PatternInterval * 1.6 then
		local TimeLeft = PredictionHorizon
		local TimeSinceChange = CurrentTime - LastDirectionChangeTime
		local SegmentTime = math.min(TimeLeft, math.max(0, PatternInterval - TimeSinceChange))
		local SignedTime = SegmentTime
		local Sign = -1
		TimeLeft = TimeLeft - SegmentTime

		while TimeLeft > 0.000001 do
			SegmentTime = math.min(TimeLeft, PatternInterval)
			SignedTime = SignedTime + SegmentTime * Sign
			Sign = -Sign
			TimeLeft = TimeLeft - SegmentTime
		end

		local OscillationVelocity = FilteredVelocity - ReversalVelocity
		local PatternOffset = ReversalVelocity * PredictionHorizon
			+ OscillationVelocity * SignedTime
		local PatternBlend = math.clamp(
			(ReversalScore - TargetingSettings.PatternBlendStart) / TargetingSettings.PatternBlendRange,
			0,
			1
		) * math.clamp(PatternReliability, 0, 1) ^ TargetingSettings.PatternReliabilityPower
		HorizontalOffset = HorizontalOffset:Lerp(PatternOffset, PatternBlend)
	end

	if HorizontalOffset.Magnitude > 0 then
		local UncertaintyRatio = math.clamp(
			ProjectedUncertainty / math.max(TargetTolerance, 0.05),
			0,
			1
		)
		local SmallRadiusBlend = 1 - math.clamp(
			(TargetTolerance - TargetingSettings.SmallRadiusSafetyStart)
				/ math.max(
					TargetingSettings.SmallRadiusSafetyEnd
						- TargetingSettings.SmallRadiusSafetyStart,
					0.01
				),
			0,
			1
		)
		local ActiveSafetyInset = TargetingSettings.UncertaintySafetyInset
			+ (TargetingSettings.SmallRadiusSafetyInset - TargetingSettings.UncertaintySafetyInset)
				* SmallRadiusBlend
		local SafetyInset = math.min(
			TargetTolerance * ActiveSafetyInset * UncertaintyRatio,
			HorizontalOffset.Magnitude * 0.35
		)
		HorizontalOffset = HorizontalOffset - HorizontalOffset.Unit * SafetyInset
	end

	local MaximumHorizontalOffset = HorizontalLimit * PredictionHorizon
		+ 0.5
			* TargetingSettings.MaximumAcceleration
			* AccelerationTime
			* AccelerationTime
			* TargetingSettings.AccelerationWeight

	if HorizontalOffset.Magnitude > MaximumHorizontalOffset and MaximumHorizontalOffset > 0 then
		HorizontalOffset = HorizontalOffset.Unit * MaximumHorizontalOffset
	end

	return HorizontalOffset, PredictionVelocity, RawVelocity.Y
end

local function GetPredictedAimPosition(TargetCharacter, AimPart, PredictionOverride)
	local Root = TargetCharacter:FindFirstChild("HumanoidRootPart")
	local Humanoid = TargetCharacter:FindFirstChildOfClass("Humanoid")
	local RequestedPrediction = PredictionOverride == nil and PredictionTime or PredictionOverride

	if not Root or not Humanoid then
		return AimPart.Position
	end

	local AimProfile = GetAvatarAimProfile(TargetCharacter, Root, AimPart)
	local ManualPrediction = 0
	local PingPrediction = 0

	if RequestedPrediction > 0 then
		ManualPrediction = math.clamp(RequestedPrediction, TargetingSettings.Minimum, TargetingSettings.Maximum)
		PingPrediction = GetPingPredictionOffset()
	end

	local ActivePrediction = math.clamp(
		ManualPrediction + PingPrediction,
		TargetingSettings.Minimum,
		TargetingSettings.MaximumTotal
	)
	local VerticalActivePrediction = math.clamp(
		ManualPrediction + PingPrediction * TargetingSettings.VerticalPingInfluence,
		TargetingSettings.Minimum,
		TargetingSettings.MaximumTotal
	)
	local State = Humanoid:GetState()
	local Airborne = State == Enum.HumanoidStateType.Jumping
		or State == Enum.HumanoidStateType.Freefall
		or (
			Humanoid.FloorMaterial == Enum.Material.Air
			and State ~= Enum.HumanoidStateType.Climbing
			and State ~= Enum.HumanoidStateType.Seated
			and State ~= Enum.HumanoidStateType.Swimming
		)
	local HorizontalOffset, HorizontalVelocity, RawVerticalVelocity =
		GetFilteredPredictionMotion(
			TargetCharacter,
			Root,
			Humanoid,
			AimProfile.CoreHorizontalRadius,
			ActivePrediction
		)
	local VerticalVelocity = Airborne
		and math.clamp(RawVerticalVelocity, -TargetingSettings.MaximumVerticalSpeed, TargetingSettings.MaximumVerticalSpeed)
		or 0
	local JumpState, SpamJumpBlend = UpdateJumpMotionState(
		TargetCharacter,
		Airborne,
		VerticalVelocity
	)
	local TimeSinceLanding = JumpState.LastLandingTime ~= nil
		and os.clock() - JumpState.LastLandingTime
		or math.huge
	local SpamJumpPredictionActive = RequestedPrediction > 0
		and SpamJumpBlend > 0
		and (
			Airborne
			or TimeSinceLanding <= TargetingSettings.SpamGroundPredictionWindow
		)
	local ActiveVerticalDeadzone = TargetingSettings.VerticalDeadzone
		* math.clamp(AimProfile.AvatarScale, 0.6, 1.5)
	local VerticalOffset = 0
	local VerticalPhaseBlend = math.clamp(
		(VerticalVelocity + ActiveVerticalDeadzone) / (2 * ActiveVerticalDeadzone),
		0,
		1
	)

	if Airborne then
		local VerticalPredictionScale = TargetingSettings.FallingPredictionScale
			+ (TargetingSettings.RisingPredictionScale - TargetingSettings.FallingPredictionScale)
				* VerticalPhaseBlend
		local VerticalPredictionTime = VerticalActivePrediction * VerticalPredictionScale

		VerticalOffset = VerticalVelocity * VerticalPredictionTime
			- 0.5 * workspace.Gravity * VerticalPredictionTime * VerticalPredictionTime * TargetingSettings.VerticalGravityMultiplier

		local GeometryVerticalLimit = math.clamp(AimProfile.BodyHeight * 0.65, 1.25, 7)
		local MotionVerticalLimit = math.abs(VerticalVelocity)
			* VerticalActivePrediction
			* TargetingSettings.VerticalMotionLimitScale
		local MaximumVerticalOffset = math.clamp(
			math.max(GeometryVerticalLimit, MotionVerticalLimit),
			TargetingSettings.MinimumVerticalOffsetLimit,
			TargetingSettings.MaximumVerticalOffsetLimit
		)
		VerticalOffset = math.clamp(VerticalOffset, -MaximumVerticalOffset, MaximumVerticalOffset)
	end

	local AirborneAimLowering = 0

	if Airborne then
		local BaseLowering = TargetingSettings.FallingAimLowering
			+ (TargetingSettings.RisingAimLowering - TargetingSettings.FallingAimLowering)
				* VerticalPhaseBlend
		AirborneAimLowering = math.min(
			BaseLowering * AimProfile.AvatarScale,
			AimProfile.CoreHalfHeight * 0.48
		)
	end

	local LocalCharacter = LocalPlayer.Character
	local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
	local ClosingSpeed = 0

	if LocalRoot then
		local ToShooter = Vector3.new(
			LocalRoot.Position.X - Root.Position.X,
			0,
			LocalRoot.Position.Z - Root.Position.Z
		)

		if ToShooter.Magnitude > 0.01 then
			ClosingSpeed = HorizontalVelocity:Dot(ToShooter.Unit)

			if ClosingSpeed > TargetingSettings.ClosingSpeedThreshold then
				local MaximumClosingLead = math.max(
					ToShooter.Magnitude - AimProfile.CoreHorizontalRadius,
					0
				)

				if HorizontalOffset.Magnitude > MaximumClosingLead then
					HorizontalOffset = MaximumClosingLead > 0
						and HorizontalOffset.Unit * MaximumClosingLead
						or Vector3.zero
				end
			end
		end
	end

	local PredictedPosition = AimProfile.AimPosition
		+ HorizontalOffset
		+ Vector3.new(0, VerticalOffset - AirborneAimLowering, 0)

	if Airborne
		or SpamJumpPredictionActive
		or VerticalOffset < 0
		or ClosingSpeed > TargetingSettings.ClosingSpeedThreshold then
		PredictionGroundParameters.FilterDescendantsInstances = LocalCharacter
			and { TargetCharacter, LocalCharacter }
			or { TargetCharacter }

		local RayOriginY = math.max(
			Root.Position.Y + AimProfile.BodyHeight,
			PredictedPosition.Y + AimProfile.CoreHalfHeight
		)
		local RayOrigin = Vector3.new(PredictedPosition.X, RayOriginY, PredictedPosition.Z)
		local RayDistance = math.max(
			12,
			RayOriginY - PredictedPosition.Y + AimProfile.BodyHeight + math.abs(VerticalOffset) + 4,
			SpamJumpPredictionActive and TargetingSettings.SpamGroundRayDistance or 0
		)
		local GroundResult = workspace:Raycast(
			RayOrigin,
			Vector3.new(0, -RayDistance, 0),
			PredictionGroundParameters
		)

		if GroundResult then
			local MinimumAimY = GroundResult.Position.Y + AimProfile.GroundToAimHeight

			if SpamJumpPredictionActive then
				local SpamPredictionTime = math.clamp(
					ActivePrediction * TargetingSettings.SpamCyclePredictionScale,
					TargetingSettings.SpamCycleMinimumTime,
					TargetingSettings.SpamCycleMaximumTime
				)
				local SpamPredictedY = GetSpamJumpPredictedY(
					AimProfile.AimPosition.Y,
					MinimumAimY,
					VerticalVelocity,
					SpamPredictionTime,
					Airborne,
					TimeSinceLanding,
					JumpState
				)

				if not Airborne
					or VerticalVelocity <= TargetingSettings.SpamTimingVelocityThreshold then
					local EarlyPredictionY = GetSpamJumpPredictedY(
						AimProfile.AimPosition.Y,
						MinimumAimY,
						VerticalVelocity,
						math.max(
							SpamPredictionTime - TargetingSettings.SpamTimingWindow,
							TargetingSettings.SpamCycleMinimumTime
						),
						Airborne,
						TimeSinceLanding,
						JumpState
					)
					local LatePredictionY = GetSpamJumpPredictedY(
						AimProfile.AimPosition.Y,
						MinimumAimY,
						VerticalVelocity,
						math.min(
							SpamPredictionTime + TargetingSettings.SpamTimingWindow,
							TargetingSettings.SpamCycleMaximumTime
						),
						Airborne,
						TimeSinceLanding,
						JumpState
					)
					local LowestPredictionY = math.min(
						EarlyPredictionY,
						SpamPredictedY,
						LatePredictionY
					)
					local HighestPredictionY = math.max(
						EarlyPredictionY,
						SpamPredictedY,
						LatePredictionY
					)
					local RangeCenterY = (LowestPredictionY + HighestPredictionY) * 0.5
					local MotionRange = HighestPredictionY - LowestPredictionY
					local SafeTorsoRange = AimProfile.CoreHalfHeight
						* TargetingSettings.SpamTimingTorsoRangeScale
					local TimingStrength = math.clamp(
						MotionRange / math.max(SafeTorsoRange, 0.01),
						TargetingSettings.SpamTimingMinimumStrength,
						1
					)

					SpamPredictedY = SpamPredictedY
						+ (RangeCenterY - SpamPredictedY) * TimingStrength
						+ TargetingSettings.SpamTimingVerticalLift
							* AimProfile.AvatarScale
							* TimingStrength
				end

				SpamPredictedY = math.max(
					SpamPredictedY - TargetingSettings.SpamAimLowering * AimProfile.AvatarScale,
					MinimumAimY
				)
				local ActiveSpamBlend = math.clamp(
					SpamJumpBlend * TargetingSettings.SpamCyclePredictionStrength,
					0,
					1
				)
				PredictedPosition = Vector3.new(
					PredictedPosition.X,
					PredictedPosition.Y
						+ (SpamPredictedY - PredictedPosition.Y) * ActiveSpamBlend,
					PredictedPosition.Z
				)
			end

			if PredictedPosition.Y < MinimumAimY then
				PredictedPosition = Vector3.new(PredictedPosition.X, MinimumAimY, PredictedPosition.Z)
			end
		end
	end

	return PredictedPosition
end

local function ResolveVisibleShotPosition(OriginPosition, TargetCharacter, AimPart, PredictedPosition)
	if HasClearShot(OriginPosition, TargetCharacter, PredictedPosition) then
		return PredictedPosition
	end

	local Root = TargetCharacter:FindFirstChild("HumanoidRootPart")
	if not Root then
		return nil
	end

	local AimProfile = GetAvatarAimProfile(TargetCharacter, Root, AimPart)
	local MotionOffset = PredictedPosition - AimProfile.AimPosition
	local SeenParts = {}

	for _, PartName in ipairs(TargetingSettings.VisibleFallbackParts) do
		local Part = TargetCharacter:FindFirstChild(PartName)

		if Part and Part:IsA("BasePart") and not SeenParts[Part] then
			SeenParts[Part] = true
			local ProbeRatio = TargetingSettings.VisibleAimProbeRatio
			local Center = Part.Position + MotionOffset
			local RightOffset = Part.CFrame.RightVector * Part.Size.X * ProbeRatio
			local UpOffset = Part.CFrame.UpVector * Part.Size.Y * ProbeRatio
			local DepthOffset = Part.CFrame.LookVector * Part.Size.Z * ProbeRatio
			local ProbePositions = {
				Center,
				Center + UpOffset,
				Center - UpOffset,
				Center + RightOffset,
				Center - RightOffset,
				Center + DepthOffset,
				Center - DepthOffset
			}

			for _, ProbePosition in ipairs(ProbePositions) do
				if HasClearShot(OriginPosition, TargetCharacter, ProbePosition) then
					return ProbePosition
				end
			end
		end
	end

	return nil
end

local function GetCharacterScreenDistance(Character, PointerPosition)
	CurrentCamera = workspace.CurrentCamera or CurrentCamera

	local MinimumX = math.huge
	local MinimumY = math.huge
	local MaximumX = -math.huge
	local MaximumY = -math.huge
	local HasPoint = false

	for _, BodyPart in ipairs(GetCharacterBodyParts(Character)) do
		local HalfSize = BodyPart.Size * 0.5
		local BodyCFrame = BodyPart.CFrame

		for _, Sign in ipairs(CharacterCornerSigns) do
			local Corner = BodyCFrame:PointToWorldSpace(Vector3.new(
				HalfSize.X * Sign.X,
				HalfSize.Y * Sign.Y,
				HalfSize.Z * Sign.Z
			))
			local ScreenPoint = CurrentCamera:WorldToScreenPoint(Corner)

			if ScreenPoint.Z > 0 then
				HasPoint = true
				MinimumX = math.min(MinimumX, ScreenPoint.X)
				MinimumY = math.min(MinimumY, ScreenPoint.Y)
				MaximumX = math.max(MaximumX, ScreenPoint.X)
				MaximumY = math.max(MaximumY, ScreenPoint.Y)
			end
		end
	end

	if not HasPoint then
		return nil
	end

	local Viewport = CurrentCamera.ViewportSize
	if MaximumX < 0 or MaximumY < 0 or MinimumX > Viewport.X or MinimumY > Viewport.Y then
		return nil
	end

	local ClosestPoint = Vector2.new(
		math.clamp(PointerPosition.X, MinimumX, MaximumX),
		math.clamp(PointerPosition.Y, MinimumY, MaximumY)
	)
	local ScreenCenter = Vector2.new(
		(MinimumX + MaximumX) * 0.5,
		(MinimumY + MaximumY) * 0.5
	)

	return (ClosestPoint - PointerPosition).Magnitude, (ScreenCenter - PointerPosition).Magnitude
end

local function FindTargetNearPointer(PointerPosition, _)
	local BestPlayer
	local BestAimPart
	local BestScore = math.huge

	for _, Player in ipairs(CachedPlayers) do
		if Player ~= LocalPlayer and Player.Parent == Players then
			local Character = Player.Character
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local Root = Character and Character:FindFirstChild("HumanoidRootPart")
			local AimPart = Character and GetPreferredAimPart(Character)

			if Humanoid and Humanoid.Health > 0 and Root and AimPart then
				local ScreenDistance, CenterDistance = GetCharacterScreenDistance(Character, PointerPosition)

				if ScreenDistance and ScreenDistance <= TargetRadius then
					local SelectionScore = ScreenDistance + CenterDistance * TargetingSettings.CenterWeight

					if Player == CurrentTargetPlayer then
						SelectionScore = SelectionScore - TargetingSettings.SwitchBias
					end

					if SelectionScore < BestScore then
						BestPlayer = Player
						BestAimPart = AimPart
						BestScore = SelectionScore
					end
				end
			end
		end
	end

	return BestPlayer, BestAimPart
end

local function ClearTargetHighlight()
	if CurrentTargetHighlight then
		CurrentTargetHighlight:Destroy()
		CurrentTargetHighlight = nil
	end
end

local function SetCurrentTarget(Player, AimPart)
	CurrentTargetPlayer = Player
	CurrentTargetPart = AimPart

	local Character = Player and Player.Character
	local HasRoleHighlight = Player and RoleHighlights[Player] ~= nil

	if not Character or HasRoleHighlight then
		ClearTargetHighlight()
		return
	end

	if CurrentTargetHighlight and CurrentTargetHighlight.Adornee == Character then
		return
	end

	ClearTargetHighlight()

	CurrentTargetHighlight = Instance.new("Highlight")
	CurrentTargetHighlight.Name = "_MXTargetHighlight"
	CurrentTargetHighlight.Adornee = Character
	CurrentTargetHighlight.FillTransparency = 1
	CurrentTargetHighlight.OutlineColor = Color3.fromRGB(255, 45, 55)
	CurrentTargetHighlight.OutlineTransparency = 0.05
	CurrentTargetHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
	CurrentTargetHighlight.Parent = Character
end

