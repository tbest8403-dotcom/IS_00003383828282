Track(RunService.RenderStepped:Connect(function(DeltaTime)
	UpdateSpectator(DeltaTime)
	AutoGrabGunAccumulator = AutoGrabGunAccumulator + DeltaTime

	if AutoGrabGunEnabled and AutoGrabGunAccumulator >= TargetingSettings.AutoGrabInterval then
		AutoGrabGunAccumulator = 0
		TryAutoGrabGun()
	end

	if TargetSpectateEnabled then
		local TargetCharacter = TargetSpectatePlayer and TargetSpectatePlayer.Character
		local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass("Humanoid")

		if not TargetSpectatePlayer or TargetSpectatePlayer.Parent ~= Players
			or not TargetCharacter or not TargetHumanoid or TargetHumanoid.Health <= 0 then
			DisableTargetSpectate("Target spectate ended")
		else
			CurrentCamera = workspace.CurrentCamera or CurrentCamera
			CurrentCamera.CameraType = Enum.CameraType.Custom
			CurrentCamera.CameraSubject = TargetHumanoid
		end
	end

	RoleRefreshAccumulator = RoleRefreshAccumulator + DeltaTime

	if RoleRefreshAccumulator >= TargetingSettings.RoleRefreshInterval then
		RoleRefreshAccumulator = 0
		RefreshRoleVisuals()
	end

	if AutoShoot.Enabled and not MurdererShotBusy and not MurderAllBusy and not AutoGrabGunBusy then
		local CurrentTime = os.clock()

		if CurrentTime >= AutoShoot.NextScanTime
			and CurrentTime - AutoShoot.LastShotTime >= AutoShoot.Interval then
			AutoShoot.NextScanTime = CurrentTime + AutoShoot.ScanInterval
			local Character = LocalPlayer.Character
			local OriginPart = Character and (Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart"))

			if OriginPart and OriginPart:IsA("BasePart") then
				local BestPlayer
				local BestPart
				local BestHitPosition
				local BestPriority = math.huge
				local BestDistance = math.huge
				local LocalTeamId = LocalPlayer:GetAttribute("TeamId")

				for _, Player in ipairs(CachedPlayers) do
					if Player ~= LocalPlayer and Player.Parent == Players then
						local PlayerTeamId = Player:GetAttribute("TeamId")
						local SameTeam = LocalTeamId ~= nil
							and PlayerTeamId ~= nil
							and PlayerTeamId == LocalTeamId

						if not AutoShoot.TeamCheck or not SameTeam then
							local TargetCharacter = Player.Character
							local ValidPart, PriorityRank, HitPosition =
								AutoShoot.FindValidPart(TargetCharacter, OriginPart.Position)

							if ValidPart and HitPosition then
								local Distance = (HitPosition - OriginPart.Position).Magnitude

								if PriorityRank < BestPriority
									or PriorityRank == BestPriority and Distance < BestDistance then
									BestPlayer = Player
									BestPart = ValidPart
									BestHitPosition = HitPosition
									BestPriority = PriorityRank
									BestDistance = Distance
								end
							end
						end
					end
				end

				if BestPlayer and BestPart and BestHitPosition then
					AutoShoot.LastShotTime = CurrentTime
					LastShotTime = CurrentTime
					task.spawn(
						ShootTargetWithMurdererLogic,
						BestPlayer,
						"Auto Shoot",
						BestPart,
						BestHitPosition,
						"Crossbow"
					)
				end
			end
		end
	end

	if not TargetingEnabled then
		TargetCircle.Visible = false
		return
	end

	local PointerPosition = GetPointerPosition()
	TargetCircle.Visible = true
	TargetCircle.Position = UDim2.fromOffset(PointerPosition.X, PointerPosition.Y)

	local Gun, _, OriginAttachment = GetEquippedGun()
	CurrentCamera = workspace.CurrentCamera or CurrentCamera
	local OriginPosition = OriginAttachment
		and (OriginAttachment:IsA("Attachment") and OriginAttachment.WorldPosition or OriginAttachment.Position)
		or CurrentCamera.CFrame.Position

	if Gun then
		SetManualActivation(Gun, true)
	end

	local TargetPlayer, AimPart = FindTargetNearPointer(PointerPosition, OriginPosition)

	SetCurrentTarget(TargetPlayer, AimPart)
	UpdateTargetCircleAppearance(TargetPlayer, Gun ~= nil)
end))

Window.ScreenGui.Destroying:Connect(function()
	if Cleaning then
		return
	end

	Cleaning = true
	AutoGrabGunEnabled = false
	AutoShoot.Enabled = false
	CachedGunDrop = nil
	SpectatorActionBusy = false
	DisableTargetSpectate()
	DisableSpectator()
	RestoreSpectatorPartStates()
	RunService:UnbindFromRenderStep(SpectatorRenderBindingName)
	RunService:UnbindFromRenderStep(SpectatorFinalBindingName)
	RestoreManualActivation()
	ClearTargetHighlight()
	ClearAllRoleHighlights()

	for Character in pairs(CharacterPartCache) do
		ClearCharacterPartCache(Character)
	end

	for Index = #Connections, 1, -1 do
		local Connection = Connections[Index]
		if Connection then
			Connection:Disconnect()
		end
		Connections[Index] = nil
	end

	if ReticleGui then
		ReticleGui:Destroy()
	end

	table.clear(PlayerRoles)
	table.clear(CachedPlayers)
end)
