	if not RoleVisualsEnabled or not GunDrop or not (GunDrop:IsA("BasePart") or GunDrop:IsA("Model")) then
		ClearGunDropHighlight()
		return
	end

	if GunDropHighlight and (not GunDropHighlight.Parent or GunDropHighlight.Adornee ~= GunDrop) then
		ClearGunDropHighlight()
	end

	if not GunDropHighlight then
		GunDropHighlight = Instance.new("Highlight")
		GunDropHighlight.Name = "_MXGunDropHighlight"
		GunDropHighlight.Adornee = GunDrop
		GunDropHighlight.FillColor = Color3.fromRGB(255, 190, 55)
		GunDropHighlight.FillTransparency = 0.72
		GunDropHighlight.OutlineColor = Color3.fromRGB(255, 230, 120)
		GunDropHighlight.OutlineTransparency = 0
		GunDropHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		GunDropHighlight.Parent = GunDrop
	end
end

local function UpdateRoleVisual(Player)
	if Player == LocalPlayer then
		PlayerRoles[Player] = nil
		ClearRoleHighlight(Player)
		return
	end

	local Character = Player.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Backpack = Player:FindFirstChildOfClass("Backpack") or Player:FindFirstChild("Backpack")

	if not Character or not Humanoid or Humanoid.Health <= 0 then
		PlayerRoles[Player] = nil
		ClearRoleHighlight(Player)
		return
	end

	local HasKnife = HasNamedTool(Character, "Knife") or HasNamedTool(Backpack, "Knife")
	local HasGun = HasNamedTool(Character, "Gun") or HasNamedTool(Backpack, "Gun")
	local OutlineColor = Color3.fromRGB(235, 235, 240)

	if HasKnife then
		PlayerRoles[Player] = "Murder"
		OutlineColor = Color3.fromRGB(255, 45, 55)
	elseif HasGun then
		PlayerRoles[Player] = "Sheriff"
		OutlineColor = Color3.fromRGB(55, 135, 255)
	else
		PlayerRoles[Player] = nil
	end

	if not RoleVisualsEnabled then
		ClearRoleHighlight(Player)
		return
	end

	local Highlight = RoleHighlights[Player]

	if Highlight and (not Highlight.Parent or Highlight.Adornee ~= Character) then
		ClearRoleHighlight(Player)
		Highlight = nil
	end

	if not Highlight then
		Highlight = Instance.new("Highlight")
		Highlight.Name = "_MXRoleHighlight"
		Highlight.Adornee = Character
		Highlight.FillTransparency = 1
		Highlight.OutlineTransparency = 0
		Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		Highlight.Parent = Character
		RoleHighlights[Player] = Highlight
	end

	Highlight.OutlineColor = OutlineColor

	if CurrentTargetPlayer == Player and CurrentTargetHighlight then
		CurrentTargetHighlight:Destroy()
		CurrentTargetHighlight = nil
	end
end

local function RefreshRoleVisuals()
	if not RoleVisualsEnabled then
		ClearAllRoleHighlights()
	end

	for _, Player in ipairs(CachedPlayers) do
		if Player.Parent == Players then
			UpdateRoleVisual(Player)
		end
	end

	for Player in pairs(RoleHighlights) do
		if Player.Parent ~= Players then
			ClearRoleHighlight(Player)
		end
	end

	UpdateGunDropVisual()
end

local function AddCachedPlayer(Player)
	for _, CachedPlayer in ipairs(CachedPlayers) do
		if CachedPlayer == Player then
			return
		end
	end

	CachedPlayers[#CachedPlayers + 1] = Player
end

