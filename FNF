-- The gameplay engine above and the toggle/render/cleanup logic below are
-- retained from the working script. These proxy objects replace only the old
-- standalone ScreenGui, allowing Xen to own all visible UI.

local ChangedBindable =
	Instance.new("BindableEvent")

local Destroyed = false
local ChangeQueued = false

local function QueueChanged()

	if Destroyed
		or ChangeQueued then

		return
	end

	ChangeQueued = true

	task.defer(function()

		ChangeQueued = false

		if not Destroyed then
			ChangedBindable:Fire()
		end
	end)
end

local function IsAfkScript(Candidate)

	return Candidate
		and Candidate.Name == "AfkSys"
		and Candidate:IsA("BaseScript")
end

local function ApplyAntiAfk()

	if AntiAfkEnabled then

		for _, Candidate in ipairs(PlayerScripts:GetChildren()) do

			if IsAfkScript(Candidate) then

				if AfkOriginalEnabled[Candidate] == nil then
					AfkOriginalEnabled[Candidate] = Candidate.Enabled
				end

				Candidate.Enabled = false
			end
		end

	else

		for Candidate, WasEnabled in pairs(AfkOriginalEnabled) do

			if Candidate.Parent then
				pcall(function()
					Candidate.Enabled = WasEnabled
				end)
			end

			AfkOriginalEnabled[Candidate] = nil
		end
	end
end

local AfkChildAddedConnection =
	PlayerScripts.ChildAdded:Connect(function(Child)

		if AntiAfkEnabled
			and IsAfkScript(Child) then

			task.defer(function()
				ApplyAntiAfk()
				QueueChanged()
			end)
		end
	end)

local function CreateSignal()

	local Callback = nil

	return {
		Connect = function(_, Handler)

			Callback = Handler

			return {
				Disconnect = function()

					Callback = nil
				end
			}
		end,

		Fire = function(_, ...)

			if Callback then
				return Callback(...)
			end
		end
	}
end

local function CreateTextBridge(InitialText)

	local StoredText = InitialText

	return setmetatable({}, {
		__index = function(Object, Key)

			if Key == "Text" then
				return StoredText
			end

			return rawget(Object, Key)
		end,

		__newindex = function(Object, Key, Value)

			if Key == "Text" then

				if StoredText ~= Value then
					StoredText = Value
					QueueChanged()
				end

				return
			end

			rawset(Object, Key, Value)
		end
	})
end

local Status =
	CreateTextBridge(
		"Auto Perfect: OFF"
	)

local Toggle =
	CreateTextBridge(
		"ENABLE AUTO PERFECT"
	)

Toggle.MouseButton1Click =
	CreateSignal()

local SideButton =
	CreateTextBridge(
		"INTERNAL INPUT: SEARCHING (CLICK TO RETRY)"
	)

SideButton.MouseButton1Click =
	CreateSignal()

local Info =
	CreateTextBridge(
		"Waiting for match..."
	)

local Close =
	CreateTextBridge("Close")

Close.MouseButton1Click =
	CreateSignal()

local GUI = {}

function GUI:Destroy()

	Destroyed = true

	task.defer(function()
		ChangedBindable:Destroy()
	end)
end

local function UpdateSideButton()

	if type(InternalKeyPress) == "function"
		and type(InternalKeyLift) == "function" then

		SideButton.Text =
			"INTERNAL INPUT: READY"
	else
		SideButton.Text =
			"INTERNAL INPUT: SEARCHING (CLICK TO RETRY)"
	end
end

UpdateSideButton()

SideButton.MouseButton1Click:Connect(function()

	ResolveInternalInput()
	UpdateSideButton()
end)

local Controller = {
	Id = "owner-perfect-player-v4",
	Name = "Owner Perfect Player V4",
	Version = ScriptVersion,
	Changed = ChangedBindable.Event
}

function Controller:GetState()

	return {
		Enabled = Enabled,
		AntiAfkEnabled = AntiAfkEnabled,
		Destroyed = Destroyed,
		Version = ScriptVersion,
		Status = Status.Text,
		ToggleLabel = Toggle.Text,
		InputStatus = SideButton.Text,
		Info = Info.Text,
		DetectedSide = DetectedSide,
		HitCount = HitCount,
		SavedCount = SavedCount,
		PredictionLookahead = PredictionLookahead,
		InternalInputReady =
			type(InternalKeyPress) == "function"
			and type(InternalKeyLift) == "function"
	}
end

function Controller:SetEnabled(NewEnabled)

	NewEnabled = NewEnabled == true

	if Destroyed then
		return false, "Controller has been destroyed."
	end

	if Enabled ~= NewEnabled then
		Toggle.MouseButton1Click:Fire()
	end

	local State = self:GetState()

	if State.Enabled ~= NewEnabled then
		return false, State.Status
	end

	return true, State
end

function Controller:SetAntiAfkEnabled(NewEnabled)

	NewEnabled = NewEnabled == true

	if Destroyed then
		return false, "Controller has been destroyed."
	end

	if AntiAfkEnabled ~= NewEnabled then
		AntiAfkEnabled = NewEnabled
		ApplyAntiAfk()
		QueueChanged()
	end

	return true, self:GetState()
end

function Controller:Toggle()

	if Destroyed then
		return false, "Controller has been destroyed."
	end

	Toggle.MouseButton1Click:Fire()
	return true, self:GetState()
end

function Controller:RetryInternalInput()

	if Destroyed then
		return false, "Controller has been destroyed."
	end

	SideButton.MouseButton1Click:Fire()
	return self:GetState().InternalInputReady, self:GetState()
end

function Controller:Destroy()

	if not Destroyed then
		Close.MouseButton1Click:Fire()
	end
end


--==================================================
-- TOGGLE LOGIC
--==================================================

Toggle.MouseButton1Click:Connect(function()

	if not ResolveInternalInput() then

		Status.Text =
			"Internal game input was not found."

		UpdateSideButton()

		return
	end

	Enabled =
		not Enabled

	CancelScheduledNotes()
	ResetPendingLanes()
	ConsecutiveInputFailures = 0
	LastInputRefreshAt = -math.huge

	for Note in pairs(PreviousSamples) do
		PreviousSamples[Note] = nil
	end

	if Enabled then

		Toggle.Text =
			"DISABLE AUTO PERFECT"

		Status.Text =
			"Auto Perfect: ON"

	else

		Toggle.Text =
			"ENABLE AUTO PERFECT"

		Status.Text =
			"Auto Perfect: OFF"

		ReleaseAll()
	end
end)

--==================================================
-- MAIN RENDER LOOP
--==================================================

local RenderConnection

RenderConnection =
	RunService.RenderStepped:Connect(
		function()

			local MatchFrame =
				FindMatchFrame()

			if not MatchFrame then

				DetectedSide = nil

				Info.Text =
					"No MatchFrame found.\n"
					.. "Start a match first."

				return
			end

			DetectedSide =
				DetectSide(
					MatchFrame
				)

			UpdateSideButton()

			Info.Text =
				"Side: "
				.. tostring(
					DetectedSide
					or "waiting"
				)

				.. "\nInput: internal game handlers"

				.. "\nConfirmed hits: "
				.. HitCount

				.. "   Emergency saves: "
				.. SavedCount

				.. "\nPrediction: "
				.. math.floor(
					PredictionLookahead
					* 1000
				)
				.. "ms ahead"

			if not Enabled
				or not DetectedSide then

				return
			end

			local Now = os.clock()

			for Lane = 1, 4 do

				local Notes =
					GetNotesFolder(
						MatchFrame,
						DetectedSide,
						Lane
					)

				if Notes then

					local Pending =
						LanePendingNote[Lane]

					if Pending then

						local Head = Pending.Note

						if not Head
							or not Head.Parent then

							if Head then
								NoteStates[Head] = "hit"
							end
							LanePendingNote[Lane] = nil
							HitCount += 1
							RecordInputSuccess()

							if Pending.WasEmergency then
								SavedCount += 1
							end

						elseif Head.Parent ~= Pending.NotesFolder then

							-- It moved to the game's Missed folder instead of being
							-- consumed by NoteInput.
							NoteStates[Head] = "hit"
							LanePendingNote[Lane] = nil
							ReleaseLane(Lane, Pending.PressToken)
							RecordInputFailure(false)

						elseif Now - Pending.AttemptAt
							>= HitVerifySeconds then

							-- The internal handler did not consume it. Release and let
							-- the lane retry while it is still inside 130.5 ms. Repeated
							-- failures trigger the input watchdog without abandoning a good
							-- handler after one mistimed attempt.
							NoteStates[Head] = nil
							LanePendingNote[Lane] = nil
							ReleaseLane(Lane, Pending.PressToken)
							RecordInputFailure(false)
						end
					end

					if not LanePendingNote[Lane] then

						local Note = GetLaneTarget(Notes)
						local OldScheduled = LaneScheduledNote[Lane]

						if OldScheduled
							and OldScheduled ~= Note then

							CancelNoteSchedule(OldScheduled)
							LaneScheduledNote[Lane] = nil
						end

						if Note
							and NoteStates[Note] ~= "hit"
							and NoteStates[Note] ~= "attempted" then

							local Current = Note.Position.Y.Scale
							local Previous = PreviousSamples[Note]
							local Velocity
							local SampleDelta

							if Previous then

								SampleDelta = Now - Previous.Time

								if SampleDelta > 0 then

									local InstantVelocity =
										(Current - Previous.Position)
										/ SampleDelta

									if math.abs(InstantVelocity) >= 0.00001 then

										if Previous.Velocity
											and Previous.Velocity * InstantVelocity > 0 then

											Velocity =
												Previous.Velocity * 0.65
												+ InstantVelocity * 0.35
										else
											Velocity = InstantVelocity
										end
									else
										Velocity = Previous.Velocity
									end
								end
							end

							PreviousSamples[Note] = {
								Position = Current,
								Time = Now,
								Velocity = Velocity
							}

							if Previous
								and Velocity
								and math.abs(Velocity) >= 0.00001 then

								local TimeToZero = -Current / Velocity
								local CrossedZero =
									(
										Previous.Position > 0
										and Current <= 0
									)
									or
									(
										Previous.Position < 0
										and Current >= 0
									)

								if CrossedZero
									and math.abs(TimeToZero) <= ValidHitWindow then

									HitNote(Lane, Note, Notes, true)

								elseif math.abs(TimeToZero) <= PerfectWindow then

									HitNote(Lane, Note, Notes, true)

								else
									ScheduleNote(
										Lane,
										Note,
										Notes,
										Current,
										Previous.Position,
										SampleDelta,
										Velocity
									)
								end
							end
						end
					end
				end
			end
		end
	)

