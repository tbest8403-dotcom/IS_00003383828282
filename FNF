--// Owner Perfect AutoPlayer V4
--// Internal-input, ordered-lane, lag-spike resistant version
--// Whoever executes this script is considered the owner.
--// Calls the game's own KeyPress / KeyLift handlers; no physical keys.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")

--==================================================
-- CONFIG
--==================================================

local ScriptVersion = "0.1.4"
local Enabled = false
local AntiAfkEnabled = false
local AfkOriginalEnabled = setmetatable({}, {
	__mode = "k"
})

-- How far ahead we begin predicting.
local PredictionLookahead = 0.15

-- These are the exact windows used by NoteInput in the supplied game script.
local PerfectWindow = 0.0165
local ValidHitWindow = 0.1305

local TapHoldSeconds = 0.012
local HitVerifySeconds = 0.040
local FailedHitsBeforeRefresh = 2
local InputRefreshCooldown = 0.20

local DetectedSide = nil
local LastDetectedSide = nil
local ActiveMatchFrame = nil
local ActiveKeySync1 = nil
local ActiveKeySync2 = nil

local InternalKeyPress = nil
local InternalKeyLift = nil
local InternalInputOwner = nil
local InternalInputEnvironment = nil
local ConsecutiveInputFailures = 0
local LastInputRefreshAt = -math.huge

local HitCount = 0
local SavedCount = 0

--==================================================
-- NOTE STATE
--==================================================

local NoteStates = setmetatable({}, {
	__mode = "k"
})

local PreviousSamples = setmetatable({}, {
	__mode = "k"
})

local ScheduleTokens = setmetatable({}, {
	__mode = "k"
})

local ScheduledTimes = setmetatable({}, {
	__mode = "k"
})

local LaneHeld = {
	false,
	false,
	false,
	false
}

-- Identifies which press currently owns each lane. Delayed releases from an
-- older note are ignored after a newer note takes ownership.
local LanePressToken = {
	0,
	0,
	0,
	0
}

local LaneInputObject = {
	nil,
	nil,
	nil,
	nil
}

local LanePendingNote = {
	nil,
	nil,
	nil,
	nil
}

local LaneScheduledNote = {
	nil,
	nil,
	nil,
	nil
}

--==================================================
-- INTERNAL GAME INPUT RESOLVER
--==================================================

local function ClearInternalInput()

	InternalKeyPress = nil
	InternalKeyLift = nil
	InternalInputOwner = nil
	InternalInputEnvironment = nil
end

local function CachedInternalInputIsCurrent()

	if type(InternalKeyPress) ~= "function"
		or type(InternalKeyLift) ~= "function" then

		return false
	end

	local Environment = InternalInputEnvironment

	-- getsenv owners can receive a replacement environment while their
	-- LocalScript instance stays alive, so read that owner again before use.
	if typeof(InternalInputOwner) == "Instance"
		and type(getsenv) == "function" then

		local Success, CurrentEnvironment =
			pcall(getsenv, InternalInputOwner)

		if Success
			and type(CurrentEnvironment) == "table" then

			Environment = CurrentEnvironment
		end
	end

	if type(Environment) ~= "table" then
		-- The named-function fallback has no authoritative environment to
		-- compare. Its health is handled by the failed-hit watchdog below.
		return true
	end

	return rawget(Environment, "KeyPress") == InternalKeyPress
		and rawget(Environment, "KeyLift") == InternalKeyLift
end

local function TryInputEnvironment(Environment, Owner)

	if type(Environment) ~= "table" then
		return false
	end

	local KeyPressFunction =
		rawget(Environment, "KeyPress")

	local KeyLiftFunction =
		rawget(Environment, "KeyLift")

	local NoteInputFunction =
		rawget(Environment, "NoteInput")

	if type(KeyPressFunction) == "function"
		and type(KeyLiftFunction) == "function"
		and type(NoteInputFunction) == "function" then

		InternalKeyPress = KeyPressFunction
		InternalKeyLift = KeyLiftFunction
		InternalInputOwner = Owner
		InternalInputEnvironment = Environment
		return true
	end

	return false
end

local function ResolveInternalInput(ForceRefresh)

	if not ForceRefresh
		and type(InternalKeyPress) == "function"
		and type(InternalKeyLift) == "function"
		and CachedInternalInputIsCurrent() then

		return true
	end

	-- A watchdog refresh should first re-read the environment that produced the
	-- last working pair. This avoids jumping to an unrelated older KeyPress pair
	-- that may still exist in getgc during a long match.
	if ForceRefresh then

		local PreviousOwner = InternalInputOwner
		local CurrentEnvironment = InternalInputEnvironment

		if typeof(PreviousOwner) == "Instance"
			and type(getsenv) == "function" then

			local Success, Environment =
				pcall(getsenv, PreviousOwner)

			if Success
				and type(Environment) == "table" then

				CurrentEnvironment = Environment
			end
		end

		if TryInputEnvironment(CurrentEnvironment, PreviousOwner) then
			return true
		end
	end

	ClearInternalInput()

	-- Some executors expose the environment of the LocalScript that required
	-- the gameplay module.
	if type(getsenv) == "function" then

		for _, Object in ipairs(PlayerGui:GetDescendants()) do

			if Object:IsA("LocalScript") then

				local Success, Environment =
					pcall(getsenv, Object)

				if Success
					and TryInputEnvironment(Environment, Object) then

					return true
				end
			end
		end
	end

	-- The supplied source is a ModuleScript. Its environment can normally be
	-- recovered from one of its live closures even when getsenv cannot see it.
	if type(getgc) == "function"
		and type(getfenv) == "function" then

		local Success, Objects =
			pcall(getgc, true)

		if Success
			and type(Objects) == "table" then

			local SeenEnvironments = {}
			local NamedFunctions = {}
			local NamedSources = {}

			for _, Object in ipairs(Objects) do

				if type(Object) == "table"
					and not SeenEnvironments[Object] then

					SeenEnvironments[Object] = true

					if TryInputEnvironment(Object, Object) then
						return true
					end

				elseif type(Object) == "function" then

					if type(debug) == "table"
						and type(debug.getinfo) == "function" then

						local GotInfo, Info =
							pcall(debug.getinfo, Object)

						if GotInfo
							and type(Info) == "table"
							and (
								Info.name == "KeyPress"
								or Info.name == "KeyLift"
								or Info.name == "NoteInput"
							) then

							NamedFunctions[Info.name] = Object
							NamedSources[Info.name] = Info.source
						end
					end

					local GotEnvironment, Environment =
						pcall(getfenv, Object)

					if GotEnvironment
						and type(Environment) == "table"
						and not SeenEnvironments[Environment] then

						SeenEnvironments[Environment] = true

						if TryInputEnvironment(Environment, Object) then
							return true
						end
					end
				end
			end

			local SameSource =
				NamedSources.KeyPress == nil
				or (
					NamedSources.KeyPress == NamedSources.KeyLift
					and NamedSources.KeyPress == NamedSources.NoteInput
				)

			if type(NamedFunctions.KeyPress) == "function"
				and type(NamedFunctions.KeyLift) == "function"
				and type(NamedFunctions.NoteInput) == "function"
				and SameSource then

				InternalKeyPress = NamedFunctions.KeyPress
				InternalKeyLift = NamedFunctions.KeyLift
				InternalInputOwner = NamedFunctions.NoteInput
				InternalInputEnvironment = nil
				return true
			end
		end
	end

	return false
end

local function RecordInputSuccess()

	ConsecutiveInputFailures = 0
end

local function RecordInputFailure(RefreshImmediately)

	ConsecutiveInputFailures += 1

	if not RefreshImmediately
		and ConsecutiveInputFailures < FailedHitsBeforeRefresh then

		return false
	end

	local Now = os.clock()

	if Now - LastInputRefreshAt < InputRefreshCooldown then
		return false
	end

	LastInputRefreshAt = Now
	ConsecutiveInputFailures = 0
	return ResolveInternalInput(true)
end

--==================================================
-- FIND MATCH FRAME
--==================================================

local function FindMatchFrame()

	if ActiveMatchFrame
		and ActiveMatchFrame.Parent
		and ActiveMatchFrame:FindFirstChild("KeySync1")
		and ActiveMatchFrame:FindFirstChild("KeySync2") then

		local KeySync1 =
			ActiveMatchFrame:FindFirstChild("KeySync1")
		local KeySync2 =
			ActiveMatchFrame:FindFirstChild("KeySync2")

		if KeySync1 ~= ActiveKeySync1
			or KeySync2 ~= ActiveKeySync2 then

			ActiveKeySync1 = KeySync1
			ActiveKeySync2 = KeySync2
			LastDetectedSide = nil
			ClearInternalInput()
		end

		return ActiveMatchFrame
	end

	for _, Object in ipairs(
		PlayerGui:GetDescendants()
	) do

		if Object.Name == "MatchFrame"
			and Object:FindFirstChild("KeySync1")
			and Object:FindFirstChild("KeySync2") then

			ActiveMatchFrame = Object
			ActiveKeySync1 = Object:FindFirstChild("KeySync1")
			ActiveKeySync2 = Object:FindFirstChild("KeySync2")
			LastDetectedSide = nil
			ClearInternalInput()

			return Object
		end
	end

	ActiveMatchFrame = nil
	ActiveKeySync1 = nil
	ActiveKeySync2 = nil
	LastDetectedSide = nil
	ClearInternalInput()

	return nil
end

--==================================================
-- INPUT CONFIG
--==================================================

local function GetInputs()

	if _G.Settings
		and type(_G.Settings.Inputs) == "table" then

		return _G.Settings.Inputs
	end

	-- Fallback
	return {
		"A",
		"S",
		"W",
		"D"
	}
end

local function GetLaneKeyName(Lane)

	local Inputs = GetInputs()

	local Name = Inputs[Lane]

	if typeof(Name) == "EnumItem" then
		Name = Name.Name
	end

	if type(Name) ~= "string" then
		return nil
	end

	return Name
end

local function GetLaneKeyCode(Lane)

	local Name =
		GetLaneKeyName(Lane)

	if not Name then
		return nil
	end

	local Success, KeyCode =
		pcall(function()
			return Enum.KeyCode[Name]
		end)

	if Success
		and KeyCode then

		return KeyCode
	end

	Success, KeyCode =
		pcall(function()
			return Enum.KeyCode[string.upper(Name)]
		end)

	if Success then
		return KeyCode
	end

	return nil
end

--==================================================
-- KEYBOARD INPUT
--==================================================

local function PressLane(Lane)

	if not ResolveInternalInput() then
		return false, nil
	end

	local KeyCode =
		GetLaneKeyCode(Lane)

	if not KeyCode then
		return false, nil
	end

	local InputObject = {
		UserInputType = Enum.UserInputType.Keyboard,
		KeyCode = KeyCode
	}

	-- A new press owns the lane from this point onward. This invalidates every
	-- delayed release that belongs to an older tap or hold.
	LanePressToken[Lane] += 1
	local Token = LanePressToken[Lane]

	-- songPlay separately remembers held KeyCodes and silently ignores a press
	-- while its entry is still true. Always synchronize a lift before pressing,
	-- even if our local lane state already says released. This prevents lanes
	-- from becoming permanently blocked after a missed/dropped release.
	local OldInput =
		LaneInputObject[Lane] or InputObject

	local LiftSuccess =
		pcall(
			InternalKeyLift,
			OldInput,
			false
		)

	if not LiftSuccess then
		RecordInputFailure(true)

		if type(InternalKeyLift) == "function" then
			pcall(
				InternalKeyLift,
				OldInput,
				false
			)
		end
	end

	LaneHeld[Lane] = false
	LaneInputObject[Lane] = nil

	local Success =
		pcall(
			InternalKeyPress,
			InputObject,
			false
		)

	if not Success then
		-- A replaced controller can leave the old closure callable but invalid.
		-- Refresh immediately when the function itself throws.
		RecordInputFailure(true)
	end

	if Success then
		LaneHeld[Lane] = true
		LaneInputObject[Lane] = InputObject
	end

	return Success, Token
end

local function ReleaseLane(Lane, ExpectedToken)

	if ExpectedToken
		and LanePressToken[Lane] ~= ExpectedToken then

		return false
	end

	if type(InternalKeyLift) ~= "function"
		and not ResolveInternalInput() then

		LaneHeld[Lane] = false
		LaneInputObject[Lane] = nil
		return false
	end

	local InputObject =
		LaneInputObject[Lane]

	if not InputObject then

		local KeyCode = GetLaneKeyCode(Lane)

		if KeyCode then
			InputObject = {
				UserInputType = Enum.UserInputType.Keyboard,
				KeyCode = KeyCode
			}
		end
	end

	if not InputObject then
		LaneHeld[Lane] = false
		LaneInputObject[Lane] = nil
		return false
	end

	local Success =
		pcall(
			InternalKeyLift,
			InputObject,
			false
		)

	if not Success then
		RecordInputFailure(true)
	end

	LaneHeld[Lane] = false
	LaneInputObject[Lane] = nil
	return Success
end

local function ReleaseAll()

	for Lane = 1, 4 do
		LanePressToken[Lane] += 1
		ReleaseLane(Lane)
	end
end

--==================================================
-- NOTE IDENTIFICATION
--==================================================

local function IsRealPlayerNote(Object)

	if not Object:IsA("GuiObject") then
		return false
	end

	if Object:GetAttribute("Type")
		~= "Note" then

		return false
	end

	-- Normal player-created notes have this.
	if Object:GetAttribute("HoldHead")
		~= true then

		return false
	end

	return true
end

local function GetLaneTarget(NotesFolder)

	local Candidates = {}

	for _, Note in ipairs(NotesFolder:GetChildren()) do

		if IsRealPlayerNote(Note) then
			Candidates[#Candidates + 1] = Note
		end
	end

	table.sort(Candidates, function(A, B)

		local TimeA =
			tonumber(A:GetAttribute("T"))
			or tonumber(A.Name)
			or math.huge

		local TimeB =
			tonumber(B:GetAttribute("T"))
			or tonumber(B.Name)
			or math.huge

		if TimeA == TimeB then

			local NameA = tonumber(A.Name)
			local NameB = tonumber(B.Name)

			if NameA
				and NameB then

				return NameA < NameB
			end

			return tostring(A.Name) < tostring(B.Name)
		end

		return TimeA < TimeB
	end)

	local First = Candidates[1]
	local Second = Candidates[2]

	-- This mirrors NoteInput: only the current and next lane notes are eligible,
	-- and the closer of those two is consumed.
	if Second
		and (
			not First
			or math.abs(Second.Position.Y.Scale)
				< math.abs(First.Position.Y.Scale)
		) then

		return Second
	end

	return First
end

--==================================================
-- NOTES FOLDER
--==================================================

local function GetNotesFolder(
	MatchFrame,
	Side,
	Lane
)

	local KeySync =
		MatchFrame:FindFirstChild(
			"KeySync" .. Side
		)

	if not KeySync then
		return nil
	end

	local Arrow =
		KeySync:FindFirstChild(
			"Arrow" .. Lane
		)

	if not Arrow then
		return nil
	end

	return Arrow:FindFirstChild(
		"Notes"
	)
end

--==================================================
-- SIDE DETECTION
--==================================================

local function CountPlayerNotes(
	MatchFrame,
	Side
)

	local Count = 0

	for Lane = 1, 4 do

		local Notes =
			GetNotesFolder(
				MatchFrame,
				Side,
				Lane
			)

		if Notes then

			for _, Note in ipairs(
				Notes:GetChildren()
			) do

				if IsRealPlayerNote(Note) then
					Count += 1
				end
			end
		end
	end

	return Count
end

local function DetectSide(MatchFrame)

	-- Battle() in the original client makes only the local player's underlay
	-- visible. This is a direct side marker and is safer than guessing from the
	-- currently spawned notes during dense charts or chart gaps.
	local KeySync1 = MatchFrame:FindFirstChild("KeySync1")
	local KeySync2 = MatchFrame:FindFirstChild("KeySync2")
	local Underlay1 = KeySync1 and KeySync1:FindFirstChild("Underlay")
	local Underlay2 = KeySync2 and KeySync2:FindFirstChild("Underlay")

	if Underlay1
		and Underlay2
		and Underlay1.Visible ~= Underlay2.Visible then

		local MarkedSide = Underlay1.Visible and 1 or 2

		if LastDetectedSide ~= MarkedSide then
			ConsecutiveInputFailures = 0
			ClearInternalInput()
		end

		LastDetectedSide = MarkedSide
		return LastDetectedSide
	end

	local Side1 =
		CountPlayerNotes(
			MatchFrame,
			1
		)

	local Side2 =
		CountPlayerNotes(
			MatchFrame,
			2
		)

	if Side1 > 0
		and Side2 == 0 then

		LastDetectedSide = 1
		return 1
	end

	if Side2 > 0
		and Side1 == 0 then

		LastDetectedSide = 2
		return 2
	end

	-- CreateNote marks local-player note heads with HoldHead. CreateAutoNote,
	-- used for the opponent, does not. Keep the last side through chart gaps.
	return LastDetectedSide
end

--==================================================
-- HOLD FRAME
--==================================================

local function FindHoldFrame(
	NotesFolder,
	Note
)

	if not NotesFolder
		or not Note then

		return nil
	end

	local Hold =
		NotesFolder:FindFirstChild(
			"Hold_" .. Note.Name
		)

	if Hold
		and Hold:IsA("GuiObject")
		and Hold:GetAttribute("LNHold")
			== true then

		return Hold
	end

	return nil
end

--==================================================
-- HOLD RELEASE HANDLER
--==================================================

local function HandleHold(
	Lane,
	Note,
	HoldFrame,
	PressToken
)

	-- Normal tap note
	if not HoldFrame then

		task.spawn(function()

			local ReleaseAt =
				os.clock() + TapHoldSeconds

			while Enabled
				and LaneHeld[Lane]
				and LanePressToken[Lane] == PressToken
				and os.clock() < ReleaseAt do

				RunService.RenderStepped:Wait()
			end

			ReleaseLane(Lane, PressToken)
		end)

		return
	end

	-- Long note
	task.spawn(function()

		local AcceptBy =
			os.clock() + HitVerifySeconds

		while Enabled
			and LaneHeld[Lane]
			and LanePressToken[Lane] == PressToken
			and Note
			and Note.Parent
			and os.clock() < AcceptBy do

			RunService.RenderStepped:Wait()
		end

		-- The internal handler destroys the head and reparents the hold frame
		-- synchronously when it accepts the hit.
		if Note
			and Note.Parent then

			ReleaseLane(Lane, PressToken)
			return
		end

		local Direction = 1

		if _G.Settings
			and tonumber(
				_G.Settings.Direction
			) then

			Direction =
				tonumber(
					_G.Settings.Direction
				)
		end

		local Started =
			os.clock()

		while Enabled
			and LaneHeld[Lane]
			and LanePressToken[Lane] == PressToken
			and HoldFrame
			and HoldFrame.Parent do

			local Size =
				math.abs(
					HoldFrame.Size.Y.Scale
				)

			local Position =
				HoldFrame.Position.Y.Scale
				* Direction

			-- Same general condition used by
			-- the game's hold completion logic.
			if Size + Position <= 1.5 then
				break
			end

			-- Safety against bad/stuck holds.
			if os.clock() - Started > 30 then
				break
			end

			RunService.RenderStepped:Wait()
		end

		ReleaseLane(Lane, PressToken)
	end)
end

--==================================================
-- ACTUAL HIT
--==================================================

local function CancelNoteSchedule(Note)

	if not Note then
		return
	end

	ScheduleTokens[Note] =
		(ScheduleTokens[Note] or 0) + 1

	ScheduledTimes[Note] = nil

	if NoteStates[Note] == "scheduled" then
		NoteStates[Note] = nil
	end
end

local function HitNote(
	Lane,
	Note,
	NotesFolder,
	WasEmergency
)

	if not Enabled then
		return false
	end

	if not Note
		or not Note.Parent then

		return false
	end

	if LanePendingNote[Lane] then
		return false
	end

	local State =
		NoteStates[Note]

	if State == "hit"
		or State == "attempted" then

		return false
	end

	-- Invalidate the predictor before entering the game's input handler.
	CancelNoteSchedule(Note)

	if LaneScheduledNote[Lane] == Note then
		LaneScheduledNote[Lane] = nil
	end

	local HoldFrame =
		FindHoldFrame(
			NotesFolder,
			Note
		)

	local Success, PressToken =
		PressLane(Lane)

	if Success then

		NoteStates[Note] = "attempted"

		LanePendingNote[Lane] = {
			Note = Note,
			NotesFolder = NotesFolder,
			AttemptAt = os.clock(),
			WasEmergency = WasEmergency,
			PressToken = PressToken
		}

		HandleHold(
			Lane,
			Note,
			HoldFrame,
			PressToken
		)

		return true
	end

	-- Let it retry if the internal call itself failed.
	NoteStates[Note] = nil

	return false
end

--==================================================
-- SCHEDULE PREDICTED HIT
--==================================================

local function ScheduleNote(
	Lane,
	Note,
	NotesFolder,
	CurrentPosition,
	PreviousPosition,
	SampleDelta,
	VelocityOverride
)

	if NoteStates[Note] == "hit"
		or NoteStates[Note] == "attempted" then

		return
	end

	if not PreviousPosition then
		return
	end

	if SampleDelta <= 0 then
		return
	end

	local Velocity =
		VelocityOverride
		or (
			CurrentPosition
			- PreviousPosition
		)
		/ SampleDelta

	if math.abs(Velocity)
		< 0.00001 then

		return
	end

	-- Estimate exactly when Y.Scale becomes 0.
	local TimeToZero =
		-CurrentPosition
		/ Velocity

	-- Moving away / already too far past.
	if TimeToZero < -ValidHitWindow then
		return
	end

	-- Don't schedule until reasonably close.
	if TimeToZero
		> PredictionLookahead then

		return
	end

	local Now = os.clock()
	local HitAt =
		Now + TimeToZero

	local ExistingTime =
		ScheduledTimes[Note]

	-- Keep a stable deadline, but replace it when a newer motion sample shows
	-- meaningful drift (scroll-speed change or dropped frame).
	if NoteStates[Note] == "scheduled"
		and ExistingTime
		and math.abs(ExistingTime - HitAt) <= 0.003 then

		return
	end

	local Token =
		(ScheduleTokens[Note] or 0) + 1

	ScheduleTokens[Note] = Token
	ScheduledTimes[Note] = HitAt
	NoteStates[Note] = "scheduled"
	LaneScheduledNote[Lane] = Note

	local function Fire()

		if ScheduleTokens[Note] ~= Token then
			return
		end

		if LaneScheduledNote[Lane] ~= Note then
			return
		end

		if not Enabled then
			NoteStates[Note] = nil
			ScheduledTimes[Note] = nil
			return
		end

		if not Note
			or not Note.Parent then

			NoteStates[Note] = nil
			ScheduledTimes[Note] = nil
			return
		end

		if NoteStates[Note] == "hit" then
			return
		end

		local Remaining =
			(ScheduledTimes[Note] or 0) - os.clock()

		if Remaining > 0.001 then
			task.delay(Remaining, Fire)
			return
		end

		HitNote(
			Lane,
			Note,
			NotesFolder,
			false
		)
	end

	task.delay(
		math.max(0, HitAt - Now),
		Fire
	)
end

local function CancelScheduledNotes()

	for Note, State in pairs(NoteStates) do

		if State == "scheduled" then
			ScheduleTokens[Note] =
				(ScheduleTokens[Note] or 0) + 1

			ScheduledTimes[Note] = nil
			NoteStates[Note] = nil
		end
	end

	for Lane = 1, 4 do
		LaneScheduledNote[Lane] = nil
	end
end

local function ResetPendingLanes()

	for Lane = 1, 4 do

		local Pending = LanePendingNote[Lane]

		if Pending
			and Pending.Note
			and NoteStates[Pending.Note] == "attempted" then

			NoteStates[Pending.Note] = nil
		end

		LanePendingNote[Lane] = nil
	end
end

