Close.MouseButton1Click:Connect(function()

	Enabled = false
	AntiAfkEnabled = false
	ApplyAntiAfk()

	if AfkChildAddedConnection then
		AfkChildAddedConnection:Disconnect()
		AfkChildAddedConnection = nil
	end

	ReleaseAll()

	CancelScheduledNotes()
	ResetPendingLanes()

	if RenderConnection then
		RenderConnection:Disconnect()
		RenderConnection = nil
	end

	GUI:Destroy()
end)

QueueChanged()

return Controller
