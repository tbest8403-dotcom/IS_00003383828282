-- Auto Weave
-- Detects nearby combat animations and uses the game's normal weave input.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local LocalPlayer = Players.LocalPlayer
local Packet = require(ReplicatedStorage:WaitForChild("Packet"))
local CombatPacket = Packet("A", Packet.Any, Packet.Buffer)

local Config = {
	Enabled = false,
	DetectM1 = true,
	DetectSpecials = true,
	TriggerDistance = 10,
	ReactionDelay = 0.025,
	WeaveCooldown = 0.43,
	FacingThreshold = -0.05
}

local AttackFolders = {
	M1s = "M1",
	Grabs = "Special",
	Stomps = "Special",
	Shoves = "Special",
	Slams = "Special"
}

local AttackAnimations = {}
local MonitoredAnimators = {}
local Connections = {}
local LastWeave = 0
local LastSide = 1
local LastPacketTime = 0
local WeaveBusy = false
local CurrentWeaveTrack = nil
local CurrentBodyPosition = nil
local WeaveTracks = setmetatable({}, { __mode = "k" })
local Destroyed = false
local UpdateStatus

local function NormalizeAnimationId(AnimationId)
	if type(AnimationId) ~= "string" then
		return nil
	end

	return AnimationId:match("%d+")
end

local function GetAttackCategory(Animation)
	local Current = Animation.Parent

	while Current and Current.Name ~= "Animations" do
		local Category = AttackFolders[Current.Name]

		if Category then
			return Category
		end

		Current = Current.Parent
	end

	return nil
end

local function RegisterAnimation(Animation)
	if not Animation:IsA("Animation") then
		return
	end

	local Category = GetAttackCategory(Animation)
	local AnimationId = NormalizeAnimationId(Animation.AnimationId)

	if Category and AnimationId then
		AttackAnimations[AnimationId] = Category
	end
end

local function ScanAnimations(Root)
	for _, Descendant in Root:GetDescendants() do
		RegisterAnimation(Descendant)
	end
end

local function CountAttackAnimations()
	local Count = 0

	for _ in AttackAnimations do
		Count += 1
	end

	return Count
end

local function GetCharacter()
	local Character = LocalPlayer.Character

	if not Character then
		return nil
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or Humanoid.Health <= 0 or not RootPart then
		return nil
	end

	return Character, Humanoid, RootPart
end

local function HasLineOfSight(EnemyCharacter, EnemyRoot, Character, RootPart)
	local Parameters = RaycastParams.new()
	Parameters.FilterType = Enum.RaycastFilterType.Exclude
	Parameters.FilterDescendantsInstances = { EnemyCharacter, Character }
	Parameters.IgnoreWater = true

	local Origin = EnemyRoot.Position + Vector3.new(0, 1, 0)
	local Direction = RootPart.Position + Vector3.new(0, 1, 0) - Origin
	return workspace:Raycast(Origin, Direction, Parameters) == nil
end

local function IsSideClear(Character, RootPart, Side)
	local Parameters = RaycastParams.new()
	Parameters.FilterType = Enum.RaycastFilterType.Exclude
	Parameters.FilterDescendantsInstances = { Character }
	Parameters.IgnoreWater = true

	local Origin = RootPart.Position + Vector3.new(0, 1.5, 0)
	local Direction = RootPart.CFrame.RightVector * Side * 4.25
	return workspace:Raycast(Origin, Direction, Parameters) == nil
end

local function IsBackwardClear(Character, RootPart)
	local Parameters = RaycastParams.new()
	Parameters.FilterType = Enum.RaycastFilterType.Exclude
	Parameters.FilterDescendantsInstances = { Character }
	Parameters.IgnoreWater = true

	local Origin = RootPart.Position + Vector3.new(0, 1.5, 0)
	local Direction = -RootPart.CFrame.LookVector * 3.25
	return workspace:Raycast(Origin, Direction, Parameters) == nil
end

local function Hash32(Text, Seed)
	local Value = Seed % 4294967296

	for Index = 1, #Text do
		local Mixed = bit32.bxor(Value, string.byte(Text, Index))
		local Low = Mixed % 65536
		local High = math.floor(Mixed / 65536) % 65536
		Value = (Low * 403 + (Low * 256 + High * 403) % 65536 * 65536) % 4294967296
	end

	local Shifted = bit32.bxor(Value, bit32.rshift(Value, 16))
	local Low = Shifted % 65536
	local High = math.floor(Shifted / 65536) % 65536
	local Mixed = (Low * 51819 + (Low * 34283 + High * 51819) % 65536 * 65536) % 4294967296
	Mixed = bit32.bxor(Mixed, bit32.rshift(Mixed, 13))
	Low = Mixed % 65536
	High = math.floor(Mixed / 65536) % 65536
	Mixed = (Low * 44597 + (Low * 49842 + High * 44597) % 65536 * 65536) % 4294967296

	return bit32.bxor(Mixed, bit32.rshift(Mixed, 16)) % 4294967296
end

local function DoubleHash(Text)
	return string.format(
		"%08x%08x",
		Hash32(Text, 2166136261),
		Hash32(Text, 2654435761)
	)
end

local function CanonicalizePayload(Payload)
	local Parts = {}

	for _, Key in { "Type", "SlamType", "Position", "Limb", "Hit", "Humanoid" } do
		local Value = Payload[Key]

		if Value ~= nil then
			local ValueType = typeof(Value)
			local Encoded

			if ValueType == "Instance" then
				Encoded = Value.Name
			elseif ValueType == "Vector3" then
				Encoded = string.format("%.2f,%.2f,%.2f", Value.X, Value.Y, Value.Z)
			elseif ValueType == "number" then
				Encoded = string.format("%.4g", Value)
			else
				Encoded = tostring(Value)
			end

			Parts[#Parts + 1] = Key .. "=" .. Encoded
		end
	end

	return table.concat(Parts, "&")
end

local function SecureFire(Payload)
	local Seed = LocalPlayer:GetAttribute("K")

	if not Seed then
		return false, "Waiting for security key"
	end

	local Milliseconds = workspace:GetServerTimeNow() * 1000 + 0.5
	local PacketTime = math.floor(Milliseconds) / 1000

	if PacketTime <= LastPacketTime then
		PacketTime = LastPacketTime + 0.001
	end

	LastPacketTime = PacketTime
	local TimeBucket = math.floor(PacketTime / 6)
	local BucketHash = DoubleHash(Seed .. "|" .. tostring(TimeBucket))
	local SignedText = BucketHash
		.. "#"
		.. string.format("%.3f", PacketTime)
		.. "#"
		.. CanonicalizePayload(Payload)

	local Success, ErrorMessage = pcall(function()
		CombatPacket:Fire({
			p = Payload,
			t = PacketTime,
			s = DoubleHash(SignedText)
		}, buffer.create(math.random(2, 7)))
	end)

	return Success, ErrorMessage
end

local function ChooseWeaveDirection(EnemyRoot, Character, RootPart)
	local EnemyOffset = RootPart.CFrame:PointToObjectSpace(EnemyRoot.Position)
	local PreferredSide = EnemyOffset.X >= 0 and -1 or 1

	if math.abs(EnemyOffset.X) < 0.3 then
		PreferredSide = -LastSide
	end

	if IsSideClear(Character, RootPart, PreferredSide) then
		LastSide = PreferredSide
		return PreferredSide == -1 and "Left" or "Right", PreferredSide
	end

	if IsSideClear(Character, RootPart, -PreferredSide) then
		LastSide = -PreferredSide
		return PreferredSide == -1 and "Right" or "Left", -PreferredSide
	end

	if IsBackwardClear(Character, RootPart) then
		return "Backward", 0
	end

	return nil, 0
end

local function GetWeaveTrack(Character, Humanoid, Direction)
	local Combat = Character:FindFirstChild("Combat")
	local Animations = Combat and Combat:FindFirstChild("Animations")
	local WeaveFolder = Animations and Animations:FindFirstChild("Weave")
	local Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not WeaveFolder or not Animator then
		return nil
	end

	local AnimatorTracks = WeaveTracks[Animator]

	if not AnimatorTracks then
		AnimatorTracks = {}
		WeaveTracks[Animator] = AnimatorTracks
	end

	if AnimatorTracks[Direction] then
		return AnimatorTracks[Direction]
	end

	local Animation = WeaveFolder:FindFirstChild(Direction, true)

	if Animation and Animation:IsA("Animation") then
		AnimatorTracks[Direction] = Animator:LoadAnimation(Animation)
		return AnimatorTracks[Direction]
	end

	return nil
end

local function StopInternalWeave(FadeTime)
	if CurrentBodyPosition then
		CurrentBodyPosition:Destroy()
		CurrentBodyPosition = nil
	end

	if CurrentWeaveTrack and CurrentWeaveTrack.IsPlaying then
		CurrentWeaveTrack:Stop(FadeTime or 0.1)
	end

	CurrentWeaveTrack = nil
end

local function StartInternalWeave(Character, Humanoid, RootPart, Direction, Side)
	if WeaveBusy or Character:GetAttribute("WeaveStun") then
		return false, "Weave unavailable"
	end

	local Track = GetWeaveTrack(Character, Humanoid, Direction)

	if not Track then
		return false, "Weave animation missing"
	end

	WeaveBusy = true
	StopInternalWeave(0.05)
	CurrentWeaveTrack = Track
	CurrentWeaveTrack:Play(0.15)

	for _, Descendant in Character:GetDescendants() do
		if Descendant:IsA("BodyPosition") then
			Descendant:Destroy()
		end
	end

	local Destination

	if Direction == "Left" or Direction == "Right" then
		Destination = (RootPart.CFrame * CFrame.new(2.15 * Side, 0, 0)).Position
	else
		Destination = (RootPart.CFrame * CFrame.new(0, 0, 1.15)).Position
	end

	local BodyPosition = Instance.new("BodyPosition")
	BodyPosition.Position = Destination
	BodyPosition.MaxForce = Vector3.new(30000, 0, 30000)
	BodyPosition.P = 80
	BodyPosition.D = 0
	BodyPosition.Parent = RootPart
	CurrentBodyPosition = BodyPosition
	Debris:AddItem(BodyPosition, 0.2)

	local Success, ErrorMessage = SecureFire({
		Type = "Weave"
	})

	if not Success then
		WeaveBusy = false
		StopInternalWeave(0.05)
		return false, ErrorMessage
	end

	task.delay(0.22, function()
		if CurrentBodyPosition == BodyPosition then
			CurrentBodyPosition = nil
		end

		if CurrentWeaveTrack == Track then
			StopInternalWeave(0.1)
		end
	end)

	task.delay(Config.WeaveCooldown, function()
		WeaveBusy = false

		if Character:GetAttribute("WeaveStun") then
			StopInternalWeave(0.05)
		end
	end)

	return true
end

local function PerformWeave(EnemyCharacter)
	if not Config.Enabled or Destroyed then
		return
	end

	if os.clock() - LastWeave < Config.WeaveCooldown then
		return
	end

	local Character, Humanoid, RootPart = GetCharacter()
	local EnemyHumanoid = EnemyCharacter and EnemyCharacter:FindFirstChildOfClass("Humanoid")
	local EnemyRoot = EnemyCharacter and EnemyCharacter:FindFirstChild("HumanoidRootPart")

	if not Character or not EnemyHumanoid or EnemyHumanoid.Health <= 0 or not EnemyRoot then
		return
	end

	local Distance = (EnemyRoot.Position - RootPart.Position).Magnitude

	if Distance > Config.TriggerDistance then
		return
	end

	local DirectionToPlayer = RootPart.Position - EnemyRoot.Position

	if DirectionToPlayer.Magnitude <= 0 then
		return
	end

	local Facing = EnemyRoot.CFrame.LookVector:Dot(DirectionToPlayer.Unit)

	if Facing < Config.FacingThreshold then
		return
	end

	if not HasLineOfSight(EnemyCharacter, EnemyRoot, Character, RootPart) then
		return
	end

	if Character:FindFirstChild("Stun")
		or Character:FindFirstChild("BUSY")
		or Character:GetAttribute("HitStun")
		or Character:GetAttribute("WeaveStun") then
		return
	end

	local Knocked = Character:FindFirstChild("Knocked")

	if Knocked and Knocked:IsA("BoolValue") and Knocked.Value then
		return
	end

	if not Character:FindFirstChild("Fist") then
		return
	end

	local Direction, Side = ChooseWeaveDirection(EnemyRoot, Character, RootPart)

	if not Direction then
		if UpdateStatus then
			UpdateStatus("Blocked on every side")
		end

		return
	end

	LastWeave = os.clock()
	local Success, ErrorMessage = StartInternalWeave(Character, Humanoid, RootPart, Direction, Side)

	if not Success then
		if UpdateStatus then
			UpdateStatus(tostring(ErrorMessage or "Weave packet failed"))
		end

		return
	end

	if UpdateStatus then
		UpdateStatus(Direction .. " weave from " .. EnemyCharacter.Name)
	end
end

local function OnAnimationPlayed(Character, Track)
	if not Config.Enabled or Character == LocalPlayer.Character then
		return
	end

	local Animation = Track.Animation
	local AnimationId = Animation and NormalizeAnimationId(Animation.AnimationId)
	local Category = AnimationId and AttackAnimations[AnimationId]

	if not Category then
		return
	end

	if Category == "M1" and not Config.DetectM1 then
		return
	end

	if Category == "Special" and not Config.DetectSpecials then
		return
	end

	task.delay(Config.ReactionDelay, function()
		PerformWeave(Character)
	end)
end

local function MonitorCharacter(Character)
	if not Character or Character == LocalPlayer.Character then
		return
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if not Humanoid then
		return
	end

	local Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator or MonitoredAnimators[Animator] then
		return
	end

	MonitoredAnimators[Animator] = Animator.AnimationPlayed:Connect(function(Track)
		OnAnimationPlayed(Character, Track)
	end)

	Connections[#Connections + 1] = Character.AncestryChanged:Connect(function(_, Parent)
		if Parent then
			return
		end

		local Connection = MonitoredAnimators[Animator]

		if Connection then
			Connection:Disconnect()
			MonitoredAnimators[Animator] = nil
		end
	end)
end

local function ScanCharacters()
	local Live = workspace:FindFirstChild("Live")

	if Live then
		for _, Character in Live:GetChildren() do
			MonitorCharacter(Character)
		end
	end

	for _, Player in Players:GetPlayers() do
		if Player ~= LocalPlayer and Player.Character then
			MonitorCharacter(Player.Character)
		end
	end
end

local function GetGuiParent()
	local Success, HiddenGui = pcall(function()
		if gethui then
			return gethui()
		end
	end)

	if Success and HiddenGui then
		return HiddenGui
	end

	local CoreSuccess = pcall(function()
		return CoreGui.Name
	end)

	if CoreSuccess then
		return CoreGui
	end

	return LocalPlayer:WaitForChild("PlayerGui")
end

