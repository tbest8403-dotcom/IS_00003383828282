	Connections[#Connections + 1] = Live.DescendantAdded:Connect(function(Descendant)
		if Descendant:IsA("Animation") then
			RegisterAnimation(Descendant)
		end

		if Descendant:IsA("Animator") and Descendant.Parent and Descendant.Parent.Parent then
			MonitorCharacter(Descendant.Parent.Parent)
		end
	end)
end

for _, Player in Players:GetPlayers() do
	if Player ~= LocalPlayer then
		Connections[#Connections + 1] = Player.CharacterAdded:Connect(function(Character)
			task.delay(0.25, function()
				if not Destroyed then
					MonitorCharacter(Character)
				end
			end)
		end)
	end
end

Connections[#Connections + 1] = Players.PlayerAdded:Connect(function(Player)
	if Player == LocalPlayer then
		return
	end

	Connections[#Connections + 1] = Player.CharacterAdded:Connect(function(Character)
		task.delay(0.25, function()
			if not Destroyed then
				MonitorCharacter(Character)
			end
		end)
	end)
end)

Connections[#Connections + 1] = LocalPlayer.CharacterAdded:Connect(function(Character)
	WeaveBusy = false
	StopInternalWeave(0.05)

	task.delay(0.5, function()
		if not Destroyed then
			ScanAnimations(Character)
			ScanCharacters()
			UpdateStatus(Config.Enabled and "Watching nearby attacks" or "Disabled")
		end
	end)

	Connections[#Connections + 1] = Character:GetAttributeChangedSignal("WeaveStun"):Connect(function()
		if Character:GetAttribute("WeaveStun") then
			WeaveBusy = false
			StopInternalWeave(0.05)
		end
	end)

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if Humanoid then
		Connections[#Connections + 1] = Humanoid.Died:Connect(function()
			WeaveBusy = false
			StopInternalWeave(0.05)
		end)
	end
end)

local CurrentCharacter = LocalPlayer.Character

if CurrentCharacter then
	Connections[#Connections + 1] = CurrentCharacter:GetAttributeChangedSignal("WeaveStun"):Connect(function()
		if CurrentCharacter:GetAttribute("WeaveStun") then
			WeaveBusy = false
			StopInternalWeave(0.05)
		end
	end)

	local CurrentHumanoid = CurrentCharacter:FindFirstChildOfClass("Humanoid")

	if CurrentHumanoid then
		Connections[#Connections + 1] = CurrentHumanoid.Died:Connect(function()
			WeaveBusy = false
			StopInternalWeave(0.05)
		end)
	end
end

ScanCharacters()
UpdateStatus("Disabled")
