function Window:Notify(Options)
	if not NotificationsEnabled then
		return nil
	end
	Options = type(Options) == "table" and Options or {}
	LastNotification = {
		Title = tostring(Options.Title or "MX"),
		Content = tostring(Options.Content or ""),
		Type = tostring(Options.Type or "Info")
	}
	QueueChanged()
	return LastNotification
end

local function CreateValueControl(DefaultValue, Callback)
	local Value = DefaultValue
	local Control = {}

	function Control:Get()
		return Value
	end

	function Control:Set(NewValue, Silent, ...)
		local Changed = Value ~= NewValue
		Value = NewValue
		local Success, Result = true, nil
		if not Silent and type(Callback) == "function" then
			Success, Result = pcall(Callback, NewValue, ...)
			if not Success then
				Window:Notify({ Title = "MX", Content = tostring(Result), Type = "Error" })
			end
		end
		if Changed then
			QueueChanged()
		end
		return Success, Result
	end

	return Control
end

local function CreateBridgeSection()
	local Section = {}

	function Section:AddLabel(Text)
		return CreateValueControl(tostring(Text or ""), nil)
	end

	function Section:AddToggle(Config)
		Config = Config or {}
		return CreateValueControl(Config.Default == true, Config.Callback)
	end

	function Section:AddSlider(Config)
		Config = Config or {}
		return CreateValueControl(Config.Default, Config.Callback)
	end

	function Section:AddPlayerTextbox(Config)
		Config = Config or {}
		return CreateValueControl(nil, Config.Callback)
	end

	function Section:AddTargetToggle(Config)
		Config = Config or {}
		return CreateValueControl(Config.Default == true, Config.Callback)
	end

	function Section:AddButton(Config)
		Config = Config or {}
		local Control = {}
		function Control:Press()
			if type(Config.Callback) ~= "function" then
				return true
			end
			local Success, Result = pcall(Config.Callback)
			if not Success then
				Window:Notify({ Title = tostring(Config.Name or "MX"), Content = tostring(Result), Type = "Error" })
			end
			QueueChanged()
			return Success, Result
		end
		return Control
	end

	return Section
end

