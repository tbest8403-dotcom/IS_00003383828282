	Name = "MX Targeting & Spectator",
	Version = ScriptVersion,
	Changed = ChangedBindable.Event,
	PredictionMinimum = JumpPredictor.Minimum,
	PredictionMaximum = JumpPredictor.Maximum,
	TargetRadiusMinimum = 30,
	TargetRadiusMaximum = 160,
	DefaultSpectatorKey = Enum.KeyCode.V,
	SpectatorDepthMinimum = 5,
	SpectatorDepthMaximum = 60,
	SpectatorSpeedMinimum = 8,
	SpectatorSpeedMaximum = 60
}

local function ControllerReady()
	if Destroyed or Cleaning then
		return false, "Controller has been destroyed."
	end
	return true
end

local function ResolvePlayer(Value)
	if typeof(Value) == "Instance" and Value:IsA("Player") and Value.Parent == Players then
		return Value
	end
	local Query = string.lower(tostring(Value or ""))
	if Query == "" then
		return nil
	end
	local PrefixMatch = nil
	for _, Player in ipairs(Players:GetPlayers()) do
		local Name = string.lower(Player.Name)
		local DisplayName = string.lower(Player.DisplayName)
		if Name == Query or DisplayName == Query then
			return Player
		end
		if not PrefixMatch
			and (string.sub(Name, 1, #Query) == Query
				or string.sub(DisplayName, 1, #Query) == Query) then
			PrefixMatch = Player
		end
	end
	return PrefixMatch
end

function Controller:GetState()
	local SelectedPlayer = StaffTargetControl and StaffTargetControl:Get() or nil
	return {
		TargetingEnabled = TargetingEnabled,
		RoleVisualsEnabled = RoleVisualsEnabled,
		SpectatorEnabled = SpectatorEnabled,
		TargetSpectateEnabled = TargetSpectateEnabled,
		NotificationsEnabled = NotificationsEnabled,
		AutoGrabGunEnabled = AutoGrabGunEnabled,
		TargetRadius = TargetRadius,
		Prediction = JumpPredictor.Time,
		SpectatorDepth = SpectatorDepth,
		SpectatorMoveSpeed = SpectatorMoveSpeed,
		SpectatorVerticalSpeed = SpectatorVerticalSpeed,
		SelectedPlayer = SelectedPlayer and SelectedPlayer.Name or nil,
		SelectedDisplayName = SelectedPlayer and SelectedPlayer.DisplayName or nil,
		Status = StatusControl and StatusControl:Get() or "Ready",
		LastNotification = LastNotification,
		Destroyed = Destroyed,
		Version = ScriptVersion
	}
end

local function SetControl(Control, Value, ...)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then
		return false, ErrorMessage
	end
	local Success, Result = Control:Set(Value, false, ...)
	if not Success then
		return false, Result
	end
	return true
end

function Controller:SetTargetingEnabled(Enabled)
	Enabled = Enabled == true
	local Success, Result = SetControl(TargetingControl, Enabled, false)
	if not Success then return false, Result end
	if TargetingEnabled ~= Enabled then
		return false, "Targeting could not be changed while spectator is active."
	end
	return true, self:GetState()
end

function Controller:SetRoleVisualsEnabled(Enabled)
	local Success, Result = SetControl(RoleVisualsControl, Enabled == true, false)
	if not Success then return false, Result end
	return true, self:GetState()
end

function Controller:SetPrediction(Value)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	Value = tonumber(Value)
	if not Value then return false, "Prediction must be a number." end
	JumpPredictor.Time = math.clamp(Value, JumpPredictor.Minimum, JumpPredictor.Maximum)
	QueueChanged()
	return true, self:GetState()
end

function Controller:SetTargetRadius(Value)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	Value = tonumber(Value)
	if not Value then return false, "Target radius must be a number." end
	TargetRadius = math.round(math.clamp(Value, 30, 160))
	TargetCircle.Size = UDim2.fromOffset(TargetRadius * 2, TargetRadius * 2)
	QueueChanged()
	return true, self:GetState()
end

function Controller:SetTargetPlayer(Value)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	local Player = ResolvePlayer(Value)
	if not Player then return false, "Player was not found." end
	local Success, Result = StaffTargetControl:Set(Player, false, false)
	if not Success then return false, Result end
	return true, self:GetState()
end

function Controller:SelectMurderer()
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	local Murderer = GetCurrentMurderer()
	if not Murderer then return false, "No living murderer was detected." end
	local Success, Result = StaffTargetControl:Set(Murderer, false, false)
	if not Success then return false, Result end
	return true, self:GetState()
end

function Controller:SetTargetSpectateEnabled(Enabled)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	Enabled = Enabled == true
	local TargetPlayer = StaffTargetControl and StaffTargetControl:Get() or nil
	if Enabled and not TargetPlayer then return false, "Select a target first." end
	local Success, Result = TargetSpectateControl:Set(Enabled, false, TargetPlayer)
	if not Success then return false, Result end
	if TargetSpectateEnabled ~= Enabled then return false, "Target spectate could not be changed." end
	return true, self:GetState()
end

local function RunControllerAction(Action)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	local Success, Result = pcall(Action)
	QueueChanged()
	if not Success then return false, Result end
	return true, Controller:GetState()
end

function Controller:ShootMurderer()
	return RunControllerAction(ShootMurdererPrivilege)
end

function Controller:MurderAll()
	return RunControllerAction(MurderAllPlayers)
end

function Controller:SetAutoGrabGunEnabled(Enabled)
	Enabled = Enabled == true
	local Success, Result = SetControl(AutoGrabGunControl, Enabled, false)
	if not Success then return false, Result end
	if AutoGrabGunEnabled ~= Enabled then return false, "Auto Grab Gun is unavailable." end
	return true, self:GetState()
end

function Controller:SetNotificationsEnabled(Enabled)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	NotificationsEnabled = Enabled == true
	Window.AutoNotify = NotificationsEnabled
	QueueChanged()
	return true, self:GetState()
end

function Controller:SetSpectatorEnabled(Enabled)
	Enabled = Enabled == true
	local Success, Result = SetControl(SpectatorControl, Enabled, false)
	if not Success then return false, Result end
	if SpectatorEnabled ~= Enabled then return false, "Spectator could not be changed." end
	return true, self:GetState()
end

function Controller:ToggleSpectator()
	return self:SetSpectatorEnabled(not SpectatorEnabled)
end

function Controller:SetSpectatorDepth(Value)
	local Ready, ErrorMessage = ControllerReady()
	if not Ready then return false, ErrorMessage end
	Value = tonumber(Value)
	if not Value then return false, "Spectator depth must be a number." end
	SpectatorDepth = math.round(math.clamp(Value, 5, 60))
	QueueChanged()
	return true, self:GetState()
end

