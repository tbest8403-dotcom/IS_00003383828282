local idCharacters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

local function generateId(length)
	local result = table.create(length)
	for index = 1, length do
		local i = math.random(1, #idCharacters)
		result[index] = string.sub(idCharacters, i, i)
	end
	return table.concat(result)
end

local function solveBallisticVelocity(origin, targetPosition, speed)
	local displacement = targetPosition - origin
	local horizontal = Vector3.new(displacement.X, 0, displacement.Z)
	local distance = horizontal.Magnitude
	if distance < 0.001 then
		return displacement.Unit * speed, displacement.Magnitude / speed
	end
	local speedSquared = speed * speed
	local discriminant = speedSquared * speedSquared
		- PROJECTILE_GRAVITY * (
			PROJECTILE_GRAVITY * distance * distance + 2 * displacement.Y * speedSquared
		)
	if discriminant < 0 then
		return displacement.Unit * speed, displacement.Magnitude / speed
	end
	local tangent = (speedSquared - math.sqrt(discriminant)) / (PROJECTILE_GRAVITY * distance)
	local cosine = 1 / math.sqrt(1 + tangent * tangent)
	local sine = tangent * cosine
	local velocity = horizontal.Unit * (speed * cosine) + Vector3.new(0, speed * sine, 0)
	return velocity, distance / math.max(speed * cosine, 0.001)
end

local function calculatePredictedVelocity(origin, targetCharacter, targetRoot, speed)
	local basePosition = targetRoot.Position + Vector3.new(0, 0.5, 0)
	local targetVelocity = targetRoot.AssemblyLinearVelocity
	local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	local state = humanoid and humanoid:GetState()
	local airborne = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
	local time = (basePosition - origin).Magnitude / speed
	local launchVelocity
	for _ = 1, 4 do
		local velocity = Vector3.new(targetVelocity.X, airborne and targetVelocity.Y or 0, targetVelocity.Z)
		local predictedPosition = basePosition + velocity * time
		if airborne then
			predictedPosition += Vector3.new(0, -0.5 * workspace.Gravity * time * time, 0)
		end
		launchVelocity, time = solveBallisticVelocity(origin, predictedPosition, speed)
	end
	return launchVelocity
end

local activeProjectileConnections = {}

local function disconnectProjectileConnection(connection)
	if connection then
		activeProjectileConnections[connection] = nil
		connection:Disconnect()
	end
end

local function simulateProjectile(projectileId, origin, velocity, targetCharacter, lifetime)
	local ownCharacter = player.Character
	if not ownCharacter then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ownCharacter }
	params.IgnoreWater = true
	local position = origin
	local age = 0
	local connection
	connection = RunService.Heartbeat:Connect(function(deltaTime)
		age += deltaTime
		if age >= lifetime then
			disconnectProjectileConnection(connection)
			return
		end
		local nextVelocity = velocity + Vector3.new(0, -PROJECTILE_GRAVITY, 0) * deltaTime
		local nextPosition = position + (velocity + nextVelocity) * 0.5 * deltaTime
		local hit = workspace:Raycast(position, nextPosition - position, params)
		if hit then
			if hit.Instance:IsDescendantOf(targetCharacter) then
				projectileHit:FireServer(projectileId, targetCharacter)
			end
			disconnectProjectileConnection(connection)
			return
		end
		position = nextPosition
		velocity = nextVelocity
	end)
	activeProjectileConnections[connection] = true
end

local function fireBow(targetCharacter, targetRoot, bow, config)
	if not bow or not config then
		bow, config = getBow()
	end
	local ownCharacter = player.Character
	if not bow or not config or not ownCharacter then
		return
	end
	if not equipInventoryItem(bow) then
		return
	end
	local selfPosition = ownCharacter:GetPivot().Position
	local origin = selfPosition + Vector3.new(0, 2, 0)
	local velocity = calculatePredictedVelocity(origin, targetCharacter, targetRoot, config.speed)
	local projectileId = generateId(8)
	local launchData = {
		shotId = generateId(8),
		drawDurationSec = config.drawDurationSec,
	}
	task.spawn(function()
		local ok, err = pcall(function()
			local arguments = {
				bow,
				"arrow",
				config.projectile,
				origin,
				selfPosition,
				velocity,
				projectileId,
				launchData,
				workspace:GetServerTimeNow() - 0.045,
			}
			if projectileFire:IsA("RemoteFunction") then
				projectileFire:InvokeServer(unpack(arguments))
			else
				projectileFire:FireServer(unpack(arguments))
			end
		end)
		if not ok then
			warn("ProjectileFire failed:", err)
		end
	end)
	simulateProjectile(projectileId, origin, velocity, targetCharacter, config.lifetime)
end

local lastSwordAttack = 0
local lastBowShot = 0
local lastHighlightRefresh = -math.huge
local lastSprintRefresh = -math.huge
local lastAutoBridge = -math.huge
local lastBedDamage = -math.huge
local lastAntiKnockbackRefresh = -math.huge

local mainHeartbeatConnection = RunService.Heartbeat:Connect(function()
	local now = workspace:GetServerTimeNow()
	if antiKnockbackEnabled
		and now - lastAntiKnockbackRefresh >= ANTI_KNOCKBACK_REFRESH_INTERVAL then
		lastAntiKnockbackRefresh = now
		refreshAntiKnockbackHooks()
	end
	if sprintEnabled and now - lastSprintRefresh >= SPRINT_REFRESH_INTERVAL then
		lastSprintRefresh = now
		startAutoSprint()
	end
	if now - lastHighlightRefresh >= HIGHLIGHT_REFRESH_INTERVAL then
		lastHighlightRefresh = now
		updatePlayerHighlights()
	end
	if bedBreakEnabled and now - lastBedDamage >= BED_BREAK_INTERVAL then
		lastBedDamage = now
		damageNearestBed()
	end

	-- Each enabled feature runs independently. Required items are equipped
	-- immediately before the corresponding action request.
	local swordTarget
	local sword
	if swordEnabled then
		swordTarget = findNearestTarget(SWORD_RANGE)
		if swordTarget then
			sword = getSword()
		end
	end
	if swordTarget and sword then
		if now - lastSwordAttack >= SWORD_ATTACK_INTERVAL then
			lastSwordAttack = now
			sendSwordHit(swordTarget, sword)
		end
	end

	-- Bridge placement has its own interval and does not suppress combat.
	if bridgeEnabled
		and now - lastAutoBridge >= AUTO_BRIDGE_INTERVAL
		and needsBridgePlacement() then
		lastAutoBridge = now
		runAutoBridge()
	end

	if bowEnabled and now - lastBowShot >= BOW_COOLDOWN then
		local target, root = findNearestTarget(bowRange)
		if target and root then
			local bow, config = getBow()
			if bow and config then
				lastBowShot = now
				fireBow(target, root, bow, config)
			end
		end
	end
end)

local Controller = {
	Id = "bedwars-combat",
	Name = "BedWars Combat",
	Version = SCRIPT_VERSION,
	Changed = ChangedBindable.Event,
	MinBowRange = MIN_BOW_RANGE,
	MaxBowRange = MAX_BOW_RANGE
}

local function queueChanged()
	if Destroyed then
		return
	end

	task.defer(function()
		if not Destroyed then
			ChangedBindable:Fire(Controller:GetState())
		end
	end)
end

function Controller:GetState()
	return {
		SwordEnabled = swordEnabled,
		BowEnabled = bowEnabled,
		SprintEnabled = sprintEnabled,
		BridgeEnabled = bridgeEnabled,
		BedBreakEnabled = bedBreakEnabled,
		VisualsEnabled = visualsEnabled,
		AntiKnockbackEnabled = antiKnockbackEnabled,
		AntiVoidEnabled = antiVoidEnabled,
		AntiVoidTeleportCount = antiVoidTeleportCount,
		BowRange = bowRange,
		Destroyed = Destroyed,
		Version = SCRIPT_VERSION
	}
end

local function setBoolean(currentValue, newValue, assign)
	if Destroyed then
		return false, "Controller has been destroyed."
	end

	newValue = newValue == true

	if currentValue ~= newValue then
		assign(newValue)
		queueChanged()
	end

	return true, Controller:GetState()
end

function Controller:SetSwordEnabled(enabled)
	return setBoolean(swordEnabled, enabled, function(value)
		swordEnabled = value
	end)
end

function Controller:SetBowEnabled(enabled)
	return setBoolean(bowEnabled, enabled, function(value)
		bowEnabled = value
	end)
end

function Controller:SetSprintEnabled(enabled)
	return setBoolean(sprintEnabled, enabled, function(value)
		sprintEnabled = value

		if value then
			startAutoSprint()
		else
			stopAutoSprint()
		end
	end)
end

function Controller:SetBridgeEnabled(enabled)
	return setBoolean(bridgeEnabled, enabled, function(value)
		bridgeEnabled = value
	end)
end

function Controller:SetBedBreakEnabled(enabled)
	return setBoolean(bedBreakEnabled, enabled, function(value)
		bedBreakEnabled = value
	end)
end

function Controller:SetVisualsEnabled(enabled)
	return setBoolean(visualsEnabled, enabled, function(value)
		visualsEnabled = value
		updatePlayerHighlights()
	end)
end

function Controller:SetAntiKnockbackEnabled(enabled)
	if Destroyed then
		return false, "Controller has been destroyed."
	end

	enabled = enabled == true

	if enabled and (type(getconnections) ~= "function"
		or type(hookfunction) ~= "function"
		or type(restorefunction) ~= "function") then
		return false, "Anti Knockback is not supported by this executor."
	end

	if antiKnockbackEnabled ~= enabled then
		antiKnockbackEnabled = enabled

		if enabled then
			lastAntiKnockbackRefresh = workspace:GetServerTimeNow()
			refreshAntiKnockbackHooks()
		else
			restoreAntiKnockbackHooks()
		end

		queueChanged()
	end

	return true, self:GetState()
end

function Controller:SetAntiVoidEnabled(enabled)
	return setBoolean(antiVoidEnabled, enabled, function(value)
		antiVoidEnabled = value
		resetAntiVoidState()

		if value then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")

			if root and root:IsA("BasePart") then
				antiVoidLastSafeCFrame = root.CFrame
				antiVoidSafeCandidateCFrame = root.CFrame
				antiVoidSafeCandidateAt = os.clock()
			end
		end
	end)
end

function Controller:SetBowRange(value)
	if Destroyed then
		return false, "Controller has been destroyed."
	end

	value = tonumber(value)

	if not value then
		return false, "Bow range must be a number."
	end

	value = math.round(math.clamp(value, MIN_BOW_RANGE, MAX_BOW_RANGE))

	if bowRange ~= value then
		bowRange = value
		queueChanged()
	end

	return true, self:GetState()
end

function Controller:SetFeature(featureName, enabled)
	local setters = {
		Sword = self.SetSwordEnabled,
		Bow = self.SetBowEnabled,
		Sprint = self.SetSprintEnabled,
		Bridge = self.SetBridgeEnabled,
		BedBreak = self.SetBedBreakEnabled,
		Visuals = self.SetVisualsEnabled,
		AntiKnockback = self.SetAntiKnockbackEnabled,
		AntiVoid = self.SetAntiVoidEnabled
	}

	local setter = setters[tostring(featureName)]

	if not setter then
		return false, "Unknown feature: " .. tostring(featureName)
	end

	return setter(self, enabled)
end

function Controller:Destroy()
	if Destroyed then
		return
	end

	swordEnabled = false
	bowEnabled = false
	sprintEnabled = false
	bridgeEnabled = false
	bedBreakEnabled = false
	visualsEnabled = false
	antiVoidEnabled = false
	antiVoidCharacterGeneration += 1
	restoreAntiKnockbackHooks()

	stopAutoSprint()
	updatePlayerHighlights()

	for _, connection in pairs({
		characterAddedConnection,
		inputBeganConnection,
		inputChangedConnection,
		descendantAddedConnection,
		descendantRemovingConnection,
		antiVoidJumpConnection,
		antiVoidCharacterAddedConnection,
		antiVoidCharacterConnection,
		mainHeartbeatConnection
	}) do
		if connection then
			connection:Disconnect()
		end
	end

	for connection in pairs(activeProjectileConnections) do
		disconnectProjectileConnection(connection)
	end

	if swordAnimationTrack then
		pcall(function()
			swordAnimationTrack:Stop()
		end)
		swordAnimationTrack = nil
	end

	Destroyed = true
	ChangedBindable:Destroy()
end

queueChanged()

return Controller
