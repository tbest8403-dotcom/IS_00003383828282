local function normalizeTeamId(value)
	if value == nil then
		return nil
	end
	return string.lower(tostring(value))
end

local function getLocalTeamIds()
	local ids = {}
	local function add(value)
		local normalized = normalizeTeamId(value)
		if normalized then
			ids[normalized] = true
		end
	end

	add(player:GetAttribute("TeamId"))
	add(player:GetAttribute("Team"))
	add(player.TeamColor.Name)
	add(player.TeamColor.Number)
	local team = player.Team
	if team then
		add(team.Name)
		add(team:GetAttribute("TeamId"))
		add(team:GetAttribute("Id"))
		add(team:GetAttribute("id"))
		add(team.TeamColor.Name)
		add(team.TeamColor.Number)
	end
	return ids
end

local function findNearestEnemyBed()
	local character, root = getLivingCharacter(player)
	if not character or not root then
		return nil
	end
	local ownTeamIds = getLocalTeamIds()
	local nearest
	local nearestDistance = math.huge
	for bed in trackedBeds do
		if bed.Parent then
			local bedTeamId = normalizeTeamId(bed:GetAttribute("TeamId"))
			if bedTeamId and not ownTeamIds[bedTeamId] then
				local distance = (bed.Position - root.Position).Magnitude
				if distance < nearestDistance then
					nearest = bed
					nearestDistance = distance
				end
			end
		end
	end
	return nearest
end

local function getBlockGridPosition(part)
	if blockEngine then
		local ok, position = pcall(function()
			return blockEngine:getBlockPosition(part.Position)
		end)
		if ok and position then
			return position
		end
	end
	local position = part.Position
	return Vector3.new(
		math.round(position.X / 3),
		math.floor(position.Y / 3),
		math.round(position.Z / 3)
	)
end

local activeTunnelBed
local activeTunnelDirection

local function getBedDamageTarget(bed)
	local character, root = getLivingCharacter(player)
	if not character or not root then
		return bed, bed.Position, Vector3.new(0, 1, 0)
	end
	if activeTunnelBed ~= bed or not activeTunnelDirection then
		activeTunnelBed = bed
		local offset = root.Position - bed.Position
		if math.abs(offset.X) >= math.abs(offset.Z) then
			activeTunnelDirection = Vector3.new(offset.X >= 0 and 1 or -1, 0, 0)
		else
			activeTunnelDirection = Vector3.new(0, 0, offset.Z >= 0 and 1 or -1)
		end
	end

	-- Ignore characters and harmless geometry while tracing toward the bed.
	-- The first nearby part carrying the Block attribute becomes the tunnel
	-- target. After it disappears, the next trace advances through the hole.
	local ignored = {}
	for _, candidate in Players:GetPlayers() do
		if candidate.Character then
			table.insert(ignored, candidate.Character)
		end
	end
	local origin = bed.Position + activeTunnelDirection * (BED_DEFENSE_RADIUS + 3)
	for _ = 1, 12 do
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = ignored
		params.IgnoreWater = true
		params.RespectCanCollide = true
		local result = workspace:Raycast(origin, bed.Position - origin, params)
		if not result then
			break
		end
		local hitPart = result.Instance
		if hitPart == bed or hitPart:IsDescendantOf(bed) then
			return bed, result.Position, result.Normal
		end
		if hitPart:IsA("BasePart")
			and hitPart:GetAttribute("Block") ~= nil
			and (hitPart.Position - bed.Position).Magnitude <= BED_DEFENSE_RADIUS then
			return hitPart, result.Position, result.Normal
		end
		table.insert(ignored, hitPart)
	end

	return bed, bed.Position + Vector3.new(0, bed.Size.Y / 2, 0), Vector3.new(0, 1, 0)
end

local bedDamageInFlight = false

local function damageNearestBed()
	if bedDamageInFlight then
		return
	end
	local bed = findNearestEnemyBed()
	if not bed then
		activeTunnelBed = nil
		activeTunnelDirection = nil
		return
	end
	local damageTarget, hitPosition, hitNormal = getBedDamageTarget(bed)
	local blockPosition = getBlockGridPosition(damageTarget)
	bedDamageInFlight = true
	task.spawn(function()
		local ok, err = pcall(function()
			local payload = {
				blockRef = { blockPosition = blockPosition },
				hitPosition = hitPosition,
				hitNormal = hitNormal,
			}
			if damageBlock:IsA("RemoteFunction") then
				damageBlock:InvokeServer(payload)
			else
				damageBlock:FireServer(payload)
			end
		end)
		bedDamageInFlight = false
		if not ok then
			warn("DamageBlock failed:", err)
		end
	end)
end

