local lastSwordAnimation = -math.huge
local swordAnimationTrack

local function playSwordSwingAnimation()
	if not gameAnimationUtil or not animationType then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now - lastSwordAnimation < SWORD_ANIMATION_INTERVAL then
		return
	end
	lastSwordAnimation = now
	local ok, result = pcall(function()
		if swordAnimationTrack then
			swordAnimationTrack:Stop(0)
		end
		return gameAnimationUtil:playAnimation(player, animationType.SWORD_SWING, {
			fadeSamePriorityTracks = false,
		})
	end)
	if ok then
		swordAnimationTrack = result
	else
		warn("Sword swing animation failed:", result)
	end
end

