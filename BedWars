local function getLivingCharacter(targetPlayer)
	local character = targetPlayer.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return nil
	end
	return character, root
end

local function isEnemy(candidate)
	if candidate == player then
		return false
	end
	if player.Team ~= nil and candidate.Team ~= nil then
		return player.Team ~= candidate.Team
	end
	return true
end

local lineOfSightParamsByCharacter = setmetatable({}, {
	__mode = "k"
})

local function hasLineOfSight(ownCharacter, targetCharacter, origin, destination)
	local params = lineOfSightParamsByCharacter[ownCharacter]

	if not params then
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { ownCharacter }
		params.IgnoreWater = true
		lineOfSightParamsByCharacter[ownCharacter] = params
	end

	local result = workspace:Raycast(origin, destination - origin, params)
	return result == nil or result.Instance:IsDescendantOf(targetCharacter)
end

local function findNearestTarget(maximumRange)
	local ownCharacter, ownRoot = getLivingCharacter(player)
	if not ownCharacter then
		return nil
	end
	local nearestCharacter
	local nearestRoot
	local nearestDistance = maximumRange
	for _, candidate in Players:GetPlayers() do
		if isEnemy(candidate) then
			local character, root = getLivingCharacter(candidate)
			if character and not character:FindFirstChildOfClass("ForceField") then
				local distance = (root.Position - ownRoot.Position).Magnitude
				if distance <= nearestDistance
					and hasLineOfSight(ownCharacter, character, ownRoot.Position, root.Position) then
					nearestCharacter = character
					nearestRoot = root
					nearestDistance = distance
				end
			end
		end
	end
	return nearestCharacter, nearestRoot
end

local function updatePlayerHighlights()
	for _, candidate in Players:GetPlayers() do
		if candidate ~= player then
			local character = candidate.Character
			local highlight = character and character:FindFirstChild(HIGHLIGHT_NAME)
			if highlight and not highlight:IsA("Highlight") then
				highlight:Destroy()
				highlight = nil
			end
			local shouldShow = visualsEnabled and isEnemy(candidate)
			if shouldShow and character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				shouldShow = humanoid ~= nil and humanoid.Health > 0
			end

			if shouldShow and character then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = HIGHLIGHT_NAME
					highlight.Parent = character
				end
				highlight.Enabled = true
				highlight.Adornee = character
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillTransparency = 1
				highlight.OutlineTransparency = 0
				highlight.OutlineColor = candidate.TeamColor.Color
			elseif highlight then
				highlight:Destroy()
			end
		end
	end
end

