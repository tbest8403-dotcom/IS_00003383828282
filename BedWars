local function getKnockbackEvent()
	local zapFolder = ReplicatedStorage:FindFirstChild("ZAP")
	return zapFolder and zapFolder:FindFirstChild("ZAP_RELIABLE")
end

local function refreshAntiKnockbackHooks()
	if not antiKnockbackEnabled
		or type(getconnections) ~= "function"
		or type(hookfunction) ~= "function" then
		return 0
	end

	local event = getKnockbackEvent()
	if not event or not event:IsA("RemoteEvent") then
		return 0
	end

	local success, connections = pcall(getconnections, event.OnClientEvent)
	if not success or type(connections) ~= "table" then
		return 0
	end

	local hookedCount = 0
	for _, connection in ipairs(connections) do
		local callbackSuccess, callback = pcall(function()
			return connection.Function
		end)

		if callbackSuccess
			and typeof(callback) == "function"
			and not hookedKnockbackCallbacks[callback] then
			local old
			local hookSuccess = pcall(function()
				old = hookfunction(callback, function(...)
					if antiKnockbackEnabled then
						return nil
					end

					return old(...)
				end)
			end)

			if hookSuccess and typeof(old) == "function" then
				hookedKnockbackCallbacks[callback] = true
				hookedCount += 1
			end
		end
	end

	return hookedCount
end

local function restoreAntiKnockbackHooks()
	antiKnockbackEnabled = false

	for callback in pairs(hookedKnockbackCallbacks) do
		if type(restorefunction) == "function" then
			pcall(restorefunction, callback)
		end

		hookedKnockbackCallbacks[callback] = nil
	end
end

local function castAntiVoidGround(origin, depth, params)
	local result = workspace:Raycast(
		origin + Vector3.new(0, 2, 0),
		Vector3.new(0, -depth, 0),
		params
	)

	if result and result.Normal.Y >= ANTIVOID_MINIMUM_GROUND_NORMAL then
		return result
	end

	return nil
end

local function findAntiVoidGround(root, targetPosition, depth, params)
	local centerGround = castAntiVoidGround(targetPosition, depth, params)
	if centerGround then
		return centerGround
	end

	local right = Vector3.new(root.CFrame.RightVector.X, 0, root.CFrame.RightVector.Z)
	local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)

	right = right.Magnitude > 0.01 and right.Unit or Vector3.new(1, 0, 0)
	forward = forward.Magnitude > 0.01 and forward.Unit or Vector3.new(0, 0, -1)

	return castAntiVoidGround(
		targetPosition + right * ANTIVOID_FOOTPRINT_SIDE_OFFSET,
		depth,
		params
	) or castAntiVoidGround(
		targetPosition - right * ANTIVOID_FOOTPRINT_SIDE_OFFSET,
		depth,
		params
	) or castAntiVoidGround(
		targetPosition + forward * ANTIVOID_FOOTPRINT_FRONT_OFFSET,
		depth,
		params
	) or castAntiVoidGround(
		targetPosition - forward * ANTIVOID_FOOTPRINT_FRONT_OFFSET,
		depth,
		params
	)
end

local function teleportToAntiVoidSafePosition(root)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	if antiVoidLastSafeCFrame then
		root.CFrame = antiVoidLastSafeCFrame
			+ Vector3.new(0, ANTIVOID_TELEPORT_HEIGHT_OFFSET, 0)
	end
end

local function resetAntiVoidState()
	antiVoidAirborneTime = 0
	antiVoidUnsupportedFallTime = 0
	antiVoidRaycastAccumulator = ANTIVOID_RAYCAST_INTERVAL
	antiVoidEdgeBlocked = false
	antiVoidJumpGraceUntil = 0
end

local function connectAntiVoidCharacter(character)
	antiVoidCharacterGeneration += 1
	local generation = antiVoidCharacterGeneration

	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")

	if Destroyed
		or generation ~= antiVoidCharacterGeneration
		or character ~= player.Character
		or not humanoid:IsA("Humanoid")
		or not root:IsA("BasePart") then
		return
	end

	if antiVoidCharacterConnection then
		antiVoidCharacterConnection:Disconnect()
		antiVoidCharacterConnection = nil
	end

	antiVoidLastSafeCFrame = root.CFrame
	antiVoidSafeCandidateCFrame = root.CFrame
	antiVoidSafeCandidateAt = os.clock()
	resetAntiVoidState()

	local antiVoidRaycastParams = RaycastParams.new()
	antiVoidRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
	antiVoidRaycastParams.FilterDescendantsInstances = { character }
	antiVoidRaycastParams.IgnoreWater = false
	antiVoidRaycastParams.RespectCanCollide = true

	antiVoidCharacterConnection = RunService.PreSimulation:Connect(function(deltaTime)
		if character ~= player.Character or humanoid.Health <= 0 or not antiVoidEnabled then
			return
		end

		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air

		if grounded then
			antiVoidAirborneTime = 0
			antiVoidUnsupportedFallTime = 0
			antiVoidRaycastAccumulator = ANTIVOID_RAYCAST_INTERVAL
			antiVoidEdgeBlocked = false

			local now = os.clock()
			if not antiVoidSafeCandidateCFrame then
				antiVoidSafeCandidateCFrame = root.CFrame
				antiVoidSafeCandidateAt = now
			elseif now - antiVoidSafeCandidateAt >= ANTIVOID_SAFE_POSITION_DELAY then
				antiVoidLastSafeCFrame = antiVoidSafeCandidateCFrame
				antiVoidSafeCandidateCFrame = root.CFrame
				antiVoidSafeCandidateAt = now
			end
			return
		end

		antiVoidAirborneTime += deltaTime

		local velocity = root.AssemblyLinearVelocity
		local jumpProtected = os.clock() < antiVoidJumpGraceUntil
		local nearDestroyHeight =
			root.Position.Y < workspace.FallenPartsDestroyHeight + 100

		-- Ascending jumps do not need a ground query, unless the character is
		-- already dangerously close to the destroy height.
		if velocity.Y > 0 and not nearDestroyHeight then
			antiVoidUnsupportedFallTime = 0
			antiVoidRaycastAccumulator = ANTIVOID_RAYCAST_INTERVAL
			return
		end

		if velocity.Y <= 0 then
			antiVoidUnsupportedFallTime += deltaTime
		else
			antiVoidUnsupportedFallTime = 0
		end

		antiVoidRaycastAccumulator += deltaTime
		if antiVoidRaycastAccumulator < ANTIVOID_RAYCAST_INTERVAL
			and not nearDestroyHeight then
			return
		end
		antiVoidRaycastAccumulator = 0

		local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
		local predictedPosition =
			root.Position + horizontalVelocity * ANTIVOID_LANDING_PREDICTION_TIME

		local predictedGround = findAntiVoidGround(
			root,
			predictedPosition,
			ANTIVOID_LANDING_DEPTH,
			antiVoidRaycastParams
		)

		if predictedGround then
			antiVoidEdgeBlocked = false
			antiVoidUnsupportedFallTime = 0
			return
		end

		local falling = velocity.Y <= 0

		local shouldTeleport =
			(falling
				and antiVoidAirborneTime >= ANTIVOID_AIR_RECOVERY_DELAY
				and (not jumpProtected
					or antiVoidUnsupportedFallTime >= ANTIVOID_UNSUPPORTED_FALL_LIMIT))
			or nearDestroyHeight

		if shouldTeleport and antiVoidLastSafeCFrame then
			if not antiVoidEdgeBlocked then
				antiVoidEdgeBlocked = true
				antiVoidTeleportCount += 1
			end

			teleportToAntiVoidSafePosition(root)
			antiVoidAirborneTime = 0
			antiVoidUnsupportedFallTime = 0
			antiVoidJumpGraceUntil = 0
			antiVoidSafeCandidateCFrame = antiVoidLastSafeCFrame
			antiVoidSafeCandidateAt = os.clock()
		end
	end)
end

local antiVoidJumpConnection = UserInputService.JumpRequest:Connect(function()
