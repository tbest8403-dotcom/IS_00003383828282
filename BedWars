local function getCurrentHandTool()
	local state = getInventoryState()
	if not state then
		return false, nil
	end
	return true, state.hand and state.hand.tool or nil
end

local function getUsableInventoryTool(itemType)
	local state = getInventoryState()
	if state and state.items then
		for _, itemInfo in ipairs(state.items) do
			local amount = itemInfo.amount
			if itemInfo.itemType == itemType
				and itemInfo.tool
				and (type(amount) ~= "number" or amount > 0) then
				return itemInfo.tool
			end
		end
	end
	local inventory = getInventory()
	local tool = inventory and inventory:FindFirstChild(itemType)
	if tool then
		local amount = tool:GetAttribute("Amount")
		if type(amount) ~= "number" or amount > 0 then
			return tool
		end
	end
	return nil
end

local function getSword()
	local priority = { "emerald_sword", "diamond_sword", "iron_sword", "stone_sword", "wood_sword" }
	for _, name in priority do
		local sword = getUsableInventoryTool(name)
		if sword then
			return sword
		end
	end
	return nil
end

local lastEquippedItem
local lastEquipRequestTime = -math.huge

local function equipInventoryItem(item)
	if not item then
		return false
	end
	local now = workspace:GetServerTimeNow()
	local handKnown, currentHandTool = getCurrentHandTool()
	if handKnown and currentHandTool == item then
		lastEquippedItem = item
		lastEquipRequestTime = now
		return true
	end
	if lastEquippedItem == item and now - lastEquipRequestTime < EQUIP_REFRESH_INTERVAL then
		return true
	end
	lastEquippedItem = item
	lastEquipRequestTime = now
	local ok, result = pcall(function()
		local payload = { hand = item }
		if setInvItem:IsA("RemoteFunction") then
			return setInvItem:InvokeServer(payload)
		end
		setInvItem:FireServer(payload)
		return true
	end)
	if not ok then
		warn("SetInvItem failed:", result)
		if lastEquippedItem == item then
			lastEquippedItem = nil
			lastEquipRequestTime = -math.huge
		end
		return false
	end
	return true
end

local function invalidateEquipCache()
	lastEquippedItem = nil
	lastEquipRequestTime = -math.huge
end

