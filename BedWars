local function getBridgeBlock(blockPlacementController)
	local state = getInventoryState()
	if state and state.items then
		-- InventoryUtil supplies the authoritative tool and amount. Prefer any
		-- nonempty team-colored wool stack.
		for _, itemInfo in ipairs(state.items) do
			local amount = itemInfo.amount
			if itemInfo.tool
				and (type(amount) ~= "number" or amount > 0)
				and string.find(string.lower(itemInfo.itemType), "wool", 1, true) then
				return itemInfo.tool
			end
		end

		if blockPlacementController then
			for _, itemInfo in ipairs(state.items) do
				local amount = itemInfo.amount
				if itemInfo.tool and (type(amount) ~= "number" or amount > 0) then
					local ok, placedBlockType = pcall(function()
						return blockPlacementController:getPlacedItemType(itemInfo.itemType)
					end)
					if ok and placedBlockType then
						return itemInfo.tool
					end
				end
			end
		end
	end

	-- Fallback for the short period before InventoryUtil has an entity state.
	local inventory = getInventory()
	if not inventory then
		return nil
	end
	local fallback
	for _, item in inventory:GetChildren() do
		local amount = item:GetAttribute("Amount")
		if type(amount) ~= "number" or amount > 0 then
			if string.find(string.lower(item.Name), "wool", 1, true) then
				return item
			end
			if blockPlacementController then
				local ok, placedBlockType = pcall(function()
					return blockPlacementController:getPlacedItemType(item.Name)
				end)
				if ok and placedBlockType then
					fallback = fallback or item
				end
			end
		end
	end
	return fallback
end

local function needsBridgePlacement()
	local character, root = getLivingCharacter(player)
	if not character or not root then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return false
	end
	local direction = humanoid.MoveDirection * Vector3.new(1, 0, 1)
	if direction.Magnitude < 0.05 then
		return false
	end
	direction = direction.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	params.RespectCanCollide = true
	local probeOrigin = root.Position + direction * BRIDGE_PROBE_DISTANCE
	local support = workspace:Raycast(probeOrigin, Vector3.new(0, -BRIDGE_PROBE_DEPTH, 0), params)
	return support == nil
end

local function runAutoBridge()
	local blockPlacementController = getBlockPlacementController()
	local blockItem = getBridgeBlock(blockPlacementController)
	if not blockItem then
		if not bridgeBlockWarningShown then
			bridgeBlockWarningShown = true
			warn("Auto Bridge could not find a placeable block in the inventory")
		end
		return false
	end
	bridgeBlockWarningShown = false
	if not equipInventoryItem(blockItem) then
		return false
	end
	if not blockPlacementController then
		return false
	end

	local ok, result = pcall(function()
		local blockPlacer = blockPlacementController:getBlockPlacer()
		local placedBlockType = blockPlacementController:getPlacedItemType(blockItem.Name)
		if not placedBlockType then
			return false
		end

		-- SetInvItem updates the replicated hand, but command-bar equip requests
		-- do not always run HandKnitController's local onEnable callback. Create
		-- the same placer state that a manual hotbar equip would create.
		if not blockPlacer or blockPlacer:getBlockType() ~= placedBlockType then
			blockPlacementController:onEnable({
				itemType = blockItem.Name,
			})
			blockPlacer = blockPlacementController:getBlockPlacer()
		end
		if not blockPlacer then
			return false
		end
		blockPlacer:autoBridge(true)
		return true
	end)
	if not ok then
		warn("Auto Bridge placement failed:", result)
		return false
	end
	return result
end

