--==================================================
-- STOP
--==================================================

local function StopPlayback()
	Playing = false

	PlaySession += 1

	ReleaseEverything()

	SetStatus(
		"Stopped."
	)
end

--==================================================
-- PLAY
--==================================================

local function StartPlayback()
	if typeof(keypress) ~= "function"
		or typeof(keyrelease) ~= "function" then

		SetStatus(
			"keypress/keyrelease unavailable."
		)

		return
	end

	-- Blank tempo = default.
	if TempoBox.Text == "" then
		CurrentTempo =
			DEFAULT_TEMPO
	else
		local EnteredTempo =
			tonumber(
				TempoBox.Text
			)

		if EnteredTempo then
			CurrentTempo =
				math.clamp(
					EnteredTempo,
					MIN_TEMPO,
					MAX_TEMPO
				)
		else
			CurrentTempo =
				DEFAULT_TEMPO
		end
	end

	local Events =
		ParseSheet(
			NotesBox.Text
		)

	if #Events == 0 then
		SetStatus(
			"No playable notes found."
		)

		return
	end

	-- Restart cleanly if already playing.
	if Playing then
		Playing = false

		PlaySession += 1

		ReleaseEverything()

		task.wait()
	end

	Playing = true

	PlaySession += 1

	local Session =
		PlaySession

	SetStatus(
		string.format(
			"Starting in 1 second • %d BPM • %.2fx",
			math.floor(
				CurrentTempo + 0.5
			),
			SpeedMultiplier
		)
	)

	task.spawn(function()
		-- Give time to focus Roblox.
		task.wait(1)

		if not Playing
			or Session ~= PlaySession then

			return
		end

		for Index, Event in ipairs(Events) do
			if not Playing
				or Session ~= PlaySession then

				break
			end

			SetStatus(
				string.format(
					"Playing %d/%d • %d BPM • %.2fx",
					Index,
					#Events,

					math.floor(
						CurrentTempo + 0.5
					),

					SpeedMultiplier
				)
			)

			--======================================
			-- NOTE
			--======================================

			if Event.Type == "Note" then
				local Success =
					PlaySingle(
						Event.Key,
						Session
					)

				if not Success then
					break
				end

				if not DynamicWait(
					1 - HOLD_PORTION,
					Session
				) then
					break
				end

			--======================================
			-- CHORD
			--======================================

			elseif Event.Type == "Chord" then
				local Success =
					PlayChord(
						Event.Keys,
						Session
					)

				if not Success then
					break
				end

				if not DynamicWait(
					1 - HOLD_PORTION,
					Session
				) then
					break
				end

			--======================================
			-- REST
			--======================================

			elseif Event.Type == "Rest" then
				if not DynamicWait(
					Event.Steps,
					Session
				) then

					break
				end
			end
		end

		if Session == PlaySession then
			Playing = false

			ReleaseEverything()

			SetStatus(
				"Finished."
			)
		end
	end)
end

