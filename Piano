--==================================================
-- LIVE TEMPO INPUT
--==================================================

local function UpdateTempoFromBox()
	local Text = TempoBox.Text

	if Text == "" then
		CurrentTempo =
			DEFAULT_TEMPO

		TempoStatus.Text =
			"Using default: "
			.. DEFAULT_TEMPO

		return
	end

	local Number =
		tonumber(Text)

	if not Number then
		return
	end

	CurrentTempo =
		math.clamp(
			Number,
			MIN_TEMPO,
			MAX_TEMPO
		)

	TempoStatus.Text =
		string.format(
			"Live: %d BPM",
			math.floor(CurrentTempo + 0.5)
		)
end

TempoBox:GetPropertyChangedSignal(
	"Text"
):Connect(
	UpdateTempoFromBox
)

TempoBox.FocusLost:Connect(function()
	if TempoBox.Text == "" then
		CurrentTempo =
			DEFAULT_TEMPO

		TempoStatus.Text =
			"Using default: "
			.. DEFAULT_TEMPO

		return
	end

	local Number =
		tonumber(
			TempoBox.Text
		)

	if not Number then
		CurrentTempo =
			DEFAULT_TEMPO

		TempoBox.Text =
			tostring(
				DEFAULT_TEMPO
			)

		return
	end

	CurrentTempo =
		math.clamp(
			Number,
			MIN_TEMPO,
			MAX_TEMPO
		)

	TempoBox.Text =
		tostring(
			math.floor(
				CurrentTempo
				+ 0.5
			)
		)
end)

