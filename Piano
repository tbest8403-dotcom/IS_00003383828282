--==================================================
-- SPEED DRAG
--==================================================

local SliderDragging = false

local function SetSpeedFromX(X)
	if Slider.AbsoluteSize.X <= 0 then
		return
	end

	local Alpha =
		math.clamp(
			(
				X
				- Slider.AbsolutePosition.X
			)
			/ Slider.AbsoluteSize.X,
			0,
			1
		)

	SpeedMultiplier =
		MIN_SPEED
		+ (
			MAX_SPEED
			- MIN_SPEED
		)
		* Alpha

