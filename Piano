--==================================================
-- KEY INFO
--==================================================

local function GetKeyInfo(Character)
	if not Character or Character == "" then
		return nil
	end

	-- Uppercase letter = Shift + letter
	if Character:match("%u") then
		local Code = NormalKeys[Character]

		if Code then
			return {
				Code = Code,
				Shift = true,
				Raw = Character
			}
		end
	end

	-- Lowercase letter
	if Character:match("%l") then
		local Code = NormalKeys[string.upper(Character)]

		if Code then
			return {
				Code = Code,
				Shift = false,
				Raw = Character
			}
		end
	end

	-- Shifted symbols
	local ShiftedCode = ShiftedSymbols[Character]

	if ShiftedCode then
		return {
			Code = ShiftedCode,
			Shift = true,
			Raw = Character
		}
	end

	-- Normal numbers / punctuation
	local Code = NormalKeys[Character]

	if Code then
		return {
			Code = Code,
			Shift = false,
			Raw = Character
		}
	end

	return nil
end

--==================================================
-- INPUT
--==================================================

local function Press(Code)
	pcall(function()
		keypress(Code)
	end)
end

local function Release(Code)
	pcall(function()
		keyrelease(Code)
	end)
end

local function ReleaseEverything()
	Release(SHIFT)

	local Released = {}

	for _, Code in pairs(NormalKeys) do
		if not Released[Code] then
			Released[Code] = true
			Release(Code)
		end
	end

	for _, Code in pairs(ShiftedSymbols) do
		if not Released[Code] then
			Released[Code] = true
			Release(Code)
		end
	end
end

--==================================================
-- LIVE TEMPO / SPEED WAIT
--==================================================

local function GetSecondsPerStep()
	local Tempo = math.clamp(
		CurrentTempo,
		MIN_TEMPO,
		MAX_TEMPO
	)

	return (60 / Tempo) / STEPS_PER_BEAT
end

local function DynamicWait(Steps, Session)
	local Progress = 0

	while Progress < Steps do
		if not Playing or Session ~= PlaySession then
			return false
		end

		local DeltaTime = RunService.Heartbeat:Wait()

		local SecondsPerStep =
			GetSecondsPerStep()

		-- Both Tempo and SpeedMultiplier are read
		-- every frame, so BOTH update live.
		Progress +=
			DeltaTime
			* SpeedMultiplier
			/ SecondsPerStep
	end

	return true
end

--==================================================
-- SINGLE NOTE
--==================================================

local function PlaySingle(Info, Session)
	if not Info then
		return false
	end

	if Info.Shift then
		Press(SHIFT)
	end

	Press(Info.Code)

	local Success =
		DynamicWait(
			HOLD_PORTION,
			Session
		)

	Release(Info.Code)

	if Info.Shift then
		Release(SHIFT)
	end

	return Success
end

--==================================================
-- CHORD
--==================================================

local function PlayChord(Keys, Session)
	local Normal = {}
	local Shifted = {}

	for _, Info in ipairs(Keys) do
		if Info.Shift then
			table.insert(
				Shifted,
				Info
			)
		else
			table.insert(
				Normal,
				Info
			)
		end
	end

	-- Normal keys first.
	-- Example:
	-- [6G]
	--
	-- This prevents the 6 from becoming ^.

	for _, Info in ipairs(Normal) do
		Press(Info.Code)
	end

	if #Shifted > 0 then
		Press(SHIFT)

		for _, Info in ipairs(Shifted) do
			Press(Info.Code)
		end
	end

	local Success =
		DynamicWait(
			HOLD_PORTION,
			Session
		)

	for Index = #Shifted, 1, -1 do
		Release(
			Shifted[Index].Code
		)
	end

	if #Shifted > 0 then
		Release(SHIFT)
	end

	for Index = #Normal, 1, -1 do
		Release(
			Normal[Index].Code
		)
	end

	return Success
end

--==================================================
-- SHEET PARSER
--==================================================

local function ParseSheet(Text)
	local Events = {}

	local Index = 1

	while Index <= #Text do
		local Character =
			Text:sub(
				Index,
				Index
			)

		--==========================================
		-- [CHORD]
		--==========================================

		if Character == "[" then
			local Close =
				Text:find(
					"]",
					Index + 1,
					true
				)

			if Close then
				local Contents =
					Text:sub(
						Index + 1,
						Close - 1
					)

				local Keys = {}

				for Position = 1, #Contents do
					local ChordCharacter =
						Contents:sub(
							Position,
							Position
						)

					local Info =
						GetKeyInfo(
							ChordCharacter
						)

					if Info then
						table.insert(
							Keys,
							Info
						)
					end
				end

				if #Keys > 0 then
					table.insert(
						Events,
						{
							Type = "Chord",
							Keys = Keys,
							Raw = Contents
						}
					)
				end

				Index = Close + 1
			else
				Index += 1
			end

		--==========================================
		-- - = EXTRA REST
		--==========================================

		elseif Character == "-" then
			table.insert(
				Events,
				{
					Type = "Rest",
					Steps = 1
				}
			)

			Index += 1

		--==========================================
		-- SPACE = SMALL RHYTHM GAP
		--==========================================

		elseif Character == " " then
			table.insert(
				Events,
				{
					Type = "Rest",
					Steps = 0.35
				}
			)

			Index += 1

		--==========================================
		-- NEW LINE
		--==========================================

		elseif Character == "\n" then
			table.insert(
				Events,
				{
					Type = "Rest",
					Steps = 0.5
				}
			)

			Index += 1

		elseif Character == "\r"
			or Character == "\t" then

			Index += 1

		--==========================================
		-- NORMAL NOTE
		--==========================================

		else
			local Info =
				GetKeyInfo(
					Character
				)

			if Info then
				table.insert(
					Events,
					{
						Type = "Note",
						Key = Info,
						Raw = Character
					}
				)
			end

			Index += 1
		end
	end

	return Events
end

