local function SetAutoGrabGunState(Enabled)
	AutoGrabGunEnabled = Enabled == true
	AutoGrabGunAccumulator = 0
	AutoGrabUnavailableNotified = false

	if AutoGrabGunEnabled and type(firetouchinterest) ~= "function" then
		AutoGrabGunEnabled = false

		if AutoGrabGunControl and AutoGrabGunControl:Get() then
			AutoGrabGunControl:Set(false, true, true)
		end

		Window:Notify({ Title = "Auto Grab Gun", Content = "firetouchinterest is unavailable", Type = "Error" })
		SetStatus("Auto Grab Gun is unavailable")
		return
	end

	if not AutoGrabGunEnabled then
		CachedGunDrop = nil
	end

	SetStatus(AutoGrabGunEnabled and "Auto Grab Gun is waiting for GunDrop" or "Auto Grab Gun disabled")
end

local function TryAutoGrabGun()
	if not AutoGrabGunEnabled or AutoGrabGunBusy then
		return
	end

	if not CachedGunDrop or not CachedGunDrop.Parent or not CachedGunDrop:IsDescendantOf(workspace) then
		local Candidate = workspace:FindFirstChild("GunDrop", true)
		CachedGunDrop = Candidate and Candidate:IsA("BasePart") and Candidate or nil
	end

	local GunDrop = CachedGunDrop
	if not GunDrop then
		return
	end

	local TouchInterest = GunDrop:FindFirstChildOfClass("TouchTransmitter") or GunDrop:FindFirstChild("TouchInterest")
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")
	local TouchPart = Character and (
		Character:FindFirstChild("Head")
		or Character:FindFirstChild("UpperTorso")
		or Character:FindFirstChild("Torso")
		or Character:FindFirstChild("LowerTorso")
		or Root
	)

	if not TouchInterest or not Humanoid or Humanoid.Health <= 0 or not Root or not TouchPart or not TouchPart:IsA("BasePart") then
		return
	end

	AutoGrabGunBusy = true
	task.spawn(function()
		if MurdererShotBusy or MurderAllBusy or (SpectatorEnabled and SpectatorActionBusy) then
			AutoGrabGunBusy = false
			return
		end

		local OriginalCanTouch = TouchPart.CanTouch
		local OriginalCanQuery = TouchPart.CanQuery

		local function FireTouch(State)
			TouchPart.CanTouch = true
			TouchPart.CanQuery = true
			firetouchinterest(TouchPart, GunDrop, State)
			TouchPart.CanTouch = OriginalCanTouch
			TouchPart.CanQuery = OriginalCanQuery
		end

		local Success, ErrorMessage = pcall(function()
			FireTouch(0)
			task.wait(TargetingSettings.AutoGrabTouchDuration)
			FireTouch(1)
		end)

		if TouchPart.Parent then
			TouchPart.CanTouch = OriginalCanTouch
			TouchPart.CanQuery = OriginalCanQuery
		end

		if SpectatorEnabled and SpectatorClone and SpectatorClone.Parent then
			for _, Part in ipairs(SpectatorRealParts) do
				if Part and Part.Parent then
					Part.CanCollide = false
					Part.CanTouch = false
					Part.CanQuery = false
					Part.LocalTransparencyModifier = 1
				end
			end

			CurrentCamera = workspace.CurrentCamera or CurrentCamera

			if SpectatorCloneHumanoid and SpectatorCloneHumanoid.Parent then
				CurrentCamera.CameraType = Enum.CameraType.Custom
				CurrentCamera.CameraSubject = SpectatorCloneHumanoid
			end
		end

		AutoGrabGunBusy = false

		if Success then
			AutoGrabUnavailableNotified = false
			SetStatus("Touched GunDrop")
		elseif not AutoGrabUnavailableNotified then
			AutoGrabUnavailableNotified = true
			Window:Notify({ Title = "Auto Grab Gun", Content = tostring(ErrorMessage or "Could not touch GunDrop"), Type = "Error" })
		end
	end)
end

local function FindSpectatorAnimation(Character, StateName)
	local Animate = Character and Character:FindFirstChild("Animate")
	if not Animate then
		return nil
	end

	local LowerName = string.lower(StateName)

	for _, Child in ipairs(Animate:GetChildren()) do
		if string.lower(Child.Name) == LowerName then
			return Child:FindFirstChildWhichIsA("Animation", true)
		end
	end

	for _, Descendant in ipairs(Animate:GetDescendants()) do
		if Descendant:IsA("Animation") and string.find(string.lower(Descendant.Name), LowerName, 1, true) then
			return Descendant
		end
	end

	return nil
end

local function StopSpectatorAnimations()
	for _, TrackObject in pairs(SpectatorAnimationTracks) do
		if TrackObject then
			pcall(function()
				TrackObject:Stop(0.1)
			end)
		end
	end

	table.clear(SpectatorAnimationTracks)
	SpectatorAnimationName = nil
end

local function LoadSpectatorAnimations(RealCharacter, CloneHumanoid)
	StopSpectatorAnimations()

	local Animator = CloneHumanoid:FindFirstChildOfClass("Animator")
	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = CloneHumanoid
	end

	local Configurations = {
		Idle = { Source = "idle", Looped = true, Priority = Enum.AnimationPriority.Idle },
		Walk = { Source = "walk", Looped = true, Priority = Enum.AnimationPriority.Movement },
		Run = { Source = "run", Looped = true, Priority = Enum.AnimationPriority.Movement },
		Jump = { Source = "jump", Looped = false, Priority = Enum.AnimationPriority.Action },
		Fall = { Source = "fall", Looped = true, Priority = Enum.AnimationPriority.Movement }
	}

	for Name, Configuration in pairs(Configurations) do
		local Animation = FindSpectatorAnimation(RealCharacter, Configuration.Source)

		if Animation and Animation.AnimationId ~= "" then
			local Success, TrackObject = pcall(function()
				return Animator:LoadAnimation(Animation)
			end)

			if Success and TrackObject then
				TrackObject.Looped = Configuration.Looped
				TrackObject.Priority = Configuration.Priority
				SpectatorAnimationTracks[Name] = TrackObject
			end
		end
	end
end

local function UpdateSpectatorAnimation(HorizontalSpeed, VerticalDirection)
	local DesiredName

	if VerticalDirection > 0.05 and SpectatorAnimationTracks.Jump then
		DesiredName = "Jump"
	elseif VerticalDirection < -0.05 and SpectatorAnimationTracks.Fall then
		DesiredName = "Fall"
	elseif HorizontalSpeed > 0.05 then
		DesiredName = SpectatorAnimationTracks.Walk and "Walk" or "Run"
	else
		DesiredName = "Idle"
	end

	local DesiredTrack = DesiredName and SpectatorAnimationTracks[DesiredName]
	if not DesiredTrack then
		return
	end

	if SpectatorAnimationName ~= DesiredName then
		for Name, TrackObject in pairs(SpectatorAnimationTracks) do
			if Name ~= DesiredName and TrackObject.IsPlaying then
				TrackObject:Stop(0.12)
			end
		end

		SpectatorAnimationName = DesiredName
		DesiredTrack:Play(0.12)
	elseif not DesiredTrack.IsPlaying then
		DesiredTrack:Play(0.12)
	end

	if DesiredName == "Walk" or DesiredName == "Run" then
		DesiredTrack:AdjustSpeed(math.clamp(SpectatorMoveSpeed / 16, 0.5, 2.5))
	else
		DesiredTrack:AdjustSpeed(1)
	end
end

local function ClearCharacterVelocity(Character)
	if not Character then
		return
	end

	for _, Descendant in ipairs(Character:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			Descendant.AssemblyLinearVelocity = Vector3.zero
			Descendant.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function DisconnectSpectatorPartTracking()
	if SpectatorDescendantAddedConnection then
		SpectatorDescendantAddedConnection:Disconnect()
		SpectatorDescendantAddedConnection = nil
	end

	if SpectatorDescendantRemovingConnection then
		SpectatorDescendantRemovingConnection:Disconnect()
		SpectatorDescendantRemovingConnection = nil
	end
end

local function TrackSpectatorPart(Part)
	if not Part:IsA("BasePart") or SpectatorPartStates[Part] then
		return
	end

	SpectatorPartStates[Part] = {
		CanCollide = Part.CanCollide,
		CanTouch = Part.CanTouch,
		CanQuery = Part.CanQuery,
		LocalTransparencyModifier = Part.LocalTransparencyModifier
	}
	SpectatorRealParts[#SpectatorRealParts + 1] = Part
	Part.CanCollide = false
	Part.CanTouch = false
	Part.CanQuery = false
	Part.LocalTransparencyModifier = 1
end

local function IsWaterSound(Instance)
	if not Instance:IsA("Sound") then
		return false
	end

	local Name = string.lower(Instance.Name)
	return Name == "swimming" or Name == "splash" or string.find(Name, "water", 1, true) ~= nil
end

local function TrackSpectatorWaterSound(Sound)
	if not IsWaterSound(Sound) or SpectatorWaterSoundStates[Sound] then
		return
	end

	SpectatorWaterSoundStates[Sound] = Sound.Volume
	Sound:Stop()
	Sound.Volume = 0
end

local function UntrackSpectatorWaterSound(Sound)
	local OriginalVolume = SpectatorWaterSoundStates[Sound]

	if OriginalVolume ~= nil and Sound.Parent then
		Sound.Volume = OriginalVolume
	end

	SpectatorWaterSoundStates[Sound] = nil
end

local function TrackSpectatorDescendant(Descendant)
	TrackSpectatorPart(Descendant)
	TrackSpectatorWaterSound(Descendant)
end

local function UntrackSpectatorPart(Part)
	local State = SpectatorPartStates[Part]

	if State and Part.Parent then
		Part.CanCollide = State.CanCollide
		Part.CanTouch = State.CanTouch
		Part.CanQuery = State.CanQuery
		Part.LocalTransparencyModifier = State.LocalTransparencyModifier
	end

	SpectatorPartStates[Part] = nil

	for Index = #SpectatorRealParts, 1, -1 do
		if SpectatorRealParts[Index] == Part then
			table.remove(SpectatorRealParts, Index)
			break
		end
	end
end

local function UntrackSpectatorDescendant(Descendant)
	UntrackSpectatorPart(Descendant)
	UntrackSpectatorWaterSound(Descendant)
end

local function SuppressSpectatorWater()
	if SpectatorRealHumanoid and SpectatorRealHumanoid.Parent then
		SpectatorRealHumanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)

		if SpectatorRealHumanoid:GetState() == Enum.HumanoidStateType.Swimming then
			SpectatorRealHumanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end

	for Sound in pairs(SpectatorWaterSoundStates) do
		if Sound and Sound.Parent then
			Sound:Stop()
			Sound.Volume = 0
		else
			SpectatorWaterSoundStates[Sound] = nil
		end
	end
end

local function RestoreSpectatorWaterSounds()
	for Sound, OriginalVolume in pairs(SpectatorWaterSoundStates) do
		if Sound and Sound.Parent then
			Sound.Volume = OriginalVolume
		end
	end

	table.clear(SpectatorWaterSoundStates)
end

local function RestoreSpectatorPartStates()
	DisconnectSpectatorPartTracking()

	for Part, State in pairs(SpectatorPartStates) do
		if Part and Part.Parent then
			Part.CanCollide = State.CanCollide
			Part.CanTouch = State.CanTouch
			Part.CanQuery = State.CanQuery
			Part.LocalTransparencyModifier = State.LocalTransparencyModifier
		end
	end

	table.clear(SpectatorPartStates)
	table.clear(SpectatorRealParts)
end

MoveRealCharacterBelowPreview = function(PreviewCFrame)
	if not SpectatorRealCharacter
		or not SpectatorRealCharacter.Parent
		or not SpectatorRealRoot
		or not SpectatorRealRoot.Parent then
		return
	end

	for Index = #SpectatorRealParts, 1, -1 do
		local Part = SpectatorRealParts[Index]

		if Part and Part.Parent then
			Part.CanCollide = false
			Part.CanTouch = false
			Part.CanQuery = false
			Part.LocalTransparencyModifier = 1
			Part.AssemblyLinearVelocity = Vector3.zero
			Part.AssemblyAngularVelocity = Vector3.zero
		else
			SpectatorPartStates[Part] = nil
			table.remove(SpectatorRealParts, Index)
		end
	end

	if SpectatorActionBusy or not PreviewCFrame then
		return
	end

	local BelowCFrame = CFrame.new(PreviewCFrame.Position - Vector3.new(0, SpectatorDepth, 0)) * PreviewCFrame.Rotation
	SpectatorRealCharacter:PivotTo(BelowCFrame)
	SpectatorRealRoot.CFrame = BelowCFrame
	SpectatorRealRoot.AssemblyLinearVelocity = Vector3.zero
	SpectatorRealRoot.AssemblyAngularVelocity = Vector3.zero
	SuppressSpectatorWater()
end

BeginPreviewSyncedAction = function(Character)
	if not SpectatorEnabled
		or not SpectatorClone
		or not SpectatorClone.Parent
		or not Character
		or not Character.Parent then
		return nil
	end

	if SpectatorActionBusy then
		return nil
	end

	local PreviewCFrame = SpectatorClone:GetPivot()
	SpectatorActionBusy = true
	Character:PivotTo(PreviewCFrame)
	ClearCharacterVelocity(Character)

	return PreviewCFrame
end

FinishPreviewSyncedAction = function(Character, PreviewCFrame)
	if not PreviewCFrame then
		return false
	end

	SpectatorActionBusy = false

	if Character and Character.Parent then
		ClearCharacterVelocity(Character)

		if SpectatorEnabled and SpectatorClone and SpectatorClone.Parent then
			MoveRealCharacterBelowPreview(SpectatorClone:GetPivot())
		else
			Character:PivotTo(PreviewCFrame)
			ClearCharacterVelocity(Character)
		end
	end

	return true
end

DisableSpectator = function()
	if not SpectatorEnabled then
		return
	end

	local Clone = SpectatorClone
	local RealCharacter = SpectatorRealCharacter
	local FinalCFrame = Clone and Clone.Parent and Clone:GetPivot() or nil
	SpectatorEnabled = false
	SpectatorActionBusy = false
	RunService:UnbindFromRenderStep(SpectatorRenderBindingName)
	RunService:UnbindFromRenderStep(SpectatorFinalBindingName)

	if RealCharacter and RealCharacter.Parent then
		ClearCharacterVelocity(RealCharacter)

		if FinalCFrame then
			RealCharacter:PivotTo(FinalCFrame)
		end

		ClearCharacterVelocity(RealCharacter)
	end

	if SpectatorOriginalSwimmingEnabled ~= nil and SpectatorRealHumanoid and SpectatorRealHumanoid.Parent then
		SpectatorRealHumanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, SpectatorOriginalSwimmingEnabled)
	end

	RestoreSpectatorWaterSounds()
	RestoreSpectatorPartStates()
	CurrentCamera = workspace.CurrentCamera or CurrentCamera

	local CurrentCharacter = LocalPlayer.Character
	local CurrentHumanoid = CurrentCharacter and CurrentCharacter:FindFirstChildOfClass("Humanoid")
	local CameraSubject = SpectatorOriginalCameraSubject

	if not CameraSubject or not CameraSubject.Parent or (Clone and CameraSubject:IsDescendantOf(Clone)) then
		CameraSubject = CurrentHumanoid
	end

	if SpectatorOriginalCameraType then
		CurrentCamera.CameraType = SpectatorOriginalCameraType
	end

	if CameraSubject then
		CurrentCamera.CameraSubject = CameraSubject
	end

	StopSpectatorAnimations()

	if Clone then
		Clone:Destroy()
	end

	SpectatorClone = nil
	SpectatorCloneHumanoid = nil
	SpectatorCloneRoot = nil
	SpectatorRealCharacter = nil
	SpectatorRealHumanoid = nil
	SpectatorRealRoot = nil
	SpectatorOriginalCameraSubject = nil
	SpectatorOriginalCameraType = nil
	SpectatorOriginalSwimmingEnabled = nil

	if SpectatorControl and SpectatorControl:Get() then
		SpectatorControl:Set(false, true, true)
	end

	if SpectatorPreviousTargeting and CurrentHumanoid and CurrentHumanoid.Health > 0 then
		SetTargetingState(true, "Move the circle near a player, then click")
	else
		SetStatus("Spectator disabled")
	end

	SpectatorPreviousTargeting = false
end

EnableSpectator = function()
	if SpectatorEnabled then
		return true
	end

	local RealCharacter = LocalPlayer.Character
	local RealHumanoid = RealCharacter and RealCharacter:FindFirstChildOfClass("Humanoid")
	local RealRoot = RealCharacter and RealCharacter:FindFirstChild("HumanoidRootPart")

	if not RealCharacter or not RealHumanoid or RealHumanoid.Health <= 0 or not RealRoot then
		SetStatus("Character is not ready")
		Window:Notify({ Title = "Spectator", Content = "Character is not ready", Type = "Error" })
		return false
	end

	RealCharacter.Archivable = true

	for _, Child in ipairs(RealCharacter:GetChildren()) do
		if Child:IsA("Tool") then
			Child.Archivable = true

			for _, Descendant in ipairs(Child:GetDescendants()) do
				Descendant.Archivable = true
			end
		end
	end

	local Clone = RealCharacter:Clone()
	local CloneHumanoid = Clone:FindFirstChildOfClass("Humanoid")
	local CloneRoot = Clone:FindFirstChild("HumanoidRootPart")

	if not CloneHumanoid or not CloneRoot then
		Clone:Destroy()
		Window:Notify({ Title = "Spectator", Content = "Could not create preview", Type = "Error" })
		return false
	end

	Clone.Name = "_MXSpectatorPreview"

	for _, Descendant in ipairs(Clone:GetDescendants()) do
		if Descendant:IsA("Highlight") then
			Descendant:Destroy()
		elseif Descendant:IsA("Script") or Descendant:IsA("ModuleScript") then
			Descendant:Destroy()
		elseif Descendant:IsA("LocalScript") and Descendant.Name ~= "Animate" then
			Descendant:Destroy()
		elseif IsWaterSound(Descendant) then
			Descendant:Stop()
			Descendant.Volume = 0
		elseif Descendant:IsA("BasePart") then
			Descendant.Transparency = math.max(Descendant.Transparency, SpectatorTransparency)
			Descendant.LocalTransparencyModifier = 0
			Descendant.CanCollide = false
			Descendant.CanTouch = false
			Descendant.CanQuery = false
		elseif Descendant:IsA("Decal") then
			Descendant.Transparency = math.max(Descendant.Transparency, SpectatorTransparency)
		end
	end

	local CloneAnimate = Clone:FindFirstChild("Animate")
	if CloneAnimate and CloneAnimate:IsA("LocalScript") then
		CloneAnimate.Disabled = true
	end

	CloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	CloneHumanoid.BreakJointsOnDeath = false
	CloneHumanoid.AutoRotate = false
	Clone.Parent = workspace

	local StartCFrame = RealCharacter:GetPivot()
	Clone:PivotTo(StartCFrame)
	CloneRoot.Anchored = true
	LoadSpectatorAnimations(RealCharacter, CloneHumanoid)
	DisconnectSpectatorPartTracking()
	table.clear(SpectatorPartStates)
	table.clear(SpectatorRealParts)
	table.clear(SpectatorWaterSoundStates)

	for _, Descendant in ipairs(RealCharacter:GetDescendants()) do
		TrackSpectatorDescendant(Descendant)
	end

	SpectatorDescendantAddedConnection = RealCharacter.DescendantAdded:Connect(TrackSpectatorDescendant)
	SpectatorDescendantRemovingConnection = RealCharacter.DescendantRemoving:Connect(UntrackSpectatorDescendant)
	SpectatorClone = Clone
	SpectatorCloneHumanoid = CloneHumanoid
	SpectatorCloneRoot = CloneRoot
	SpectatorRealCharacter = RealCharacter
	SpectatorRealHumanoid = RealHumanoid
	SpectatorRealRoot = RealRoot
	CurrentCamera = workspace.CurrentCamera or CurrentCamera
	SpectatorOriginalCameraSubject = CurrentCamera.CameraSubject
	SpectatorOriginalCameraType = CurrentCamera.CameraType
	SpectatorOriginalSwimmingEnabled = RealHumanoid:GetStateEnabled(Enum.HumanoidStateType.Swimming)
	RealHumanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)

	if RealHumanoid:GetState() == Enum.HumanoidStateType.Swimming then
		RealHumanoid:ChangeState(Enum.HumanoidStateType.Running)
	end

	SpectatorPreviousTargeting = TargetingEnabled
	SpectatorEnabled = true

	MoveRealCharacterBelowPreview(StartCFrame)
	SetTargetingState(false, "Spectator active")
	CurrentCamera.CameraType = Enum.CameraType.Custom
	CurrentCamera.CameraSubject = CloneHumanoid
	RunService:UnbindFromRenderStep(SpectatorRenderBindingName)
	RunService:UnbindFromRenderStep(SpectatorFinalBindingName)

	local function EnforceSpectatorView()
		if not SpectatorEnabled or not SpectatorClone or not SpectatorClone.Parent then
			return
		end

		CurrentCamera = workspace.CurrentCamera or CurrentCamera

		if SpectatorCloneHumanoid and SpectatorCloneHumanoid.Parent then
			CurrentCamera.CameraType = Enum.CameraType.Custom
			CurrentCamera.CameraSubject = SpectatorCloneHumanoid
		end

		SuppressSpectatorWater()
		MoveRealCharacterBelowPreview(SpectatorClone:GetPivot())
	end

	RunService:BindToRenderStep(SpectatorRenderBindingName, Enum.RenderPriority.Camera.Value - 1, EnforceSpectatorView)
	RunService:BindToRenderStep(SpectatorFinalBindingName, Enum.RenderPriority.Last.Value, EnforceSpectatorView)
	SetStatus("Spectator active — preview is local only")
	return true
end

local function UpdateSpectator(DeltaTime)
	if not SpectatorEnabled then
		return
	end

	if SpectatorActionBusy then
		return
	end

	if not SpectatorClone
		or not SpectatorClone.Parent
		or not SpectatorCloneHumanoid
		or not SpectatorCloneHumanoid.Parent
		or not SpectatorCloneRoot
		or not SpectatorCloneRoot.Parent
		or not SpectatorRealCharacter
		or not SpectatorRealCharacter.Parent
		or not SpectatorRealHumanoid
		or not SpectatorRealHumanoid.Parent
		or not SpectatorRealRoot
		or not SpectatorRealRoot.Parent then
		DisableSpectator()
		return
	end

	local MoveDirection = SpectatorRealHumanoid.MoveDirection
	local HorizontalDirection = Vector3.new(MoveDirection.X, 0, MoveDirection.Z)
	local VerticalDirection = 0

	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
		VerticalDirection = VerticalDirection + 1
	end

	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
		VerticalDirection = VerticalDirection - 1
	end

	local StepTime = math.min(DeltaTime or 0, 0.05)
	local PreviewCFrame = SpectatorClone:GetPivot()
	local Movement = HorizontalDirection * SpectatorMoveSpeed
		+ Vector3.new(0, VerticalDirection * SpectatorVerticalSpeed, 0)
	local PreviewPosition = PreviewCFrame.Position + Movement * StepTime
	local PreviewRotation = PreviewCFrame.Rotation

	if HorizontalDirection.Magnitude > 0.05 then
		PreviewRotation = CFrame.lookAt(Vector3.zero, HorizontalDirection.Unit).Rotation
	end

	PreviewCFrame = CFrame.new(PreviewPosition) * PreviewRotation
	SpectatorClone:PivotTo(PreviewCFrame)
	UpdateSpectatorAnimation(HorizontalDirection.Magnitude, VerticalDirection)
	MoveRealCharacterBelowPreview(PreviewCFrame)
end

DisableTargetSpectate = function(StatusText)
	if not TargetSpectateEnabled then
		return
	end

	TargetSpectateEnabled = false
	TargetSpectatePlayer = nil
	CurrentCamera = workspace.CurrentCamera or CurrentCamera

	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local CameraSubject = TargetSpectateOriginalCameraSubject

	if not CameraSubject or not CameraSubject.Parent then
		CameraSubject = Humanoid
	end

	if TargetSpectateOriginalCameraType then
		CurrentCamera.CameraType = TargetSpectateOriginalCameraType
	end

	if CameraSubject then
		CurrentCamera.CameraSubject = CameraSubject
	end

	TargetSpectateOriginalCameraSubject = nil
	TargetSpectateOriginalCameraType = nil

	if TargetSpectateControl and TargetSpectateControl:Get() then
		TargetSpectateControl:Set(false, true, true)
	end

	SetStatus(StatusText or "Target spectate disabled")
end

local function EnableTargetSpectate(TargetPlayer)
	local Character = TargetPlayer and TargetPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

	if not TargetPlayer or TargetPlayer == LocalPlayer or TargetPlayer.Parent ~= Players
		or not Character or not Humanoid or Humanoid.Health <= 0 then
		Window:Notify({ Title = "Spectate", Content = "That target is not ready", Type = "Error" })
		SetStatus("Target is not ready")
		return false
	end

	if SpectatorEnabled then
		DisableSpectator()
	end

	if TargetSpectateEnabled then
		DisableTargetSpectate()
	end

	CurrentCamera = workspace.CurrentCamera or CurrentCamera
	TargetSpectateOriginalCameraSubject = CurrentCamera.CameraSubject
	TargetSpectateOriginalCameraType = CurrentCamera.CameraType
	TargetSpectatePlayer = TargetPlayer
	TargetSpectateEnabled = true
	CurrentCamera.CameraType = Enum.CameraType.Custom
	CurrentCamera.CameraSubject = Humanoid
	SetStatus("Spectating " .. TargetPlayer.DisplayName)
	return true
end

local function IsCurrentMurderer(Player)
	if not Player or PlayerRoles[Player] ~= "Murder" then
		return false
	end

	local Character = Player.Character
	local Backpack = Player:FindFirstChildOfClass("Backpack") or Player:FindFirstChild("Backpack")
	return HasNamedTool(Character, "Knife") or HasNamedTool(Backpack, "Knife")
end

local function GetCurrentMurderer()
	RefreshRoleVisuals()

	for _, Player in ipairs(CachedPlayers) do
		if Player ~= LocalPlayer and Player.Parent == Players and IsCurrentMurderer(Player) then
			return Player
		end
	end

	return nil
end

local function FireResolvedTarget(Shoot, OriginAttachment, TargetPlayer, AimPart)
	local CurrentTime = os.clock()

	if CurrentTime - LastShotTime < TargetingSettings.ClickDebounce then
		return false
	end

	local TargetCharacter = TargetPlayer and TargetPlayer.Character
	if not TargetCharacter or not AimPart or not AimPart:IsDescendantOf(TargetCharacter) then
		return false
	end

	local PredictedPosition = GetPredictedAimPosition(TargetCharacter, AimPart)
	if not HasClearShot(OriginAttachment.WorldPosition, TargetCharacter, PredictedPosition) then
		return false
	end

	LastShotTime = CurrentTime
	Shoot:FireServer(OriginAttachment.WorldCFrame, CFrame.new(PredictedPosition))
	SetStatus("Shot sent to " .. TargetPlayer.DisplayName)
	return true
end

local function FireAtPointer(PointerPosition)
	if not TargetingEnabled or IsPointerOverMX(PointerPosition) then
		return
	end

	if os.clock() - LastShotTime < TargetingSettings.ClickDebounce then
		return
	end

	local Gun, Shoot, OriginAttachment = GetEquippedGun()
	if not Gun then
		SetStatus("Equip Gun before clicking")
		return
	end

	local TargetPlayer, AimPart = FindTargetNearPointer(PointerPosition, OriginAttachment.WorldPosition)
	if not TargetPlayer or not AimPart then
		SetStatus("No visible player touching the circle")
		return
	end

	FireResolvedTarget(Shoot, OriginAttachment, TargetPlayer, AimPart)
end

local function ShootMurdererPrivilege()
	if MurdererShotBusy or MurderAllBusy or AutoGrabGunBusy then
		Window:Notify({ Title = "Shoot Murderer", Content = "A shot is already in progress", Type = "Warning" })
		return
	end

	if SpectatorEnabled and SpectatorActionBusy then
		RunService.Heartbeat:Wait()

		if SpectatorActionBusy then
			Window:Notify({ Title = "Shoot Murderer", Content = "Preview is busy; try again", Type = "Warning" })
			return
		end
	end

	local Murderer = GetCurrentMurderer()
	local MurdererCharacter = Murderer and Murderer.Character
	local MurdererHumanoid = MurdererCharacter and MurdererCharacter:FindFirstChildOfClass("Humanoid")
	local MurdererRoot = MurdererCharacter and MurdererCharacter:FindFirstChild("HumanoidRootPart")
	local AimPart = MurdererCharacter and GetPreferredAimPart(MurdererCharacter)

	if not Murderer or not MurdererHumanoid or MurdererHumanoid.Health <= 0 or not MurdererRoot or not AimPart then
		Window:Notify({ Title = "Shoot Murderer", Content = "No living murderer was detected", Type = "Error" })
		SetStatus("No living murderer detected")
		return
	end

	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")

	if not Character or not Humanoid or Humanoid.Health <= 0 or not Root then
		Window:Notify({ Title = "Shoot Murderer", Content = "Your character is not ready", Type = "Error" })
		SetStatus("Character is not ready")
		return
	end

	MurdererShotBusy = true
	local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
	local Gun, Shoot, OriginAttachment = GetEquippedGun()
	local EquippedByScript = false
	local AutoEquippedGun

	if not Gun and Backpack then
		local StoredGun = Backpack:FindFirstChild("Gun")

		if StoredGun and StoredGun:IsA("Tool") then
			AutoEquippedGun = StoredGun
			pcall(function()
				Humanoid:EquipTool(StoredGun)
				RunService.Heartbeat:Wait()
			end)
			Gun, Shoot, OriginAttachment = GetEquippedGun()
			EquippedByScript = Gun == StoredGun
		end
	end

	if not Gun or not Shoot or not OriginAttachment then
		if AutoEquippedGun and Backpack and AutoEquippedGun.Parent == Character then
			AutoEquippedGun.Parent = Backpack
		end

		MurdererShotBusy = false
		Window:Notify({ Title = "Shoot Murderer", Content = "No usable Gun is equipped or stored", Type = "Error" })
		SetStatus("A usable Gun is required")
		return
	end

	local OriginalPivot = Character:GetPivot()
	local OriginalRootCFrame = Root.CFrame
	local OriginalLinearVelocity = Root.AssemblyLinearVelocity
	local OriginalAngularVelocity = Root.AssemblyAngularVelocity
	local OriginalAutoRotate = Humanoid.AutoRotate
	local OriginalSit = Humanoid.Sit
	local OriginalPlatformStand = Humanoid.PlatformStand
	local PartStates = {}

	for _, Descendant in ipairs(Character:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			PartStates[Descendant] = {
				CanCollide = Descendant.CanCollide,
				CanTouch = Descendant.CanTouch,
				CanQuery = Descendant.CanQuery
			}
			Descendant.CanCollide = false
			Descendant.CanTouch = false
			Descendant.CanQuery = false
		end
	end

	local PreviewSyncCFrame = BeginPreviewSyncedAction(Character)
	Humanoid.AutoRotate = false
	Humanoid.Sit = false
	Humanoid.PlatformStand = false
	local Success, ErrorMessage = pcall(function()
		local PredictedPosition = GetPredictedAimPosition(MurdererCharacter, AimPart)
		local AbovePosition = MurdererRoot.Position + Vector3.new(0, TargetingSettings.StaffShotHeight, 0)
		local FlatLookPosition = Vector3.new(PredictedPosition.X, AbovePosition.Y, PredictedPosition.Z)

		if (FlatLookPosition - AbovePosition).Magnitude < 0.01 then
			FlatLookPosition = AbovePosition + Vector3.new(OriginalRootCFrame.LookVector.X, 0, OriginalRootCFrame.LookVector.Z)
		end

		Character:PivotTo(CFrame.lookAt(AbovePosition, FlatLookPosition))
		Root.AssemblyLinearVelocity = Vector3.zero
		Root.AssemblyAngularVelocity = Vector3.zero
		RunService.Heartbeat:Wait()

		PredictedPosition = GetPredictedAimPosition(MurdererCharacter, AimPart)
		AbovePosition = MurdererRoot.Position + Vector3.new(0, TargetingSettings.StaffShotHeight, 0)
		FlatLookPosition = Vector3.new(PredictedPosition.X, AbovePosition.Y, PredictedPosition.Z)

		if (FlatLookPosition - AbovePosition).Magnitude < 0.01 then
			FlatLookPosition = AbovePosition + Vector3.new(OriginalRootCFrame.LookVector.X, 0, OriginalRootCFrame.LookVector.Z)
		end

		Character:PivotTo(CFrame.lookAt(AbovePosition, FlatLookPosition))
		Shoot:FireServer(OriginAttachment.WorldCFrame, CFrame.new(PredictedPosition))
		RunService.Heartbeat:Wait()
	end)

	if not PreviewSyncCFrame and Character.Parent and Root.Parent then
		Character:PivotTo(OriginalPivot)
		Root.CFrame = OriginalRootCFrame
		Root.AssemblyLinearVelocity = OriginalLinearVelocity
		Root.AssemblyAngularVelocity = OriginalAngularVelocity
	end

	if Humanoid.Parent then
		Humanoid.AutoRotate = OriginalAutoRotate
		Humanoid.PlatformStand = OriginalPlatformStand
		Humanoid.Sit = OriginalSit

		if not OriginalSit then
			local CurrentState = Humanoid:GetState()

			if CurrentState == Enum.HumanoidStateType.Seated
				or CurrentState == Enum.HumanoidStateType.FallingDown
				or CurrentState == Enum.HumanoidStateType.Ragdoll then
				Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end
	end

	for Part, State in pairs(PartStates) do
		if Part.Parent then
			Part.CanCollide = State.CanCollide
			Part.CanTouch = State.CanTouch
			Part.CanQuery = State.CanQuery
		end
	end

	if EquippedByScript and Backpack and Backpack.Parent and Gun.Parent == Character then
		Gun.Parent = Backpack
	end

	if PreviewSyncCFrame then
		FinishPreviewSyncedAction(Character, PreviewSyncCFrame)
	end

	MurdererShotBusy = false

	if Success then
		LastShotTime = os.clock()
		SetStatus("Shot sent to " .. Murderer.DisplayName .. " with adaptive prediction")
		Window:Notify({
			Title = "Shoot Murderer",
			Content = "Shot sent to " .. Murderer.DisplayName .. " and position restored",
			Type = "Success"
		})
	else
		SetStatus("Shot failed; position was restored")
		Window:Notify({ Title = "Shoot Murderer", Content = tostring(ErrorMessage), Type = "Error" })
	end
end

local function MurderAllPlayers()
	if MurderAllBusy or MurdererShotBusy or AutoGrabGunBusy then
		Window:Notify({ Title = "Murder All", Content = "The action is already running", Type = "Warning" })
		return
	end

	if SpectatorEnabled and SpectatorActionBusy then
		RunService.Heartbeat:Wait()

		if SpectatorActionBusy then
			Window:Notify({ Title = "Murder All", Content = "Preview is busy; try again", Type = "Warning" })
			return
		end
	end

	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
	local Knife = Character and Character:FindFirstChild("Knife")
	local EquippedByScript = false

	if not Character or not Humanoid or Humanoid.Health <= 0 then
		Window:Notify({ Title = "Murder All", Content = "Your character is not ready", Type = "Error" })
		return
	end

	MurderAllBusy = true

	if not Knife and Backpack then
		Knife = Backpack:FindFirstChild("Knife")

		if Knife and Knife:IsA("Tool") then
			pcall(function()
				Humanoid:EquipTool(Knife)
				RunService.Heartbeat:Wait()
			end)
			EquippedByScript = Knife.Parent == Character
		end
	end

	local Events = Knife and Knife:FindFirstChild("Events")
	local KnifeStabbed = Events and Events:FindFirstChild("KnifeStabbed")
	local HandleTouched = Events and Events:FindFirstChild("HandleTouched")

	if not Knife or not Knife:IsA("Tool")
		or not KnifeStabbed or not KnifeStabbed:IsA("RemoteEvent")
		or not HandleTouched or not HandleTouched:IsA("RemoteEvent") then
		if EquippedByScript and Backpack and Knife and Knife.Parent == Character then
			Knife.Parent = Backpack
		end

		MurderAllBusy = false
		Window:Notify({ Title = "Murder All", Content = "You must be the murderer and have the Knife", Type = "Error" })
		SetStatus("Murderer Knife is required")
		return
	end

	local TargetHeads = {}

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local TargetCharacter = Player.Character
			local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass("Humanoid")
			local TargetHead = TargetCharacter and TargetCharacter:FindFirstChild("Head")

			if TargetHumanoid and TargetHumanoid.Health > 0 and TargetHead and TargetHead:IsA("BasePart") then
				TargetHeads[#TargetHeads + 1] = TargetHead
			end
		end
	end

	if #TargetHeads == 0 then
		if EquippedByScript and Backpack and Knife.Parent == Character then
			Knife.Parent = Backpack
		end

		MurderAllBusy = false
		Window:Notify({ Title = "Murder All", Content = "No living players were found", Type = "Warning" })
		return
	end

	local PreviewSyncCFrame = BeginPreviewSyncedAction(Character)
	local Success, ErrorMessage = pcall(function()
		KnifeStabbed:FireServer()
		RunService.PreSimulation:Wait()

		for _, Head in ipairs(TargetHeads) do
			if Head.Parent then
				HandleTouched:FireServer(Head)
			end
		end
	end)

	if EquippedByScript and Backpack and Backpack.Parent and Knife.Parent == Character then
		Knife.Parent = Backpack
	end

	if PreviewSyncCFrame then
		FinishPreviewSyncedAction(Character, PreviewSyncCFrame)
	end

	MurderAllBusy = false

	if Success then
		SetStatus("Murder All sent to " .. tostring(#TargetHeads) .. " players")
		Window:Notify({
			Title = "Murder All",
