local function UpdateMainScale()
	CurrentCamera = Workspace.CurrentCamera or CurrentCamera
	if not CurrentCamera then
		return
	end

	local ViewportSize = CurrentCamera.ViewportSize
	MainScale.Scale = math.clamp(math.min(
		(ViewportSize.X - 16) / 286,
		(ViewportSize.Y - 16) / 202
	), 0.72, 1)

	TargetRadius = math.clamp(math.min(ViewportSize.X, ViewportSize.Y) * 0.095, 54, 76)
	TargetCircle.Size = UDim2.fromOffset(TargetRadius * 2, TargetRadius * 2)
end

local ViewportConnection

local function BindCameraViewport()
	if ViewportConnection then
		ViewportConnection:Disconnect()
		ViewportConnection = nil
	end

	CurrentCamera = Workspace.CurrentCamera or CurrentCamera
	UpdateMainScale()

	if CurrentCamera then
		ViewportConnection = Connect(
			CurrentCamera:GetPropertyChangedSignal("ViewportSize"),
			UpdateMainScale
		)
	end
end

