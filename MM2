RenderConnection = TrackConnection(RunService.RenderStepped:Connect(function(DeltaTime)
	UpdateSpectator(DeltaTime)

	RoleRefreshAccumulator += DeltaTime

	if RoleRefreshAccumulator >= RoleRefreshInterval then
		RoleRefreshAccumulator = 0
		RefreshRoleVisuals()
	end

	if not TargetingEnabled then
		if TargetCircle.Visible then
			TargetCircle.Visible = false
		end

		return
	end

	local PointerPosition = GetPointerPosition()
	if not TargetCircle.Visible then
		TargetCircle.Visible = true
	end

	if LastCirclePointerPosition ~= PointerPosition then
		LastCirclePointerPosition = PointerPosition
		TargetCircle.Position = UDim2.fromOffset(PointerPosition.X, PointerPosition.Y)
	end

	local Gun, Shoot, OriginAttachment = GetEquippedGun()
	CurrentCamera = workspace.CurrentCamera or CurrentCamera
	local OriginPosition = OriginAttachment and OriginAttachment.WorldPosition or CurrentCamera.CFrame.Position

	if Gun then
		SetManualActivation(Gun, true)
	end

	local TargetPlayer, AimPart, MurderPlayer, MurderAimPart = FindTargetNearPointer(PointerPosition, OriginPosition)
	local DisplayPlayer = AutoShootMurderEnabled and MurderPlayer or TargetPlayer
	local DisplayAimPart = AutoShootMurderEnabled and MurderAimPart or AimPart

	SetCurrentTarget(DisplayPlayer, DisplayAimPart)
	UpdateTargetCircleAppearance(DisplayPlayer, Gun ~= nil)
	TryAutoShootMurder(PointerPosition, Gun, Shoot, OriginAttachment, MurderPlayer, MurderAimPart)
end))

