local function GetPredictedAimPosition(TargetCharacter, AimPart)
	local RootPart = TargetCharacter:FindFirstChild("HumanoidRootPart")
	local Humanoid = TargetCharacter:FindFirstChildOfClass("Humanoid")

	if not RootPart or not Humanoid or PredictionTime <= 0 then
		return AimPart.Position
	end

	local Velocity = RootPart.AssemblyLinearVelocity
	local State = Humanoid:GetState()
	local IsAirborne = Humanoid.FloorMaterial == Enum.Material.Air
		or State == Enum.HumanoidStateType.Jumping
		or State == Enum.HumanoidStateType.Freefall

	local HorizontalVelocity = Vector3.new(
		math.clamp(Velocity.X, -MaximumHorizontalVelocity, MaximumHorizontalVelocity),
		0,
		math.clamp(Velocity.Z, -MaximumHorizontalVelocity, MaximumHorizontalVelocity)
	)
	local VerticalVelocity = IsAirborne and math.clamp(Velocity.Y, -MaximumVerticalVelocity, MaximumVerticalVelocity) or 0
	local PredictedPosition = AimPart.Position
		+ HorizontalVelocity * PredictionTime
		+ Vector3.new(0, VerticalVelocity * PredictionTime, 0)

	if IsAirborne then
		PredictedPosition += Vector3.new(0, -0.5 * workspace.Gravity * PredictionTime * PredictionTime, 0)
	end

	return PredictedPosition
end

local function GetCharacterScreenDistance(Character, PointerPosition)
	CurrentCamera = workspace.CurrentCamera or CurrentCamera

	local MinimumX = math.huge
	local MinimumY = math.huge
	local MaximumX = -math.huge
	local MaximumY = -math.huge
	local HasPointInFront = false

	for _, BodyPart in ipairs(GetCharacterBodyParts(Character)) do
		local HalfSize = BodyPart.Size * 0.5
		local BodyCFrame = BodyPart.CFrame

		for _, Sign in ipairs(CharacterCornerSigns) do
			local Corner = BodyCFrame:PointToWorldSpace(Vector3.new(
				HalfSize.X * Sign.X,
				HalfSize.Y * Sign.Y,
				HalfSize.Z * Sign.Z
			))
			local ScreenPoint = CurrentCamera:WorldToScreenPoint(Corner)

			if ScreenPoint.Z > 0 then
				HasPointInFront = true
				MinimumX = math.min(MinimumX, ScreenPoint.X)
				MinimumY = math.min(MinimumY, ScreenPoint.Y)
				MaximumX = math.max(MaximumX, ScreenPoint.X)
				MaximumY = math.max(MaximumY, ScreenPoint.Y)
			end
		end
	end

	if not HasPointInFront then
		return nil
	end

	local ViewportSize = CurrentCamera.ViewportSize
	if MaximumX < 0 or MaximumY < 0 or MinimumX > ViewportSize.X or MinimumY > ViewportSize.Y then
		return nil
	end

	local ClosestPoint = Vector2.new(
		math.clamp(PointerPosition.X, MinimumX, MaximumX),
		math.clamp(PointerPosition.Y, MinimumY, MaximumY)
	)

	return (ClosestPoint - PointerPosition).Magnitude
end

local function FindTargetNearPointer(PointerPosition, OriginPosition)
	CurrentCamera = workspace.CurrentCamera or CurrentCamera

	local BestPlayer
	local BestAimPart
	local BestScreenDistance = TargetRadius
	local BestMurderPlayer
	local BestMurderAimPart
	local BestMurderScreenDistance = TargetRadius

	for _, Player in ipairs(CachedPlayers) do
		if Player ~= LocalPlayer and Player.Parent == Players then
			local Character = Player.Character
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
			local AimPart = Character and (Character:FindFirstChild("Head") or RootPart)

			if Humanoid and Humanoid.Health > 0 and RootPart and AimPart then
				local ScreenDistance = GetCharacterScreenDistance(Character, PointerPosition)

				if ScreenDistance then
					local IsGeneralCandidate = ScreenDistance <= BestScreenDistance
					local IsMurderCandidate = AutoShootMurderEnabled
						and PlayerRoles[Player] == "Murder"
						and ScreenDistance <= BestMurderScreenDistance

					if IsGeneralCandidate or IsMurderCandidate then
						local PredictedPosition = GetPredictedAimPosition(Character, AimPart)

						if HasClearShot(OriginPosition, Character, PredictedPosition) then
							if IsGeneralCandidate then
								BestPlayer = Player
								BestAimPart = AimPart
								BestScreenDistance = ScreenDistance
							end

							if IsMurderCandidate then
								BestMurderPlayer = Player
								BestMurderAimPart = AimPart
								BestMurderScreenDistance = ScreenDistance
							end
						end
					end
				end
			end
		end
	end

	return BestPlayer, BestAimPart, BestMurderPlayer, BestMurderAimPart
end

