local function GetCharacterScreenDistance(Character, PointerPosition)
	CurrentCamera = workspace.CurrentCamera or CurrentCamera

	local MinimumX = math.huge
	local MinimumY = math.huge
	local MaximumX = -math.huge
	local MaximumY = -math.huge
	local HasPointInFront = false

	for _, BodyPart in ipairs(Character:GetChildren()) do
		if BodyPart:IsA("BasePart") then
			local HalfSize = BodyPart.Size * 0.5

			for X = -1, 1, 2 do
				for Y = -1, 1, 2 do
					for Z = -1, 1, 2 do
						local Corner = BodyPart.CFrame:PointToWorldSpace(Vector3.new(
							HalfSize.X * X,
							HalfSize.Y * Y,
							HalfSize.Z * Z
						))
						local ScreenPoint = CurrentCamera:WorldToScreenPoint(Corner)

						if ScreenPoint.Z > 0 then
							HasPointInFront = true
							MinimumX = math.min(MinimumX, ScreenPoint.X)
							MinimumY = math.min(MinimumY, ScreenPoint.Y)
							MaximumX = math.max(MaximumX, ScreenPoint.X)
							MaximumY = math.max(MaximumY, ScreenPoint.Y)
						end
					end
				end
			end
		end
	end

	if not HasPointInFront then
		return nil
	end

	local ViewportSize = CurrentCamera.ViewportSize
	if MaximumX < 0 or MaximumY < 0 or MinimumX > ViewportSize.X or MinimumY > ViewportSize.Y then
		return nil
	end

	local ClosestPoint = Vector2.new(
		math.clamp(PointerPosition.X, MinimumX, MaximumX),
		math.clamp(PointerPosition.Y, MinimumY, MaximumY)
	)

	return (ClosestPoint - PointerPosition).Magnitude
end

local function FindHoveredPlayerNearPointer(PointerPosition)
	CurrentCamera = workspace.CurrentCamera or CurrentCamera

	-- First use the exact screen ray. This makes the circle switch targets
	-- immediately when the pointer is directly over any queried body part.
	local IncludedCharacters = {}

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer and Player.Character then
			table.insert(IncludedCharacters, Player.Character)
		end
	end

	if #IncludedCharacters > 0 then
		local PointerRay = CurrentCamera:ViewportPointToRay(PointerPosition.X, PointerPosition.Y)
		local PointerParameters = RaycastParams.new()
		PointerParameters.FilterType = Enum.RaycastFilterType.Include
		PointerParameters.FilterDescendantsInstances = IncludedCharacters
		PointerParameters.IgnoreWater = true

		local PointerResult = workspace:Raycast(
			PointerRay.Origin,
			PointerRay.Direction * 10000,
			PointerParameters
		)

		if PointerResult then
			local HitCharacter = PointerResult.Instance:FindFirstAncestorOfClass("Model")
			local HitPlayer = HitCharacter and Players:GetPlayerFromCharacter(HitCharacter)
			local HitHumanoid = HitCharacter and HitCharacter:FindFirstChildOfClass("Humanoid")
			local HitRoot = HitCharacter and HitCharacter:FindFirstChild("HumanoidRootPart")
			local HitAimPart = HitCharacter and (HitCharacter:FindFirstChild("Head") or HitRoot)

			if HitPlayer ~= LocalPlayer
				and HitPlayer
				and HitHumanoid
				and HitHumanoid.Health > 0
				and HitRoot
				and HitAimPart then
				return HitPlayer, HitAimPart, 0
			end
		end
	end

	-- Keep the radius/bounding-box fallback so near misses inside the circle
	-- still select the closest visible on-screen character.
	local BestPlayer
	local BestAimPart
	local BestScreenDistance = TargetRadius

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local Character = Player.Character
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
			local AimPart = Character and (Character:FindFirstChild("Head") or RootPart)

				if Humanoid and Humanoid.Health > 0 and RootPart and AimPart then
					local ScreenDistance = GetCharacterScreenDistance(Character, PointerPosition)

					if ScreenDistance and ScreenDistance <= BestScreenDistance then
						BestPlayer = Player
						BestAimPart = AimPart
						BestScreenDistance = ScreenDistance
					end
				end
			end
		end

	return BestPlayer, BestAimPart, BestScreenDistance
end

local function FindTargetNearPointer(PointerPosition, OriginPosition)
	local HoveredPlayer, AimPart = FindHoveredPlayerNearPointer(PointerPosition)
	local Character = HoveredPlayer and HoveredPlayer.Character
	if not Character or not AimPart then
		return nil, nil
	end

	local PredictedPosition, ActivePredictionTime = GetPredictedAimPosition(Character, AimPart)
	if HasClearShot(OriginPosition, Character, PredictedPosition) then
		return HoveredPlayer, AimPart
	end

	return nil, nil
end

local function FindMurderLockTarget(OriginPosition)
	local BestVisiblePlayer
	local BestVisibleAimPart
	local BestVisibleDistance = math.huge
	local BestBlockedPlayer
	local BestBlockedAimPart
	local BestBlockedDistance = math.huge

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local Character = Player.Character
			local Backpack = Player:FindFirstChildOfClass("Backpack") or Player:FindFirstChild("Backpack")
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
			local AimPart = Character and (Character:FindFirstChild("Head") or RootPart)
			local HasKnife = HasNamedTool(Character, "Knife") or HasNamedTool(Backpack, "Knife")

			if HasKnife and Humanoid and Humanoid.Health > 0 and RootPart and AimPart then
				local Distance = (RootPart.Position - OriginPosition).Magnitude
				local PredictedPosition = GetPredictedAimPosition(Character, AimPart)
				local ClearShot = HasClearShot(OriginPosition, Character, PredictedPosition)

				if ClearShot and Distance < BestVisibleDistance then
					BestVisiblePlayer = Player
					BestVisibleAimPart = AimPart
					BestVisibleDistance = Distance
				elseif not ClearShot and Distance < BestBlockedDistance then
					BestBlockedPlayer = Player
					BestBlockedAimPart = AimPart
					BestBlockedDistance = Distance
				end
			end
		end
	end

	if BestVisiblePlayer then
		return BestVisiblePlayer, BestVisibleAimPart, true
	end

	if BestBlockedPlayer then
		return BestBlockedPlayer, BestBlockedAimPart, false
	end

	return nil, nil, false
end

