local function GetClosestPointOnSegment(Point, SegmentStart, SegmentEnd)
	local Segment = SegmentEnd - SegmentStart
	local LengthSquared = Segment:Dot(Segment)

	if LengthSquared <= 0.0001 then
		return SegmentStart, 0
	end

	local Alpha = math.clamp((Point - SegmentStart):Dot(Segment) / LengthSquared, 0, 1)
	return SegmentStart + Segment * Alpha, Alpha
end

local function RemoveAdaptiveShot(Shot)
	for Index = #AdaptivePendingShots, 1, -1 do
		if AdaptivePendingShots[Index] == Shot then
			table.remove(AdaptivePendingShots, Index)
			break
		end
	end
end

local function ApplyAdaptiveCorrection(Shot)
	local BeamData = Shot.BeamData
	local Profile = GetAdaptiveProfile(Shot.MovementState)
	local MissDistance = BeamData.MissDistance
	local Velocity = BeamData.TargetVelocity
	local SpeedSquared = Velocity:Dot(Velocity)

	Profile.Samples += 1
	Profile.Misses += 1
	Profile.AverageMiss += (MissDistance - Profile.AverageMiss) / Profile.Samples

	AdaptiveStats.Misses += 1
	AdaptiveStats.LastMiss = MissDistance
	AdaptiveStats.LastProfile = Profile.Name
	AdaptiveStats.LastActivePrediction = Profile.Value

	if math.sqrt(SpeedSquared) < AdaptiveMinimumMovementSpeed then
		AdaptiveStats.LastCorrection = 0
		AdaptiveStats.LastOutcome = "MISS • TARGET TOO SLOW"
		return
	end

	-- The component of the beam miss along the target's movement tells us
	-- whether the shot under-led or over-led the target.
	local MissVector = BeamData.TargetPosition - BeamData.ClosestPoint
	local RawTimeCorrection = MissVector:Dot(Velocity) / math.max(SpeedSquared, 0.001)
	local LearnedCorrection = math.clamp(
		RawTimeCorrection * AdaptiveLearningRate,
		-AdaptiveMaximumStep,
		AdaptiveMaximumStep
	)

	if math.abs(LearnedCorrection) < 0.0005 then
		LearnedCorrection = 0
	end

	Profile.Value = math.clamp(
		Profile.Value + LearnedCorrection,
		MinimumPrediction,
		MaximumPrediction
	)

	AdaptiveStats.LastCorrection = LearnedCorrection
	AdaptiveStats.LastActivePrediction = Profile.Value
	AdaptiveStats.LastOutcome = LearnedCorrection == 0
		and "MISS • NO SAFE CHANGE"
		or (LearnedCorrection > 0 and "MISS • INCREASING LEAD" or "MISS • REDUCING LEAD")
end

local function ResolveAdaptiveShot(Shot)
	if Shot.Resolved then
		return
	end

	Shot.Resolved = true
	RemoveAdaptiveShot(Shot)

	local Character = Shot.Character
	local Humanoid = Shot.Humanoid
	local Eliminated = not Character
		or not Character.Parent
		or not Humanoid
		or not Humanoid.Parent
		or Humanoid.Health <= 0
	local Profile = GetAdaptiveProfile(Shot.MovementState)

	AdaptiveStats.LastTarget = Shot.Player and Shot.Player.DisplayName or "--"
	AdaptiveStats.LastProfile = Profile.Name

	if Eliminated then
		-- Several queued shots can observe the same eliminated Humanoid. Only
		-- the first matched shot is allowed to confirm it.
		if not Humanoid or AdaptiveConfirmedHumanoids[Humanoid] then
			return
		end

		if not Shot.BeamData then
			AdaptiveStats.LastOutcome = "ELIMINATION • BEAM UNVERIFIED"
			AdaptiveStats.LastCorrection = 0
			return
		end

		AdaptiveConfirmedHumanoids[Humanoid] = Shot.Id
		AdaptiveStats.Kills += 1
		AdaptiveStats.Hits += 1
		AdaptiveStats.LastOutcome = "HIT CONFIRMED • ELIMINATED"
		AdaptiveStats.LastCorrection = 0
		Profile.Kills += 1
		Profile.Hits += 1
		return
	end

	if not Shot.BeamData then
		AdaptiveStats.LastOutcome = "NO MATCHING BEAM"
		AdaptiveStats.LastCorrection = 0
		return
	end

	-- In this game a real hit eliminates the target. If the same Humanoid is
	-- still alive, the beam proximity is only measurement data, not a hit.
	if AdaptiveEnabled then
		ApplyAdaptiveCorrection(Shot)
	else
		AdaptiveStats.Misses += 1
		AdaptiveStats.LastMiss = Shot.BeamData.MissDistance
		AdaptiveStats.LastOutcome = "MISS • ADAPTIVE PAUSED"
		AdaptiveStats.LastCorrection = 0
	end
end

local function RegisterAdaptiveShot(
	TargetPlayer,
	TargetCharacter,
	Humanoid,
	AimPart,
	OriginPosition,
	PredictedPosition,
	ActivePredictionTime,
	Tracker
)
	AdaptiveShotSequence += 1

	local RootPart = TargetCharacter:FindFirstChild("HumanoidRootPart")
	local TargetVelocity = RootPart and RootPart.AssemblyLinearVelocity or Vector3.zero
	local Shot = {
		Id = AdaptiveShotSequence,
		FiredAt = os.clock(),
		Player = TargetPlayer,
		Character = TargetCharacter,
		Humanoid = Humanoid,
		AimPart = AimPart,
		AimPartName = AimPart.Name,
		Origin = OriginPosition,
		PredictedPosition = PredictedPosition,
		PredictionUsed = ActivePredictionTime,
		MovementState = Tracker and Tracker.MovementState or "Unknown",
		TargetVelocity = TargetVelocity,
		BeamData = nil,
		Resolved = false,
	}

	table.insert(AdaptivePendingShots, Shot)
	AdaptiveStats.Shots += 1
	AdaptiveStats.LastTarget = TargetPlayer.DisplayName
	AdaptiveStats.LastOutcome = "WAITING FOR BEAM"
	AdaptiveStats.LastMiss = nil
	AdaptiveStats.LastCorrection = 0
	AdaptiveStats.LastProfile = Shot.MovementState
	AdaptiveStats.LastActivePrediction = ActivePredictionTime

	task.delay(AdaptiveOutcomeWindow, function()
		ResolveAdaptiveShot(Shot)
	end)

	return Shot
end

local function MatchBeamToAdaptiveShot(Point0, Point1)
	local Now = os.clock()
	local BestShot
	local BestStart
	local BestEnd
	local BestAlignment
	local BestOriginGap
	local BestScore = math.huge

	for _, Shot in ipairs(AdaptivePendingShots) do
		local Age = Now - Shot.FiredAt

		if not Shot.Resolved
			and not Shot.BeamData
			and Age >= 0
			and Age <= AdaptiveBeamMatchWindow then
			local ExpectedOffset = Shot.PredictedPosition - Shot.Origin

			if ExpectedOffset.Magnitude > 0.01 then
				local Point0Gap = (Point0 - Shot.Origin).Magnitude
				local Point1Gap = (Point1 - Shot.Origin).Magnitude
				local BeamStart = Point0Gap <= Point1Gap and Point0 or Point1
				local BeamEnd = Point0Gap <= Point1Gap and Point1 or Point0
				local BeamOffset = BeamEnd - BeamStart
				local OriginGap = math.min(Point0Gap, Point1Gap)

				if BeamOffset.Magnitude > 0.01 then
					local Alignment = BeamOffset.Unit:Dot(ExpectedOffset.Unit)

					if OriginGap <= 20 and Alignment >= 0.82 then
						local Score = OriginGap * 0.08 + (1 - Alignment) * 12 + Age * 0.25

						if Score < BestScore then
							BestScore = Score
							BestShot = Shot
							BestStart = BeamStart
							BestEnd = BeamEnd
							BestAlignment = Alignment
							BestOriginGap = OriginGap
						end
					end
				end
			end
		end
	end

	return BestShot, BestStart, BestEnd, BestAlignment, BestOriginGap
end

local function CaptureAdaptiveBeam(BeamPart, Beam)
	local Point0, Point1 = GetBeamWorldPoints(Beam)
	if not Point0 or not Point1 then
		return false
	end

	local Shot, BeamStart, BeamEnd, Alignment, OriginGap = MatchBeamToAdaptiveShot(Point0, Point1)
	if not Shot then
		return false
	end

	local AimPart = Shot.AimPart
	if not AimPart or not AimPart.Parent or not AimPart:IsDescendantOf(Shot.Character) then
		AimPart = Shot.Character and Shot.Character:FindFirstChild(Shot.AimPartName)
	end

	if not AimPart or not AimPart:IsA("BasePart") then
		return false
	end

	local TargetPosition = AimPart.Position
	local ClosestPoint, SegmentAlpha = GetClosestPointOnSegment(TargetPosition, BeamStart, BeamEnd)
	local RootPart = Shot.Character:FindFirstChild("HumanoidRootPart")
	local TargetVelocity = RootPart and RootPart.AssemblyLinearVelocity or Shot.TargetVelocity
	local MissDistance = (TargetPosition - ClosestPoint).Magnitude
	local BeamAge = os.clock() - Shot.FiredAt

	Shot.BeamData = {
		Part = BeamPart,
		Beam = Beam,
		Start = BeamStart,
		End = BeamEnd,
		ClosestPoint = ClosestPoint,
		SegmentAlpha = SegmentAlpha,
		TargetPosition = TargetPosition,
		TargetVelocity = TargetVelocity,
		MissDistance = MissDistance,
		Age = BeamAge,
		Alignment = Alignment,
		OriginGap = OriginGap,
	}

	AdaptiveStats.Beams += 1
	AdaptiveStats.LastMiss = MissDistance
	AdaptiveStats.LastBeamAge = BeamAge
	AdaptiveStats.LastBeamAlignment = Alignment
	AdaptiveStats.LastBeamOriginGap = OriginGap
	AdaptiveStats.LastOutcome = "BEAM CAPTURED"
	return true
end

local function QueueAdaptiveBeamPart(BeamPart)
	if not BeamPart or BeamPart.Name ~= "Part" or AdaptiveCapturedParts[BeamPart] then
		return
	end

	AdaptiveCapturedParts[BeamPart] = "processing"

	task.spawn(function()
		local StartedAt = os.clock()

		repeat
			if not BeamPart.Parent then
				break
			end

			local Beam = BeamPart:FindFirstChildWhichIsA("Beam", true)
			if Beam and GetBeamWorldPoints(Beam) then
				if CaptureAdaptiveBeam(BeamPart, Beam) then
					AdaptiveCapturedParts[BeamPart] = true
					return
				end
			end

			task.wait(0.01)
		until os.clock() - StartedAt >= 0.45

		-- Let DescendantAdded retry if the Beam or its attachments arrived late.
		if AdaptiveCapturedParts[BeamPart] == "processing" then
			AdaptiveCapturedParts[BeamPart] = nil
		end
	end)
end

local function FindWorkspacePartContainer(InstanceValue)
	local Current = InstanceValue

	while Current and Current.Parent and Current.Parent ~= workspace do
		Current = Current.Parent
	end

	if Current and Current.Parent == workspace and Current.Name == "Part" then
		return Current
	end

	return nil
end

