local function ClearCharacterPartCache(Character)
	local Entry = CharacterPartCache[Character]
	if not Entry then
		return
	end

	CharacterPartCache[Character] = nil

	for _, Connection in ipairs(Entry.Connections) do
		Connection:Disconnect()
	end

	table.clear(Entry.Connections)
	table.clear(Entry.Parts)
end

local function GetCharacterBodyParts(Character)
	local Entry = CharacterPartCache[Character]
	if Entry then
		return Entry.Parts
	end

	Entry = {
		Parts = {},
		Connections = {},
	}
	CharacterPartCache[Character] = Entry

	for _, Child in ipairs(Character:GetChildren()) do
		if Child:IsA("BasePart") then
			Entry.Parts[#Entry.Parts + 1] = Child
		end
	end

	Entry.Connections[1] = Character.ChildAdded:Connect(function(Child)
		if Child:IsA("BasePart") then
			Entry.Parts[#Entry.Parts + 1] = Child
		end
	end)

	Entry.Connections[2] = Character.ChildRemoved:Connect(function(Child)
		for Index = #Entry.Parts, 1, -1 do
			if Entry.Parts[Index] == Child then
				table.remove(Entry.Parts, Index)
				break
			end
		end
	end)

	Entry.Connections[3] = Character.AncestryChanged:Connect(function(_, Parent)
		if not Parent then
			ClearCharacterPartCache(Character)
		end
	end)

	return Entry.Parts
end

