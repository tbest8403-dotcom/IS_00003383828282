RenderConnection = Connect(RunService.RenderStepped, function(DeltaTime)
	if Destroyed then
		return
	end

	UpdateSpectator(DeltaTime)

	RoleRefreshAccumulator += DeltaTime

	if RoleRefreshAccumulator >= Config.RoleInterval then
		RoleRefreshAccumulator = 0
		RefreshRoleVisuals()
	end

	if not TargetingEnabled then
		TargetCircle.Visible = false
		UpdateTrackingDisplay(nil)
		return
	end

	local PointerPosition = GetPointerPosition()
	TargetCircle.Position = UDim2.fromOffset(PointerPosition.X, PointerPosition.Y)
	TargetCircle.Visible = not MurderLockEnabled

	TargetScanAccumulator += DeltaTime
	if TargetScanAccumulator < Config.TargetInterval then
		return
	end
	TargetScanAccumulator = 0

	local Gun, _, OriginAttachment = GetEquippedGun()
	CurrentCamera = Workspace.CurrentCamera or CurrentCamera
	if not CurrentCamera then
		return
	end

	local OriginPosition = OriginAttachment
		and OriginAttachment.WorldPosition
		or CurrentCamera.CFrame.Position

	if Gun then
		SetManualActivation(Gun, true)
	end

	if MurderLockEnabled then
		local MurderPlayer, MurderAimPart, MurderClearShot = FindMurderLockTarget(OriginPosition)
		UpdateTrackingDisplay(MurderPlayer)
		SetCurrentTarget(MurderPlayer, MurderAimPart)

		if not MurderPlayer then
			SetStatus("Murderer not found", Color3.fromRGB(255, 170, 105))
		elseif not Gun then
			SetStatus(
				"Locked: " .. MurderPlayer.DisplayName .. " • equip gun",
				Color3.fromRGB(255, 170, 105)
			)
		elseif MurderClearShot then
			SetStatus(
				"Locked: " .. MurderPlayer.DisplayName .. " • clear shot",
				Color3.fromRGB(255, 92, 102)
			)
		else
			SetStatus(
				"Locked: " .. MurderPlayer.DisplayName .. " • behind wall",
				Color3.fromRGB(255, 170, 105)
			)
		end

		return
	end

	local HoveredPlayer, HoveredAimPart, HoveredClearShot = EvaluatePointerTarget(
		PointerPosition,
		OriginPosition
	)
	local TargetPlayer = HoveredClearShot and HoveredPlayer or nil
	local AimPart = HoveredClearShot and HoveredAimPart or nil

	SetCurrentTarget(TargetPlayer, AimPart)
	UpdateTrackingDisplay(HoveredPlayer)

	if HoveredPlayer then
		if not Gun then
			SetCircleAppearance("NoGun", HoveredPlayer.DisplayName)
			SetStatus(
				"Hovering " .. HoveredPlayer.DisplayName .. " • equip gun",
				Color3.fromRGB(255, 170, 105)
			)
		elseif HoveredClearShot then
			SetCircleAppearance("Ready", HoveredPlayer.DisplayName)
			SetStatus(
				"Hovering " .. HoveredPlayer.DisplayName .. " • clear shot",
				Color3.fromRGB(130, 235, 160)
			)
		else
			SetCircleAppearance("Warning", HoveredPlayer.DisplayName .. " • WALL")
			SetStatus(
				"Hovering " .. HoveredPlayer.DisplayName .. " • blocked by wall",
				Color3.fromRGB(255, 170, 105)
			)
		end
	else
		SetCircleAppearance("Idle", Gun and "NO TARGET" or "EQUIP GUN")
		SetStatus(
			Gun and "Move the circle near a player, then click" or "Equip Gun before clicking",
			Gun and Color3.fromRGB(160, 160, 170) or Color3.fromRGB(255, 170, 105)
		)
	end
end)

Connect(ScreenGui.Destroying, function()
	if Destroyed then
		return
	end
	Destroyed = true

	DisableSpectator()
	RunService:UnbindFromRenderStep(SpectatorRenderBindingName)
	RunService:UnbindFromRenderStep(SpectatorFinalBindingName)
	RunService:UnbindFromRenderStep(SpectatorBodyBindingName)

	if RenderConnection then
		RenderConnection:Disconnect()
		RenderConnection = nil
	end

	ClearTargetHighlight()
	ClearAllRoleHighlights()
	RestoreManualActivation()
	RestoreSpectatorPartStates()
	RestoreSpectatorHumanoidStates()
	RestoreSpectatorArchivableStates()
	local WatchedPlayer = next(RoleWatchStates)
	while WatchedPlayer do
		DisconnectRoleWatch(WatchedPlayer)
		WatchedPlayer = next(RoleWatchStates)
	end

	for _, Connection in ipairs(Connections) do
		if Connection.Connected then
			Connection:Disconnect()
		end
	end
	table.clear(Connections)
end)
