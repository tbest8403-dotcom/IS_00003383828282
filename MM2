local function ConnectAdaptiveHud(Signal, Callback)
	local Connection = Signal:Connect(Callback)
	table.insert(AdaptiveHudConnections, Connection)
	return Connection
end

local function CreateAdaptiveHud(ScreenName, TitleText, Position, AccentColor)
	local HudGui = Instance.new("ScreenGui")
	HudGui.Name = ScreenName
	HudGui.IgnoreGuiInset = true
	HudGui.ResetOnSpawn = false
	HudGui.DisplayOrder = 101
	HudGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	HudGui.Parent = AdaptiveDataHudsEnabled and PlayerGui or nil

	local Panel = Instance.new("Frame")
	Panel.Name = "Panel"
	Panel.Position = Position
	Panel.Size = UDim2.fromOffset(238, 104)
	Panel.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
	Panel.BorderSizePixel = 0
	Panel.Active = true
	Panel.ZIndex = 60
	Panel.Parent = HudGui

	local PanelCorner = Instance.new("UICorner")
	PanelCorner.CornerRadius = UDim.new(0, 10)
	PanelCorner.Parent = Panel

	local PanelStroke = Instance.new("UIStroke")
	PanelStroke.Color = AccentColor
	PanelStroke.Thickness = 1
	PanelStroke.Transparency = 0.25
	PanelStroke.Parent = Panel

	local Accent = Instance.new("Frame")
	Accent.Size = UDim2.fromOffset(4, 104)
	Accent.BackgroundColor3 = AccentColor
	Accent.BorderSizePixel = 0
	Accent.ZIndex = 61
	Accent.Parent = Panel

	local AccentCorner = Instance.new("UICorner")
	AccentCorner.CornerRadius = UDim.new(0, 10)
	AccentCorner.Parent = Accent

	local Header = Instance.new("TextLabel")
	Header.Position = UDim2.fromOffset(14, 8)
	Header.Size = UDim2.new(1, -24, 0, 17)
	Header.BackgroundTransparency = 1
	Header.Font = Enum.Font.GothamBold
	Header.Text = TitleText
	Header.TextColor3 = Color3.fromRGB(235, 235, 241)
	Header.TextSize = 10
	Header.TextXAlignment = Enum.TextXAlignment.Left
	Header.ZIndex = 61
	Header.Parent = Panel

	local Divider = Instance.new("Frame")
	Divider.Position = UDim2.fromOffset(14, 30)
	Divider.Size = UDim2.new(1, -24, 0, 1)
	Divider.BackgroundColor3 = Color3.fromRGB(52, 52, 61)
	Divider.BorderSizePixel = 0
	Divider.ZIndex = 61
	Divider.Parent = Panel

	local Primary = Instance.new("TextLabel")
	Primary.Position = UDim2.fromOffset(14, 38)
	Primary.Size = UDim2.new(1, -24, 0, 22)
	Primary.BackgroundTransparency = 1
	Primary.Font = Enum.Font.GothamSemibold
	Primary.Text = "--"
	Primary.TextColor3 = AccentColor
	Primary.TextSize = 12
	Primary.TextXAlignment = Enum.TextXAlignment.Left
	Primary.TextTruncate = Enum.TextTruncate.AtEnd
	Primary.ZIndex = 61
	Primary.Parent = Panel

	local Detail = Instance.new("TextLabel")
	Detail.Position = UDim2.fromOffset(14, 62)
	Detail.Size = UDim2.new(1, -24, 0, 34)
	Detail.BackgroundTransparency = 1
	Detail.Font = Enum.Font.Code
	Detail.Text = "--\n--"
	Detail.TextColor3 = Color3.fromRGB(184, 184, 196)
	Detail.TextSize = 10
	Detail.TextXAlignment = Enum.TextXAlignment.Left
	Detail.TextYAlignment = Enum.TextYAlignment.Top
	Detail.ZIndex = 61
	Detail.Parent = Panel

	local DraggingPanel = false
	local DragStartPosition
	local PanelStartPosition

	ConnectAdaptiveHud(Panel.InputBegan, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then
			DraggingPanel = true
			DragStartPosition = Input.Position
			PanelStartPosition = Panel.Position
		end
	end)

	ConnectAdaptiveHud(UserInputService.InputChanged, function(Input)
		if not DraggingPanel or not DragStartPosition or not PanelStartPosition then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then
			local Delta = Input.Position - DragStartPosition
			Panel.Position = UDim2.new(
				PanelStartPosition.X.Scale,
				PanelStartPosition.X.Offset + Delta.X,
				PanelStartPosition.Y.Scale,
				PanelStartPosition.Y.Offset + Delta.Y
			)
		end
	end)

	ConnectAdaptiveHud(UserInputService.InputEnded, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then
			DraggingPanel = false
		end
	end)

	return HudGui, Primary, Detail
end

