local function ClampMainPosition(Position)
	CurrentCamera = Workspace.CurrentCamera or CurrentCamera
	if not CurrentCamera then
		return Position
	end

	local ViewportSize = CurrentCamera.ViewportSize
	local FrameSize = MainFrame.AbsoluteSize
	local HalfWidth = FrameSize.X * 0.5
	local HalfHeight = FrameSize.Y * 0.5
	local CenterX = Position.X.Scale * ViewportSize.X + Position.X.Offset
	local CenterY = Position.Y.Scale * ViewportSize.Y + Position.Y.Offset

	CenterX = math.clamp(CenterX, HalfWidth + 8, ViewportSize.X - HalfWidth - 8)
	CenterY = math.clamp(CenterY, HalfHeight + 8, ViewportSize.Y - HalfHeight - 8)
	return UDim2.fromOffset(CenterX, CenterY)
end

local function UpdateDrag(Input)
	local Delta = Input.Position - DragStart
	local NewPosition = UDim2.new(
		StartPosition.X.Scale,
		StartPosition.X.Offset + Delta.X,
		StartPosition.Y.Scale,
		StartPosition.Y.Offset + Delta.Y
	)
	MainFrame.Position = ClampMainPosition(NewPosition)
end

