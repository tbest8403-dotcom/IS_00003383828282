local function GetEquippedGun()
	local Character = LocalPlayer.Character
	if CachedGun
		and CachedGun.Parent == Character
		and CachedShoot
		and CachedShoot.Parent == CachedGun
		and CachedOriginAttachment
		and Character
		and CachedOriginAttachment:IsDescendantOf(Character) then
		return CachedGun, CachedShoot, CachedOriginAttachment
	end

	CachedGun = nil
	CachedShoot = nil
	CachedOriginAttachment = nil

	local Gun = Character and Character:FindFirstChild("Gun")
	local Shoot = Gun and Gun:FindFirstChild("Shoot")
	local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
	local OriginAttachment = RootPart and RootPart:FindFirstChild("GunRaycastAttachment")

	if Gun and Gun:IsA("Tool") and Shoot and Shoot:IsA("RemoteEvent") and OriginAttachment and OriginAttachment:IsA("Attachment") then
		CachedGun = Gun
		CachedShoot = Shoot
		CachedOriginAttachment = OriginAttachment
		return CachedGun, CachedShoot, CachedOriginAttachment
	end

	return nil
end

local function SetManualActivation(Gun, ManualOnly)
	if not Gun then
		return
	end

	if OriginalManualActivation[Gun] == nil then
		OriginalManualActivation[Gun] = Gun.ManualActivationOnly
	end

	if Gun.ManualActivationOnly ~= ManualOnly then
		Gun.ManualActivationOnly = ManualOnly
	end
end

local function RestoreManualActivation()
	for Gun, OriginalValue in pairs(OriginalManualActivation) do
		if Gun.Parent then
			Gun.ManualActivationOnly = OriginalValue
		end
	end

	table.clear(OriginalManualActivation)
end

local function HasNamedTool(Container, ToolName)
	if not Container then
		return false
	end

	local LowerToolName = string.lower(ToolName)
	for _, Child in ipairs(Container:GetChildren()) do
		if Child:IsA("Tool") and string.lower(Child.Name) == LowerToolName then
			return true
		end
	end

	return false
end

local function ClearRoleHighlight(Player)
	local Highlight = RoleHighlights[Player]

	if Highlight then
		Highlight:Destroy()
		RoleHighlights[Player] = nil
	end

	RoleStates[Player] = nil
end

local function ClearAllRoleHighlights()
	for _, Highlight in pairs(RoleHighlights) do
		if Highlight then
			Highlight:Destroy()
		end
	end

	table.clear(RoleHighlights)
	table.clear(RoleStates)
end

local function UpdateRoleVisual(Player)
	if not RoleVisualsEnabled or Player == LocalPlayer then
		ClearRoleHighlight(Player)
		return
	end

	local Character = Player.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Backpack = Player:FindFirstChildOfClass("Backpack") or Player:FindFirstChild("Backpack")

	if not Character or not Humanoid or Humanoid.Health <= 0 then
		ClearRoleHighlight(Player)
		return
	end

	local HasKnife = HasNamedTool(Character, "Knife") or HasNamedTool(Backpack, "Knife")
	local HasGun = HasNamedTool(Character, "Gun") or HasNamedTool(Backpack, "Gun")
	local OutlineColor
	local RoleName

	if HasKnife then
		OutlineColor = Color3.fromRGB(255, 45, 55)
		RoleName = "Murderer"
	elseif HasGun then
		OutlineColor = Color3.fromRGB(55, 135, 255)
		RoleName = "Sheriff"
	else
		OutlineColor = Config.InnocentColor
		RoleName = "Innocent"
	end

	local Highlight = RoleHighlights[Player]

	if Highlight and (not Highlight.Parent or Highlight.Adornee ~= Character) then
		ClearRoleHighlight(Player)
		Highlight = nil
	end

	if Highlight and RoleStates[Player] == RoleName then
		if CurrentTargetPlayer == Player and CurrentHighlight then
			CurrentHighlight:Destroy()
			CurrentHighlight = nil
		end
		return
	end

	if not Highlight then
		Highlight = Instance.new("Highlight")
		Highlight.Name = "_MM2RoleHighlight"
		Highlight.Adornee = Character
		Highlight.FillTransparency = 1
		Highlight.OutlineTransparency = 0
		Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		Highlight.Parent = Character
		RoleHighlights[Player] = Highlight
	end

	Highlight.OutlineColor = OutlineColor
	RoleStates[Player] = RoleName

	if CurrentTargetPlayer == Player and CurrentHighlight then
		CurrentHighlight:Destroy()
		CurrentHighlight = nil
	end
end

local function DisconnectRoleWatch(Player)
	local WatchState = RoleWatchStates[Player]
	if not WatchState then
		return
	end

	for _, Connection in ipairs(WatchState.Connections) do
		Connection:Disconnect()
	end

	RoleWatchStates[Player] = nil
end

local EnsureRoleWatch

EnsureRoleWatch = function(Player)
	if Destroyed or not Player.Parent then
		DisconnectRoleWatch(Player)
		return
	end

	local Character = Player.Character
	local Backpack = Player:FindFirstChildOfClass("Backpack") or Player:FindFirstChild("Backpack")
	local ExistingState = RoleWatchStates[Player]

	if ExistingState
		and ExistingState.Character == Character
		and ExistingState.Backpack == Backpack then
		return
	end

	DisconnectRoleWatch(Player)

	local WatchState = {
		Character = Character,
		Backpack = Backpack,
		Connections = {},
	}
	RoleWatchStates[Player] = WatchState

	local function Watch(Signal, Callback)
		table.insert(WatchState.Connections, Signal:Connect(Callback))
	end

	local function RefreshRole()
		if not Destroyed and Player.Parent then
			UpdateRoleVisual(Player)
		end
	end

	local function RebuildRoleWatch()
		task.defer(function()
			if not Destroyed and Player.Parent then
				EnsureRoleWatch(Player)
				UpdateRoleVisual(Player)
			end
		end)
	end

	Watch(Player.CharacterAdded, RebuildRoleWatch)
	Watch(Player.CharacterRemoving, RebuildRoleWatch)
	Watch(Player.ChildAdded, function(Child)
		if Child:IsA("Backpack") then
			RebuildRoleWatch()
		end
	end)
	Watch(Player.ChildRemoved, function(Child)
		if Child == Backpack then
			RebuildRoleWatch()
		end
	end)

	local function WatchContainer(Container)
		if not Container then
			return
		end

		local function RefreshRelevantTool(Child)
			if not Child:IsA("Tool") then
				return
			end

			local LowerName = string.lower(Child.Name)
			if LowerName == "knife" or LowerName == "gun" then
				RefreshRole()
			end
		end

		Watch(Container.ChildAdded, RefreshRelevantTool)
		Watch(Container.ChildRemoved, RefreshRelevantTool)
	end

	WatchContainer(Character)
	WatchContainer(Backpack)
end

local function RefreshRoleVisuals()
	if not RoleVisualsEnabled then
		ClearAllRoleHighlights()
		return
	end

	local ActivePlayers = {}

	for _, Player in ipairs(Players:GetPlayers()) do
		ActivePlayers[Player] = true
		EnsureRoleWatch(Player)
		UpdateRoleVisual(Player)
	end

	for Player in pairs(RoleHighlights) do
		if not ActivePlayers[Player] then
			ClearRoleHighlight(Player)
		end
	end

	local PlayerToRemove = next(RoleWatchStates)
	while PlayerToRemove do
		local NextPlayer = next(RoleWatchStates, PlayerToRemove)
		if not ActivePlayers[PlayerToRemove] then
			DisconnectRoleWatch(PlayerToRemove)
		end
		PlayerToRemove = NextPlayer
	end
end

local function HasClearShot(OriginPosition, TargetCharacter)
	local Character = LocalPlayer.Character
	LineOfSightParameters.FilterDescendantsInstances = Character and { Character } or {}

	for _, BodyPart in ipairs(TargetCharacter:GetDescendants()) do
		if BodyPart:IsA("BasePart")
			and not BodyPart:FindFirstAncestorOfClass("Tool")
			and not BodyPart:FindFirstAncestorOfClass("Accessory") then
			local Result = Workspace:Raycast(
				OriginPosition,
				BodyPart.Position - OriginPosition,
				LineOfSightParameters
			)
			if Result == nil or Result.Instance:IsDescendantOf(TargetCharacter) then
				return true
			end
		end
	end

	return false
end

local function IsCharacterBodyPart(Instance, TargetCharacter)
	return Instance:IsA("BasePart")
		and Instance:IsDescendantOf(TargetCharacter)
		and not Instance:FindFirstAncestorOfClass("Tool")
		and not Instance:FindFirstAncestorOfClass("Accessory")
end

local function GetPrimaryAimPart(TargetCharacter)
	return TargetCharacter:FindFirstChild("UpperTorso")
		or TargetCharacter:FindFirstChild("Torso")
		or TargetCharacter:FindFirstChild("HumanoidRootPart")
end

local function GetPredictedAimPosition(TargetCharacter, AimPart)
	local RootPart = TargetCharacter:FindFirstChild("HumanoidRootPart")
	local Humanoid = TargetCharacter:FindFirstChildOfClass("Humanoid")
	local VelocitySource = RootPart or AimPart
	local PredictionVelocity = VelocitySource.AssemblyLinearVelocity
	local HorizontalPrediction = Config.PredictionTime
	local VerticalPrediction = HorizontalPrediction

	if Humanoid then
		local State = Humanoid:GetState()
		local Airborne = Humanoid.FloorMaterial == Enum.Material.Air
			or State == Enum.HumanoidStateType.Jumping
			or State == Enum.HumanoidStateType.Freefall

		if Airborne then
			VerticalPrediction = Config.VerticalPrediction
		end
	end

	return AimPart.Position
		+ Vector3.new(
			PredictionVelocity.X * HorizontalPrediction,
			PredictionVelocity.Y * VerticalPrediction,
			PredictionVelocity.Z * HorizontalPrediction
		)
end

local function GetCharacterScreenDistance(Character, PointerPosition)
	CurrentCamera = Workspace.CurrentCamera or CurrentCamera
	if not CurrentCamera then
		return nil
	end

	local WorldMinimum = Vector3.new(math.huge, math.huge, math.huge)
	local WorldMaximum = Vector3.new(-math.huge, -math.huge, -math.huge)
	local HasBodyPart = false

	for _, BodyPart in ipairs(Character:GetDescendants()) do
		if IsCharacterBodyPart(BodyPart, Character) then
			local HalfSize = BodyPart.Size * 0.5
			local PartCFrame = BodyPart.CFrame
			local Right = PartCFrame.RightVector
			local Up = PartCFrame.UpVector
			local Look = PartCFrame.LookVector
			local Extents = Vector3.new(
				math.abs(Right.X) * HalfSize.X + math.abs(Up.X) * HalfSize.Y + math.abs(Look.X) * HalfSize.Z,
				math.abs(Right.Y) * HalfSize.X + math.abs(Up.Y) * HalfSize.Y + math.abs(Look.Y) * HalfSize.Z,
				math.abs(Right.Z) * HalfSize.X + math.abs(Up.Z) * HalfSize.Y + math.abs(Look.Z) * HalfSize.Z
			)
			local PartMinimum = BodyPart.Position - Extents
			local PartMaximum = BodyPart.Position + Extents

			WorldMinimum = Vector3.new(
				math.min(WorldMinimum.X, PartMinimum.X),
				math.min(WorldMinimum.Y, PartMinimum.Y),
				math.min(WorldMinimum.Z, PartMinimum.Z)
			)
			WorldMaximum = Vector3.new(
				math.max(WorldMaximum.X, PartMaximum.X),
				math.max(WorldMaximum.Y, PartMaximum.Y),
				math.max(WorldMaximum.Z, PartMaximum.Z)
			)
			HasBodyPart = true
		end
	end

	if not HasBodyPart then
		return nil
	end

	local MinimumX = math.huge
	local MinimumY = math.huge
	local MaximumX = -math.huge
	local MaximumY = -math.huge
	local HasPointInFront = false

	for X = 0, 1 do
		for Y = 0, 1 do
			for Z = 0, 1 do
				local Corner = Vector3.new(
					X == 0 and WorldMinimum.X or WorldMaximum.X,
					Y == 0 and WorldMinimum.Y or WorldMaximum.Y,
					Z == 0 and WorldMinimum.Z or WorldMaximum.Z
				)
				local ScreenPoint = CurrentCamera:WorldToScreenPoint(Corner)

				if ScreenPoint.Z > 0 then
					HasPointInFront = true
					MinimumX = math.min(MinimumX, ScreenPoint.X)
					MinimumY = math.min(MinimumY, ScreenPoint.Y)
					MaximumX = math.max(MaximumX, ScreenPoint.X)
					MaximumY = math.max(MaximumY, ScreenPoint.Y)
				end
			end
		end
	end

	if not HasPointInFront then
		return nil
	end

	local ViewportSize = CurrentCamera.ViewportSize
	if MaximumX < 0 or MaximumY < 0 or MinimumX > ViewportSize.X or MinimumY > ViewportSize.Y then
		return nil
	end

	local ClosestPoint = Vector2.new(
		math.clamp(PointerPosition.X, MinimumX, MaximumX),
		math.clamp(PointerPosition.Y, MinimumY, MaximumY)
	)

	return (ClosestPoint - PointerPosition).Magnitude
end

local function FindHoveredPlayerNearPointer(PointerPosition)
	CurrentCamera = Workspace.CurrentCamera or CurrentCamera
	if not CurrentCamera then
		return nil, nil, nil
	end

	-- First use the exact screen ray. This makes the circle switch targets
	-- immediately when the pointer is directly over any queried body part.
	local IncludedCharacters = table.create(math.max(0, #Players:GetPlayers() - 1))

	for _, Player in ipairs(Players:GetPlayers()) do
		local Character = Player.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if Player ~= LocalPlayer and Character and Humanoid and Humanoid.Health > 0 then
			table.insert(IncludedCharacters, Character)
		end
	end

	if #IncludedCharacters > 0 then
		local PointerRay = CurrentCamera:ScreenPointToRay(PointerPosition.X, PointerPosition.Y)
		PointerRaycastParameters.FilterDescendantsInstances = IncludedCharacters

		local PointerResult = Workspace:Raycast(
			PointerRay.Origin,
			PointerRay.Direction * 10000,
			PointerRaycastParameters
		)

		if PointerResult then
			local HitCharacter = PointerResult.Instance:FindFirstAncestorOfClass("Model")
			local HitPlayer = HitCharacter and Players:GetPlayerFromCharacter(HitCharacter)
			local HitHumanoid = HitCharacter and HitCharacter:FindFirstChildOfClass("Humanoid")
			local HitRoot = HitCharacter and HitCharacter:FindFirstChild("HumanoidRootPart")
			local HitAimPart = HitCharacter and GetPrimaryAimPart(HitCharacter)

			if HitPlayer ~= LocalPlayer
				and HitPlayer
				and HitHumanoid
				and HitHumanoid.Health > 0
				and HitRoot
				and HitAimPart then
				return HitPlayer, HitAimPart, 0
			end
		end
	end

	-- Keep the radius/bounding-box fallback so near misses inside the circle
	-- still select the closest visible on-screen character.
	local BestPlayer
	local BestAimPart
	local BestScreenDistance = TargetRadius

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local Character = Player.Character
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
			local AimPart = Character and GetPrimaryAimPart(Character)

				if Humanoid and Humanoid.Health > 0 and RootPart and AimPart then
					local ScreenDistance = GetCharacterScreenDistance(Character, PointerPosition)

					if ScreenDistance and ScreenDistance <= BestScreenDistance then
						BestPlayer = Player
						BestAimPart = AimPart
						BestScreenDistance = ScreenDistance
					end
				end
			end
		end

	return BestPlayer, BestAimPart, BestScreenDistance
end

local function EvaluatePointerTarget(PointerPosition, OriginPosition)
	local HoveredPlayer, AimPart, ScreenDistance = FindHoveredPlayerNearPointer(PointerPosition)
	local Character = HoveredPlayer and HoveredPlayer.Character
	if not Character or not AimPart then
		return nil, nil, false, nil, ScreenDistance
	end

	local PredictedAimPosition = GetPredictedAimPosition(Character, AimPart)
	local ClearShot = HasClearShot(OriginPosition, Character)
	return HoveredPlayer, AimPart, ClearShot, PredictedAimPosition, ScreenDistance
end

local function FindMurderLockTarget(OriginPosition)
	local BestVisiblePlayer
	local BestVisibleAimPart
	local BestVisibleDistance = math.huge
	local BestBlockedPlayer
	local BestBlockedAimPart
	local BestBlockedDistance = math.huge
	local BestVisiblePredictedAimPosition
	local BestBlockedPredictedAimPosition

	for _, Player in ipairs(Players:GetPlayers()) do
		if Player ~= LocalPlayer then
			local Character = Player.Character
			local Backpack = Player:FindFirstChildOfClass("Backpack") or Player:FindFirstChild("Backpack")
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
			local AimPart = Character and GetPrimaryAimPart(Character)
			local HasKnife = HasNamedTool(Character, "Knife") or HasNamedTool(Backpack, "Knife")

			if HasKnife and Humanoid and Humanoid.Health > 0 and RootPart and AimPart then
				local Distance = (RootPart.Position - OriginPosition).Magnitude
				local PredictedAimPosition = GetPredictedAimPosition(Character, AimPart)
				local ClearShot = HasClearShot(OriginPosition, Character)

				if ClearShot and Distance < BestVisibleDistance then
					BestVisiblePlayer = Player
					BestVisibleAimPart = AimPart
					BestVisibleDistance = Distance
					BestVisiblePredictedAimPosition = PredictedAimPosition
				elseif not ClearShot and Distance < BestBlockedDistance then
					BestBlockedPlayer = Player
					BestBlockedAimPart = AimPart
					BestBlockedDistance = Distance
					BestBlockedPredictedAimPosition = PredictedAimPosition
				end
			end
		end
	end

	if BestVisiblePlayer then
		return BestVisiblePlayer, BestVisibleAimPart, true, BestVisiblePredictedAimPosition
	end

	if BestBlockedPlayer then
		return BestBlockedPlayer, BestBlockedAimPart, false, BestBlockedPredictedAimPosition
	end

	return nil, nil, false, nil
end

