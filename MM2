local function TrackConnection(Connection)
	TrackedConnections[#TrackedConnections + 1] = Connection
	return Connection
end

local function DisconnectTrackedConnections()
	for Index = #TrackedConnections, 1, -1 do
		local Connection = TrackedConnections[Index]
		if Connection then
			Connection:Disconnect()
		end

		TrackedConnections[Index] = nil
	end
end

local function ClampMainFramePosition(Position)
	CurrentCamera = workspace.CurrentCamera or CurrentCamera
	if not CurrentCamera then
		return Position
	end

	local ViewportSize = CurrentCamera.ViewportSize
	local TopLeftInset, BottomRightInset = GuiService:GetGuiInset()
	local HalfWidth = MainFrameWidth * MainScale.Scale * 0.5
	local HalfHeight = MainFrameHeight * MainScale.Scale * 0.5
	local Margin = 7
	local MinimumX = TopLeftInset.X + HalfWidth + Margin
	local MaximumX = ViewportSize.X - BottomRightInset.X - HalfWidth - Margin
	local MinimumY = TopLeftInset.Y + HalfHeight + Margin
	local MaximumY = ViewportSize.Y - BottomRightInset.Y - HalfHeight - Margin
	local RawX = ViewportSize.X * Position.X.Scale + Position.X.Offset
	local RawY = ViewportSize.Y * Position.Y.Scale + Position.Y.Offset
	local ClampedX = MinimumX <= MaximumX and math.clamp(RawX, MinimumX, MaximumX) or ViewportSize.X * 0.5
	local ClampedY = MinimumY <= MaximumY and math.clamp(RawY, MinimumY, MaximumY) or ViewportSize.Y * 0.5

	return UDim2.new(
		Position.X.Scale,
		Position.X.Offset + ClampedX - RawX,
		Position.Y.Scale,
		Position.Y.Offset + ClampedY - RawY
	)
end

local function UpdateResponsiveLayout()
	CurrentCamera = workspace.CurrentCamera or CurrentCamera
	if not CurrentCamera then
		return
	end

	local ViewportSize = CurrentCamera.ViewportSize
	local Scale = math.clamp(math.min(ViewportSize.X / 360, ViewportSize.Y / 520), MinimumGuiScale, 1)
	local TopLeftInset = GuiService:GetGuiInset()

	MainScale.Scale = Scale
	ReopenScale.Scale = Scale
	ReopenButton.Position = UDim2.new(0.5, 0, 0, TopLeftInset.Y + 8)
	MainFrame.Position = ClampMainFramePosition(MainFrame.Position)
end

local function BindCurrentCamera()
	if CameraViewportConnection then
		CameraViewportConnection:Disconnect()
		CameraViewportConnection = nil
	end

	CurrentCamera = workspace.CurrentCamera or CurrentCamera
	if CurrentCamera then
		CameraViewportConnection = CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsiveLayout)
	end

	UpdateResponsiveLayout()
end

local function UpdateDrag(Input)
	local Delta = Input.Position - DragStart
	local NewPosition = UDim2.new(
		StartPosition.X.Scale,
		StartPosition.X.Offset + Delta.X,
		StartPosition.Y.Scale,
		StartPosition.Y.Offset + Delta.Y
	)

	MainFrame.Position = ClampMainFramePosition(NewPosition)
end

local function UpdatePrediction(ScreenX)
	local TrackWidth = math.max(SliderTrack.AbsoluteSize.X, 1)
	local Alpha = math.clamp((ScreenX - SliderTrack.AbsolutePosition.X) / TrackWidth, 0, 1)
	PredictionTime = MinimumPrediction + (MaximumPrediction - MinimumPrediction) * Alpha
	PredictionTime = math.round(PredictionTime * 100) / 100
	Alpha = (PredictionTime - MinimumPrediction) / (MaximumPrediction - MinimumPrediction)

	SliderFill.Size = UDim2.fromScale(Alpha, 1)
	SliderKnob.Position = UDim2.fromScale(Alpha, 0.5)
	PredictionLabel.Text = string.format("Prediction: %.2fs", PredictionTime)
end

local function BeginSlider(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
		SliderDragging = true
		SliderInput = Input
		UpdatePrediction(Input.Position.X)
	end
end

